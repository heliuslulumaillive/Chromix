# Normalize line endings so a Windows checkout can't corrupt the patch set.
# `git apply` on patches/*.patch is whitespace-sensitive; CRLF creep silently breaks it.

# Default: normalize text to LF in the repo, let git pick the working-tree ending.
* text=auto

# These MUST stay LF everywhere (scripts run under sh; patches are applied verbatim).
# Patch files contain single-space context lines that are valid unified-diff syntax;
# tools/check_patches.py validates trailing whitespace in actual added source lines.
*.patch   text eol=lf whitespace=-blank-at-eol,-blank-at-eof
*.sh      text eol=lf
*.py      text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.gn      text eol=lf
*.psd1    text eol=lf
*.conf    text eol=lf
series    text eol=lf
Makefile  text eol=lf
CHROMIUM_WINDOWS_VERSION text eol=lf
UNGOOGLED_WINDOWS_VERSION text eol=lf
build/windows/security-requirements.txt text eol=lf
tools/google-services-requirements.txt text eol=lf

# Windows-only helpers keep CRLF.
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# Binary assets — never touch.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.ttf     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.dat     binary
*.bin     binary
*.pb      binary
/tools/tests/fixtures/pixel-semantics-v1/cases.tsv text eol=lf
/tools/tests/fixtures/pixel-semantics-v1/*.gz binary
*.tar.gz  binary
*.zip     binary
