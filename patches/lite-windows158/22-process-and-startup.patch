+++ b/chrome/app/chrome_main.cc
@@ -7,11 +7,21 @@
 #include <stdint.h>
 
 #include <iostream>
+#include <vector>
 #include <memory>
 #include <optional>
 
+#include <string_view>
+
 #include "base/command_line.h"
+#include "base/uxr_cloak_hardware.h"
 #include "base/environment.h"
+#include "base/i18n/tag_converters.h"
