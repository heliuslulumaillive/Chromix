                   .MainFrameViewWidget()
                   ->LayerTreeHostForTesting()
                   ->new_local_surface_id_request_for_testing());
+}
+
+TEST_F(WebFrameWidgetSimTest, EmulatedAutoResizePreservesMeasuredViewport) {
+  LoadURL("about:blank");
+  auto* widget = WebView().MainFrameViewWidget();
+  DeviceEmulationParams params;
+  params.screen_size = gfx::Size(1920, 1080);
+  params.device_scale_factor = 1.25f;
+  mojom::blink::FrameWidget& frame_widget = *widget;
+  frame_widget.EnableDeviceEmulation(
+      params, mojom::blink::DeviceEmulationCacheBehavior::kClearCache);
+
+  VisualProperties properties;
+  properties.screen_infos = display::ScreenInfos(display::ScreenInfo());
+  properties.auto_resize_enabled = true;
+  properties.min_size_for_auto_resize = gfx::Size(25, 25);
+  properties.max_size_for_auto_resize = gfx::Size(800, 600);
+  properties.new_size_device_px = properties.min_size_for_auto_resize;
+  properties.compositor_viewport_pixel_rect =
+      gfx::Rect(properties.new_size_device_px);
+  properties.visible_viewport_size_device_px = properties.new_size_device_px;
+  viz::ParentLocalSurfaceIdAllocator allocator;
+  allocator.GenerateId();
+  properties.local_surface_id = allocator.GetCurrentLocalSurfaceId();
+  widget->ApplyVisualProperties(properties);
+
+  const gfx::Size content_size(320, 480);
+  widget->DidAutoResize(content_size);
+  EXPECT_EQ(gfx::Rect(content_size),
+            widget->LayerTreeHostForTesting()->device_viewport_rect());
+  allocator.GenerateId();
+  properties.local_surface_id = allocator.GetCurrentLocalSurfaceId();
+  widget->ApplyVisualProperties(properties);
+  EXPECT_EQ(content_size, widget->Size());
+  EXPECT_EQ(gfx::Rect(content_size),
+            widget->LayerTreeHostForTesting()->device_viewport_rect());
+  EXPECT_EQ(*properties.local_surface_id, widget->LocalSurfaceIdFromParent());
+  EXPECT_EQ(gfx::Rect(params.screen_size), widget->GetScreenInfo().rect);
+  EXPECT_FLOAT_EQ(params.device_scale_factor,
+                  widget->GetScreenInfo().device_scale_factor);
+  frame_widget.DisableDeviceEmulation();
+  EXPECT_EQ(content_size, widget->Size());
 }
 
