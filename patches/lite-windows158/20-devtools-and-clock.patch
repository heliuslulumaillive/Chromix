 double V8Platform::CurrentClockTimeMillisecondsHighResolution() {
+  // Temporal and Date share the configured grid. Retain the native high
+  // resolution clock exactly when the optional policy is unset or zero.
+  if (base::UxrConfig::GetInstance().TimerResolutionMicroseconds() > 0)
+    return static_cast<double>(CurrentClockTimeMilliseconds());
   return time_clamper_.ClampToMillisHighResolution(base::Time::Now());
 }
 
