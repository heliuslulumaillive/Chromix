diff --git a/base/uxr_original_audio_reference.h b/base/uxr_original_audio_reference.h
new file mode 100644
--- /dev/null
+++ b/base/uxr_original_audio_reference.h
@@ -0,0 +1,82 @@
+// Copyright 2026. Explicit original-Cloak graph gate; compatible PCM matching
+// remains in uxr_audio_reference_data.h and is not changed by this strategy.
+#ifndef BASE_UXR_ORIGINAL_AUDIO_REFERENCE_H_
+#define BASE_UXR_ORIGINAL_AUDIO_REFERENCE_H_
+#include <cmath>
+#include <cstdint>
+#include <span>
+#include "base/uxr_audio_reference_data.h"
+
+namespace base::uxr_surface_v1 {
+struct OriginalAudioGraphInputs {
+  bool mac = false;
+  bool has_first_oscillator = false;
+  bool has_first_compressor = false;
+  bool triangle = false;
+  uint32_t frames = 0;
+  uint32_t channels = 0;
+  float sample_rate = 0;
+  uint32_t destination_connections = 0;
+  float frequency = 0;
+  float threshold = 0;
+  float knee = 0;
+  float ratio = 0;
+  float attack = 0;
+  float release = 0;
+};
+
+// Called once at successful startRendering entry. These are the CURRENT values
+// of the FIRST nodes created in this context, independent of graph connectivity.
+inline bool OriginalAudioGraphEligible(const OriginalAudioGraphInputs& q) {
+  if (!q.mac || !q.has_first_oscillator || !q.has_first_compressor || !q.triangle)
+    return false;
+  if (q.frames == 1000) {
+    return q.channels == 1 && q.sample_rate == 44100.0f &&
+           q.destination_connections == 1 && q.frequency == 9998.123f &&
+           q.threshold == -52.0f && q.knee == 40.0f && q.ratio == 12.0f &&
+           q.attack == 0.0001f && q.release == 0.25f;
+  }
+  // The getters return float32, but the original cvtss2sd/addsd/ucomisd chain
+  // promotes each value before the subtraction and uses the double 0.001.
+  return std::abs(static_cast<double>(q.frequency) - 10000.0) <= 0.001 &&
+         std::abs(static_cast<double>(q.threshold) + 50.0) <= 0.001 &&
+         std::abs(static_cast<double>(q.knee) - 40.0) <= 0.001 &&
+         std::abs(static_cast<double>(q.ratio) - 12.0) <= 0.001 &&
+         std::abs(static_cast<double>(q.attack)) <= 0.001 &&
+         std::abs(static_cast<double>(q.release) - 0.25) <= 0.001;
+}
+
+#include "base/uxr_original_audio_multiple.inc"
+
+// Selection uses the completion-time monotonically incremented uint32 counter,
+// not a count of currently connected edges and not the start-time value.
+inline std::span<const float> OriginalAudioReferenceFor(
+    size_t length, uint32_t destination_connections) {
+  const bool multiple = destination_connections > 1;
+  if (length == 5000)
+    return multiple ? std::span<const float>(kOriginalMacAudio5000Multiple)
+                    : std::span<const float>(kMacAudio5000);
+  if (!multiple && length == 1000)
+    return kMacAudio1000;
+  if (!multiple && length == 44100)
+    return kMacAudio44100;
+  return {};
+}
+
+template <class Samples>
+inline bool ApplyOriginalAudioReference(Samples channel_zero,
+                                        bool captured_eligibility,
+                                        bool mac_at_completion,
+                                        uint32_t destination_connections) {
+  if (!captured_eligibility || !mac_at_completion)
+    return false;
+  const auto reference = OriginalAudioReferenceFor(
+      channel_zero.size(), destination_connections);
+  if (reference.empty())
+    return false;
+  for (size_t i = 0; i < reference.size(); ++i)
+    channel_zero[i] = reference[i];
+  return true;
+}
+}  // namespace base::uxr_surface_v1
+#endif  // BASE_UXR_ORIGINAL_AUDIO_REFERENCE_H_
