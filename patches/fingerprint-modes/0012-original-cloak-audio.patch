+void BaseAudioContext::UxrRememberFirstOscillator(OscillatorNode* node) {
+  DCHECK(IsMainThread());
+  if (base::UxrConfig::GetInstance().SurfaceModes().audio.mode ==
+          base::UxrSurfaceMode::kCloakOriginal && !uxr_first_oscillator_)
+    uxr_first_oscillator_ = node;
+}
+
+void BaseAudioContext::UxrRememberFirstCompressor(DynamicsCompressorNode* node) {
+  DCHECK(IsMainThread());
+  if (base::UxrConfig::GetInstance().SurfaceModes().audio.mode ==
+          base::UxrSurfaceMode::kCloakOriginal && !uxr_first_compressor_)
+    uxr_first_compressor_ = node;
+}
+
+void BaseAudioContext::UxrDidAddDestinationConnection() {
+  DCHECK(IsMainThread());
+  if (base::UxrConfig::GetInstance().SurfaceModes().audio.mode ==
+      base::UxrSurfaceMode::kCloakOriginal)
+    ++uxr_destination_connection_count_;
+}
+
 void BaseAudioContext::Trace(Visitor* visitor) const {
+  visitor->Trace(uxr_first_oscillator_);
+  visitor->Trace(uxr_first_compressor_);
   visitor->Trace(destination_node_);
   visitor->Trace(listener_);
   visitor->Trace(pending_promise_resolvers_);
