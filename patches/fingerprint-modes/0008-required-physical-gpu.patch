+bool UxrRequiredGpuMatches(const gpu::GPUInfo& info) {
+  const auto* command = base::CommandLine::ForCurrentProcess();
+  if (command->GetSwitchValueASCII("chromix-gpu-binding") != "required-v1")
+    return false;
+  const std::string value = command->GetSwitchValueASCII("use-adapter-luid");
+  const size_t comma = value.find(',');
+  int high = 0;
+  unsigned low = 0;
+  if (comma == std::string::npos ||
+      !base::StringToInt(value.substr(0, comma), &high) ||
+      !base::StringToUint(value.substr(comma + 1), &low) ||
+      (high == 0 && low == 0))
+    return false;
+  const auto& active = info.active_gpu();
+  return !info.gl_renderer.empty() && active.active &&
+         info.gl_implementation_parts.angle == gl::ANGLEImplementation::kD3D11 &&
+         active.luid.HighPart == high && active.luid.LowPart == low;
+}
+#endif
+
+#if BUILDFLAG(IS_WIN)
+// Runs before profile creation/session restoration. The values below come from
+// GPU-process initialization, not from the spoofable renderer-facing APIs.
+class UxrRequiredGpuWaiter final : public content::GpuDataManagerObserver {
+ public:
+  bool Wait() {
+    auto* manager = content::GpuDataManager::GetInstance();
+    manager->AddObserver(this);
+    base::OneShotTimer deadline;
+    deadline.Start(FROM_HERE, base::Seconds(20), loop_.QuitClosure());
+    manager->RequestVideoMemoryUsageStatsUpdate(
+        base::BindOnce([](const gpu::VideoMemoryUsageStats&) {}));
+    OnGpuInfoUpdate();
+    if (!done_)
+      loop_.Run();
+    manager->RemoveObserver(this);
+    return accepted_;
+  }
+  void OnGpuInfoUpdate() override {
+    const auto info = content::GpuDataManager::GetInstance()->GetGPUInfo();
+    if (info.gl_renderer.empty())
+      return;
+    accepted_ = UxrRequiredGpuMatches(info);
+    done_ = true;
+    loop_.Quit();
+  }
+  void OnGpuProcessCrashed() override {
+    accepted_ = false;
+    done_ = true;
+    loop_.Quit();
+  }
+ private:
+  base::RunLoop loop_;
+  bool done_ = false;
+  bool accepted_ = false;
+};
+
+bool UxrPrepareRequiredGpu() {
+  const auto* command = base::CommandLine::ForCurrentProcess();
+  if (!command->HasSwitch("chromix-gpu-binding"))
+    return true;
+  const auto receipt = command->GetSwitchValuePath("chromix-gpu-binding-receipt");
+  const auto nonce = command->GetSwitchValueASCII("chromix-gpu-binding-nonce");
+  if (receipt.empty() || !receipt.IsAbsolute() || nonce.size() != 32 ||
+      nonce.find_first_not_of("0123456789abcdef") != std::string::npos)
+    return false;
+  UxrRequiredGpuWaiter waiter;
+  if (!waiter.Wait())
+    return false;
+  const auto info = content::GpuDataManager::GetInstance()->GetGPUInfo();
+  if (!UxrRequiredGpuMatches(info))
+    return false;
+  const auto& device = info.active_gpu();
+  base::DictValue data;
+  data.Set("schemaVersion", 1);
+  data.Set("nonce", nonce);
+  data.Set("browserPid", static_cast<int>(base::GetCurrentProcId()));
+  data.Set("adapterLuid", command->GetSwitchValueASCII("use-adapter-luid"));
+  data.Set("vendorId", static_cast<int>(device.vendor_id));
+  data.Set("deviceId", static_cast<int>(device.device_id));
+  data.Set("subsystemId", base::NumberToString(device.sub_sys_id));
+  data.Set("driverVersion", device.driver_version);
+  data.Set("renderer", info.gl_renderer);
+  data.Set("accepted", true);
+  const auto encoded = base::WriteJson(data);
+  if (!encoded)
+    return false;
+  base::RunLoop write_loop;
+  bool written = false;
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce([](base::FilePath file, std::string bytes) {
+        return base::ImportantFileWriter::WriteFileAtomically(file, bytes);
+      }, receipt, *encoded),
+      base::BindOnce([](bool* written, base::OnceClosure quit, bool result) {
+        *written = result;
+        std::move(quit).Run();
+      }, &written, write_loop.QuitClosure()));
+  write_loop.Run();
+  return written;
+}
+#endif
