+// An explicit original-pixel opt-in needs typed, transparent and user-FBO
+// readback. Two independent sentinels prove actual output without inspecting or
+// consuming the page's GL error queue. Existing compatible/legacy paths stay
+// unchanged. Each staging buffer is capped at half the existing total budget.
+std::optional<UxrWebGLReadbackLayout> UxrOriginalWebGLLayoutFor(
+    int width, int height, int alignment, int row_length, int skip_pixels,
+    int skip_rows, size_t available, uint32_t pixel_bytes) {
+  constexpr uint64_t limit = kUxrWebGLReadbackLimit / 2;
+  if (width <= 0 || height <= 0 || row_length < 0 || skip_pixels < 0 ||
+      skip_rows < 0 || pixel_bytes == 0 ||
+      (alignment != 1 && alignment != 2 && alignment != 4 && alignment != 8))
+    return std::nullopt;
+  const uint64_t row_pixels = row_length ? row_length : width;
+  if (static_cast<uint64_t>(skip_pixels) + width > row_pixels ||
+      row_pixels > limit / pixel_bytes)
+    return std::nullopt;
+  const uint64_t stride =
+      (row_pixels * pixel_bytes + alignment - 1) / alignment * alignment;
+  if (static_cast<uint64_t>(height) > limit / stride ||
+      static_cast<uint64_t>(skip_rows) > limit / stride)
+    return std::nullopt;
+  const uint64_t skip = stride * skip_rows + uint64_t{pixel_bytes} * skip_pixels;
+  const uint64_t row_bytes = uint64_t{pixel_bytes} * width;
+  const uint64_t total = skip + stride * (height - 1) + row_bytes;
+  if (total > limit || total > available)
+    return std::nullopt;
+  return UxrWebGLReadbackLayout{static_cast<size_t>(stride),
+                              static_cast<size_t>(skip),
+                              static_cast<size_t>(row_bytes),
+                              static_cast<size_t>(total)};
 }
 
