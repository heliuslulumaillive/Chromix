+UxrPixelResult UxrApplyOriginalCloakPixelsV1(
+    span<uint8_t> bytes, uint64_t seed, const UxrOriginalPixelLayout& p) {
+  if (seed == 0)
+    return UxrPixelResult::kUnsupportedSeed;
+  if (p.bit > 7 || (p.component_bytes != 1 && p.component_bytes != 2 &&
+                    p.component_bytes != 4) ||
+      p.components == 0 || p.components > 4 || p.pixel_bytes == 0 ||
+      p.components * p.component_bytes > p.pixel_bytes ||
+      (p.floating && p.component_bytes == 1) ||
+      (p.has_alpha && p.alpha_component * uint64_t{p.component_bytes} >=
+                          p.pixel_bytes)) {
+    return UxrPixelResult::kInvalidLayout;
+  }
+  if (p.width < 8 || p.height < 8)
+    return UxrPixelResult::kUnchanged;
+  const uint64_t row_bytes = uint64_t{p.width} * p.pixel_bytes;
+  if (row_bytes > p.row_stride || p.skip > bytes.size() ||
+      row_bytes > bytes.size() - p.skip ||
+      p.height - 1 > (bytes.size() - p.skip - row_bytes) / p.row_stride) {
+    return UxrPixelResult::kInvalidLayout;
+  }
+  const uint64_t count = uint64_t{p.width} * p.height;
+  const std::string seed_text = std::to_string(seed);
+  const uint32_t position_hash = UxrCloakHashV1(seed_text + "_pos");
+  const uint8_t bit_mask = static_cast<uint8_t>(1u << p.bit);
+  const bool byte_alpha = p.has_alpha && p.component_bytes == 1;
+  bool changed = false;
+  for (uint32_t i = 0; i < 10; ++i) {
+    const uint32_t mixed = (position_hash ^ i) * 0x17385ca9u + 0x47502932u;
+    const uint64_t position = mixed % count;
+    const uint32_t x = static_cast<uint32_t>(position % p.width);
+    const uint32_t y = static_cast<uint32_t>(position / p.width);
+    const size_t offset = p.skip + size_t{y} * p.row_stride +
+                          size_t{x} * p.pixel_bytes;
+    const uint32_t bits = UxrCloakHashV1(seed_text + "_" + std::to_string(x) +
+                                       "_" + std::to_string(y));
+    for (uint32_t channel = 0; channel < p.components; ++channel) {
+      const size_t at = offset + channel * p.component_bytes;
+      if (p.floating) {
+        uint32_t word = 0;
+        for (uint32_t j = 0; j < p.component_bytes; ++j)
+          word |= uint32_t{bytes[at + j]} << (j * 8);
+        const uint32_t exponent = p.component_bytes == 2 ? 0x7c00u : 0x7f800000u;
+        if ((word & exponent) == exponent)
+          continue;  // Preserve every NaN/Infinity bit, including payloads.
+      }
+      const uint8_t value = static_cast<uint8_t>(
+          (bytes[at] & ~bit_mask) | (((bits >> channel) & 1u) << p.bit));
+      if (byte_alpha && value > bytes[offset + p.alpha_component])
+        continue;
+      changed |= value != bytes[at];
+      bytes[at] = value;
+    }
+  }
+  return changed ? UxrPixelResult::kApplied : UxrPixelResult::kUnchanged;
 }
 
