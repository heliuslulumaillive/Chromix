+inline bool UxrCloakGpuFeatureAllowedV1(
+    const UxrGpuProfileV1& profile, std::string_view name,
+    bool windows_modern = true) {
+  // Caller must intersect this policy with adapter.GetFeatures(). Unlike the
+  // observed closed-source path, no unsupported feature is ever manufactured.
+  struct Feature { std::string_view name; uint32_t native; };
+  static constexpr Feature features[] = {
+    {"core-features-and-limits", 1u},
+    {"depth-clip-control", 2u},
+    {"depth32float-stencil8", 3u},
+    {"texture-compression-bc", 4u},
+    {"texture-compression-bc-sliced-3d", 5u},
+    {"texture-compression-etc2", 6u},
+    {"texture-compression-astc", 7u},
+    {"texture-compression-astc-sliced-3d", 8u},
+    {"timestamp-query", 9u},
+    {"indirect-first-instance", 10u},
+    {"shader-f16", 11u},
+    {"rg11b10ufloat-renderable", 12u},
+    {"bgra8unorm-storage", 13u},
+    {"float32-filterable", 14u},
+    {"float32-blendable", 15u},
+    {"clip-distances", 16u},
+    {"dual-source-blending", 17u},
+    {"subgroups", 18u},
+    {"texture-formats-tier1", 19u},
+    {"texture-formats-tier2", 20u},
+    {"primitive-index", 21u},
+    {"texture-component-swizzle", 22u},
+    {"subgroup-size-control", 23u},
+    {"chromium-experimental-multi-draw-indirect", 327729u},
+    {"chromium-experimental-subgroup-matrix", 327732u},
+    {"chromium-experimental-sampling-resource-table", 327738u},
+    {"atomic-vec2u-min-max", 327739u},
+    {"texture-compression-unaligned", 327745u},
+    {"chromium-experimental-timestamp-query-inside-passes", 327683u},
+  };
+  uint32_t feature = 0;
+  for (const auto& item : features)
+    if (item.name == name) { feature = item.native; break; }
+  if (!feature) return false;
+  // The source constructor unconditionally added these names. The compatible
+  // variant only allows them if the real native set already contains them.
+  if (feature == 11 || feature == 17 || feature == 21 ||
+      feature == 19 || feature == 20) return true;
+  if (!profile.macos()) {
+    if ((feature == 18 || feature == 23) && profile.family == "intel" &&
+        profile.index < 18 && ((0x10e60u >> profile.index) & 1u)) return false;
+    if (feature == 23) {
+      const auto a = profile.architecture;
+      return !windows_modern || a == "gen-12lp" || a == "xe-lpg" ||
+          a == "pascal" || a == "turing" || a == "ampere" ||
+          a == "lovelace" || a == "blackwell";
+    }
+  }
+  if (feature >= 1 && feature < 16 && ((0x7b0fu >> (feature - 1)) & 1u))
+    return true;
+  if (profile.macos())
+    return feature >= 5 && feature < 24 && ((0x7f84fu >> (feature - 5)) & 1u);
+  return feature < 23 && ((0x7f0820u >> feature) & 1u);
+}
