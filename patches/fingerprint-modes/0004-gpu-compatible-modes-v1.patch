+enum class UxrGpuMode { kLegacy, kNative, kCustom, kCloak };
+inline UxrGpuMode UxrResolveGpuModeV1(std::string_view selected,
+                                    std::string_view fallback = {},
+                                    bool fingerprint_off = false) {
+  if (selected.empty()) selected = fallback;
+  if (selected.empty()) return UxrGpuMode::kLegacy;
+  if (fingerprint_off) return UxrGpuMode::kNative;
+  if (selected == "custom") return UxrGpuMode::kCustom;
+  if (selected == "cloak") return UxrGpuMode::kCloak;
+  return UxrGpuMode::kNative;  // Config validation rejects unknown values.
+}
+struct UxrGpuProfileV1 {
+  std::string_view family;
+  unsigned index;
+  std::string_view architecture;
+  bool macos() const { return family == "apple"; }
+};
