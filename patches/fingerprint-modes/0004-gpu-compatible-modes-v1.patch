+
+int GetWebGLContextLimitV1(const char* key, int native_value) {
+  if (GetWebGLCapabilitiesMode() != base::UxrGpuMode::kCustom)
+    return native_value;
+  int requested = 0;
+  if (!base::UxrConfig::GetInstance().GetInt(key, &requested))
+    return native_value;
+  return base::UxrClampContextCapabilityV1(native_value, requested);
+}
+
+bool IsWebGLModeExtensionAllowedV1(std::string_view name) {
+  const auto& config = base::UxrConfig::GetInstance();
+  if (GetWebGLCapabilitiesMode() != base::UxrGpuMode::kCustom ||
+      !config.Has("uxr-webgl-extensions"))
+    return true;
+  for (const auto& token : base::SplitString(
+           config.Get("uxr-webgl-extensions"), ",", base::TRIM_WHITESPACE,
+           base::SPLIT_WANT_NONEMPTY)) {
+    if (base::EqualsCaseInsensitiveASCII(token, name))
+      return true;
+  }
+  return false;  // Explicit empty custom allowlist permits no extensions.
+}
