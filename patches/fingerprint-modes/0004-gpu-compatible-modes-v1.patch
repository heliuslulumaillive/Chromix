+    {"maxUniformBuffersPerShaderStage", 12u, 12u, false},
+    {"maxUniformBufferBindingSize", 65536u, 65536u, false},
+    {"maxStorageBufferBindingSize", 2147483644u, 4294967292u, false},
+    {"minUniformBufferOffsetAlignment", 256u, 256u, true},
+    {"minStorageBufferOffsetAlignment", 256u, 256u, true},
+    {"maxVertexBuffers", 8u, 8u, false},
+    {"maxBufferSize", 2147483648u, 4294967292u, false},
+    {"maxVertexAttributes", 30u, 30u, false},
+    {"maxVertexBufferArrayStride", 2048u, 2048u, false},
+    {"maxInterStageShaderVariables", 28u, 28u, false},
+    {"maxColorAttachments", 8u, 8u, false},
+    {"maxColorAttachmentBytesPerSample", 128u, 128u, false},
+    {"maxComputeWorkgroupStorageSize", 32768u, 32768u, false},
+    {"maxComputeInvocationsPerWorkgroup", 1024u, 1024u, false},
+    {"maxComputeWorkgroupSizeX", 1024u, 1024u, false},
+    {"maxComputeWorkgroupSizeY", 1024u, 1024u, false},
+    {"maxComputeWorkgroupSizeZ", 64u, 64u, false},
+    {"maxComputeWorkgroupsPerDimension", 65535u, 65535u, false},
+    {"maxImmediateSize", 64u, 64u, false},
+    {"maxStorageBuffersInVertexStage", 16u, 10u, false},
+    {"maxStorageTexturesInVertexStage", 8u, 8u, false},
+    {"maxStorageBuffersInFragmentStage", 16u, 10u, false},
+    {"maxStorageTexturesInFragmentStage", 8u, 8u, false},
+  };
+  for (const auto& limit : limits)
+    if (limit.name == name) return limit;
+  return std::nullopt;
+}
+inline uint64_t UxrRestrictGpuLimitV1(uint64_t actual, uint64_t target,
+                                    bool minimum) {
+  return minimum ? std::max(actual, target) : std::min(actual, target);
+}
+inline bool UxrGpuLimitRequestAllowedV1(uint64_t requested, uint64_t exposed,
+                                      bool minimum) {
+  return minimum ? requested >= exposed : requested <= exposed;
+}
+inline int UxrClampContextCapabilityV1(int actual, int requested) {
+  return requested > 0 ? std::min(actual, requested) : actual;
+}
