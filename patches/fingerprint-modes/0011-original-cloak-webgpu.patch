+bool GPUSupportedLimits::ValidateAndClampOriginalRequest(
+    ComboLimits* requested, const ComboLimits& actual,
+    ScriptPromiseResolverBase* resolver) const {
+  // Keep the original validation order when multiple fields are invalid.
+#define X(name)                                                               \
+  {                                                                         \
+    using T = decltype(ComboLimits::name);                                    \
+    if (requested->name != UndefinedLimitValue<T>()) {                        \
+      const auto* rule = base::UxrFindOriginalGpuLimitV1(#name);               \
+      const auto error = base::UxrOriginalGpuLimitErrorV1(                    \
+          requested->name, limits_.name, rule->minimum);                      \
+      if (error != base::UxrOriginalLimitErrorV1::kNone) {                     \
+        const String detail = error ==                                      \
+                base::UxrOriginalLimitErrorV1::kNotPowerOfTwo                 \
+            ? StrCat({"Required limit (", String::Number(requested->name),    \
+                      ") is not a power of two."})                          \
+            : StrCat({"Required limit (", String::Number(requested->name),    \
+                      rule->minimum                                         \
+                          ? ") is lower than the supported limit ("          \
+                          : ") is greater than the supported limit (",       \
+                      String::Number(limits_.name), ")."});                   \
+        resolver->RejectWithDOMException(                                   \
+            DOMExceptionCode::kOperationError,                              \
+            StrCat({detail, "\n - While validating " #name                  \
+                            "\n - While validating required limits\n"}));    \
+        return false;                                                       \
+      }                                                                      \
+      requested->name = static_cast<T>(base::UxrOriginalGpuForwardLimitV1(    \
+          requested->name, actual.name, rule->minimum));                     \
+    }                                                                        \
+  }
+  UXR_ORIGINAL_REQUEST_LIMITS(X)
+#undef X
+  return true;
+}
