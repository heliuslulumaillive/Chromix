+inline bool UxrOriginalGpuFeatureAllowedV1(
+    const UxrGpuProfileV1& profile, uint32_t feature,
+    bool windows_modern = true) {
+  if (!profile.macos()) {
+    if ((feature == 18 || feature == 23) && profile.family == "intel" &&
+        profile.index < 18 && ((0x10e60u >> profile.index) & 1u))
+      return false;
+    if (feature == 23) {
+      const auto a = profile.architecture;
+      return !windows_modern || a == "gen-12lp" || a == "xe-lpg" ||
+          a == "pascal" || a == "turing" || a == "ampere" ||
+          a == "lovelace" || a == "blackwell";
+    }
+  }
+  if (feature >= 1 && feature < 16 && ((0x7b0fu >> (feature - 1)) & 1u))
+    return true;
+  if (profile.macos())
+    return feature >= 5 && feature < 24 && ((0x7f84fu >> (feature - 5)) & 1u);
+  return feature < 23 && ((0x7f0820u >> feature) & 1u);
+}
+template <class Add>
+inline void UxrAddOriginalGpuFeaturesV1(const UxrGpuProfileV1& profile,
+                                      bool windows_modern, Add add) {
+  for (uint32_t feature : {11u, 17u, 21u, 19u, 20u})
+    add(feature);
+  if (UxrOriginalGpuFeatureAllowedV1(profile, 18, windows_modern))
+    add(18);
+  if ((profile.macos() || windows_modern) &&
+      UxrOriginalGpuFeatureAllowedV1(profile, 23, windows_modern))
+    add(23);
+}
