+inline uint64_t UxrOriginalGpuPublicLimitV1(
+    uint64_t actual, const UxrOriginalGpuLimitRuleV1& rule, bool macos) {
+  if (macos) return rule.macos_value;
+  switch (rule.windows_operation) {
+    case UxrOriginalLimitOperationV1::kSet: return rule.windows_value;
+    case UxrOriginalLimitOperationV1::kMinInput:
+      return std::min(actual, rule.windows_value);
+    case UxrOriginalLimitOperationV1::kMaxInput:
+      return std::max(actual, rule.windows_value);
+  }
+  return actual;
+}
+enum class UxrOriginalLimitErrorV1 { kNone, kOutsidePublicLimit, kNotPowerOfTwo };
+inline UxrOriginalLimitErrorV1 UxrOriginalGpuLimitErrorV1(
+    uint64_t requested, uint64_t exposed, bool minimum) {
+  if (minimum ? requested < exposed : requested > exposed)
+    return UxrOriginalLimitErrorV1::kOutsidePublicLimit;
+  if (minimum && (requested == 0 || (requested & (requested - 1)) != 0))
+    return UxrOriginalLimitErrorV1::kNotPowerOfTwo;
+  return UxrOriginalLimitErrorV1::kNone;
+}
+inline uint64_t UxrOriginalGpuForwardLimitV1(
+    uint64_t requested, uint64_t actual, bool minimum) {
+  return minimum ? std::max(requested, actual) : std::min(requested, actual);
+}
+inline uint64_t UxrOriginalGpuRestoreLimitV1(
+    uint64_t actual, uint64_t requested, bool minimum) {
+  return minimum ? std::min(actual, requested) : std::max(actual, requested);
+}
