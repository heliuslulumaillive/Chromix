+#ifndef BASE_UXR_CLOAK_REFERENCE_BANK_H_
+#define BASE_UXR_CLOAK_REFERENCE_BANK_H_
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include <vector>
+
+#include "base/base_export.h"
+#include "base/containers/span.h"
+
+namespace base {
+
+// A reconstruction of the observed seven UTF-8 fields. The recorder must not
+// normalize input coordinates, font getters, shader source, or operation order.
+using UxrCloakRecordedOp = std::array<std::string, 7>;
+using UxrCloakPattern = std::array<std::string_view, 7>;
+enum class UxrCloakOpStream { kMain, kPath, kGeometry };
+struct BASE_EXPORT UxrCloakHostLog {
+  std::vector<UxrCloakRecordedOp> main;
+  std::vector<UxrCloakRecordedOp> path;
+  std::vector<UxrCloakRecordedOp> geometry;
+  void Append(UxrCloakOpStream, UxrCloakRecordedOp);
+  // Lifetime only. A canvas reset, resize or clear does NOT clear these logs.
+  void Forget();
+};
+
+enum class UxrCloakReferenceFamily { kDefault, kIntel, kApple };
+// Renderer recognition precedes vendor recognition; Intel is checked first in
+// either string. The fallback is the observed H32(seed_text + "gpu_vendor").
+BASE_EXPORT UxrCloakReferenceFamily UxrCloakReferenceFamilyFor(
+    bool mac_platform, uint32_t seed_vendor_hash,
+    std::string_view renderer, std::string_view vendor);
+struct UxrCloakReference {
+  std::string_view row_id;
+  span<const uint8_t> bytes;
+  std::string_view sha256;
+  bool used_default_fallback = false;
+};
+struct UxrCloakExportQuery {
+  int width = 0;
+  int height = 0;
+  bool is_webgl = false;
+  std::string_view context_kind;
+  std::string_view mime_type;
+  int will_read_frequently = 0;
+  int desynchronized = 0;
+  double quality = -1;
+};
+struct UxrCloakImageDataQuery {
+  int canvas_width = 0;
+  int canvas_height = 0;
+  int read_x = 0;
+  int read_y = 0;
+  int read_width = 0;
+  int read_height = 0;
+  std::string_view context_kind;
+  std::string_view context_color_space;
+  std::string_view context_pixel_format;
+  std::string_view read_color_space;
+  std::string_view read_pixel_format;
+  int will_read_frequently = 0;
+  int desynchronized = 0;
+};
+struct UxrCloakGLReadQuery {
+  int drawing_buffer_width = 0;
+  int drawing_buffer_height = 0;
+  int read_x = 0;
+  int read_y = 0;
+  int read_width = 0;
+  int read_height = 0;
+  bool is_webgl2 = false;
+  uint32_t format = 0;
+  uint32_t type = 0;
+};
+
+BASE_EXPORT bool UxrCloakMatchOperation(const UxrCloakPattern&,
+                                       const UxrCloakRecordedOp&);
+BASE_EXPORT std::optional<UxrCloakReference> UxrSelectCloakExport(
+    const UxrCloakExportQuery&, const UxrCloakHostLog&,
+    UxrCloakReferenceFamily);
+BASE_EXPORT std::optional<UxrCloakReference> UxrSelectCloakImageData(
+    const UxrCloakImageDataQuery&, const UxrCloakHostLog&,
+    UxrCloakReferenceFamily);
+BASE_EXPORT std::optional<UxrCloakReference> UxrSelectCloakReadPixels(
+    const UxrCloakGLReadQuery&, const UxrCloakHostLog&,
+    UxrCloakReferenceFamily);
+// Copy a tightly packed reference into a validated destination without touching
+// row padding or bytes before the caller's pack skip. Never changes on failure.
+BASE_EXPORT bool UxrCopyCloakReferenceRows(span<const uint8_t> source,
+                                          span<uint8_t> destination,
+                                          size_t row_bytes,
+                                          size_t rows,
+                                          size_t destination_stride,
+                                          size_t destination_skip);
+// Exact native byte hash recovered from the original shaderSource path. It is
+// deliberately separate from the ordinary pixel seed hash and from std::hash.
+BASE_EXPORT uint64_t UxrCloakShaderHash64(span<const uint8_t>);
+BASE_EXPORT std::string UxrCloakShaderIdentifier(std::string_view exact_utf8);
+// %g is the observed C-locale, six-significant-digit operation representation.
+BASE_EXPORT std::string UxrCloakFormatNumbers(span<const double>);
+
+}  // namespace base
+#endif  // BASE_UXR_CLOAK_REFERENCE_BANK_H_
