+void Canvas2DRecorderContext::UxrRecordReferencePath(
+    bool stroke, SkPathFillType winding_rule) {
+  auto* host = GetCanvasRenderingContextHost();
+  auto* context = host ? host->RenderingContext() : nullptr;
+  if (!context || !context->UxrShouldRecordReference())
+    return;
+  const auto& style = stroke ? GetState().StrokeStyle() : GetState().FillStyle();
+  const std::string color = style.GetCanvasGradient() || style.GetCanvasPattern()
+      ? std::string() : style.GetColorAsString().Utf8();
+  const SkRect bounds = GetPath().GetSkPath().getBounds();
+  const double coords[]{bounds.x(), bounds.y(), bounds.width(), bounds.height()};
+  base::UxrCloakRecordedOp op{
+      stroke ? "strokePath" : "fillPath", globalCompositeOperation().Utf8(),
+      winding_rule == SkPathFillType::kEvenOdd ? "evenodd" : "nonzero",
+      base::UxrCloakFormatNumbers(coords), color, "", ""};
+  context->UxrRecordReference(base::UxrCloakOpStream::kGeometry, op);
+  if (!stroke && winding_rule == SkPathFillType::kEvenOdd && !color.empty())
+    context->UxrRecordReference(base::UxrCloakOpStream::kPath, std::move(op));
+}
