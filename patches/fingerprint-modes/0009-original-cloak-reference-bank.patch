+bool CanvasRenderingContext::UxrShouldRecordReference() const {
+  if (!Host() || (!IsRenderingContext2D() && !IsWebGL()) ||
+      Host()->width() >= 513 || Host()->height() >= 513)
+    return false;
+  const auto& modes = base::UxrConfig::GetInstance().SurfaceModes();
+  return (IsWebGL() ? modes.webgl : modes.canvas).mode ==
+         base::UxrSurfaceMode::kCloakOriginal;
+}
+
+bool CanvasRenderingContext::UxrCanUseReference() const {
+  if (!Host() || (!IsRenderingContext2D() && !IsWebGL()))
+    return false;
+  const auto& modes = base::UxrConfig::GetInstance().SurfaceModes();
+  return !modes.raw && (IsWebGL() ? modes.webgl : modes.canvas).mode ==
+         base::UxrSurfaceMode::kCloakOriginal;
+}
+
+void CanvasRenderingContext::UxrRecordReference(
+    base::UxrCloakOpStream stream, base::UxrCloakRecordedOp op) {
+  if (UxrShouldRecordReference())
+    uxr_cloak_reference_log_.Append(stream, std::move(op));
+}
+
+base::UxrCloakReferenceFamily CanvasRenderingContext::UxrReferenceFamily() const {
+  const auto& config = base::UxrConfig::GetInstance();
+  const auto& modes = config.SurfaceModes();
+  bool mac = modes.platform == "macos";
+#if BUILDFLAG(IS_MAC)
+  mac = mac || modes.platform.empty();
+#endif
+  auto seed_text = config.Get("uxr-fingerprint-seed");
+  if (seed_text.empty())
+    seed_text = std::to_string((IsWebGL() ? modes.webgl : modes.canvas).seed);
+  return base::UxrCloakReferenceFamilyFor(
+      mac, base::UxrCloakHashV1(seed_text + "gpu_vendor"),
+      config.Get("uxr-webgl-renderer"), config.Get("uxr-webgl-vendor"));
+}
+
+std::optional<base::UxrCloakReference>
+CanvasRenderingContext::UxrSelectExportReference(std::string_view mime,
+                                                double quality) const {
+  if (!UxrCanUseReference())
+    return std::nullopt;
+  const bool offscreen = Host()->IsOffscreenCanvas();
+  // Only the proven PNG Offscreen consumer is included. Its original call
+  // passes the PNG MIME and undefined-quality sentinel regardless of options.
+  if (offscreen && mime != "image/png")
+    return std::nullopt;
+  const auto& attrs = CreationAttributes();
+  const std::string_view kind = IsWebGL()
+      ? (offscreen ? "offscreen-webgl" : "webgl")
+      : (offscreen ? "offscreen-2d" : "2d");
+  return base::UxrSelectCloakExport(
+      {Host()->width(), Host()->height(), IsWebGL(), kind, mime,
+       attrs.will_read_frequently ==
+           CanvasContextCreationAttributesCore::WillReadFrequently::kTrue,
+       attrs.desynchronized, offscreen ? -1 : quality},
+      uxr_cloak_reference_log_, UxrReferenceFamily());
+}
