+++ b/base/uxr_cloak_reference_bank.cc
@@ -0,0 +1,336 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license.
+#include "base/uxr_cloak_reference_bank.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <utility>
+
+namespace base {
+namespace {
+struct Payload {
+  span<const uint8_t> bytes;
+  std::string_view sha256;
+};
+struct Variants { const Payload* normal; const Payload* intel; const Payload* apple; };
+struct OpConstraint { span<const UxrCloakPattern> patterns; size_t total; };
+struct ExportRow {
+  std::string_view id;
+  int width, height;
+  bool is_webgl;
+  std::string_view kind, mime;
+  int frequent, desync;
+  double quality;
+  OpConstraint main, geometry;
+  bool path_table;
+  Variants variants;
+};
+struct ImageDataRow {
+  std::string_view id;
+  int min_width, min_height, exact_width, exact_height;
+  int x, y, width, height;
+  std::string_view kind, context_color, context_format, read_color, read_format;
+  int frequent, desync;
+  OpConstraint main, geometry, path;
+  Variants variants;
+};
+struct GLReadRow {
+  std::string_view id;
+  int buffer_width, buffer_height, x, y, width, height;
+  bool is_webgl2;
+  uint32_t format, type;
+  OpConstraint main;
+  Variants variants;
+};
+
+// Generated from the hash-bound original bank. No site URL, JS injection or
+// backing-store modification is involved in selecting these readback bytes.
+#include "base/uxr_cloak_reference_data.inc"
+
+bool Matches(const OpConstraint& required,
+             const std::vector<UxrCloakRecordedOp>& observed,
+             bool optional = false) {
+  if (optional && required.patterns.empty() && !required.total)
+    return true;
+  if (observed.size() != (required.total ? required.total :
+                                           required.patterns.size()) ||
+      observed.size() < required.patterns.size())
+    return false;
+  for (size_t i = 0; i < required.patterns.size(); ++i) {
+    if (!UxrCloakMatchOperation(required.patterns[i], observed[i]))
+      return false;
+  }
+  return true;
+}
+bool Optional(std::string_view pattern, std::string_view observed) {
+  return pattern.empty() || pattern == observed;
+}
+std::string AsciiLower(std::string_view input) {
+  std::string result(input);
+  for (char& c : result) {
+    if (c >= 'A' && c <= 'Z')
+      c += 'a' - 'A';
+  }
+  return result;
+}
+std::optional<UxrCloakReferenceFamily> RecognizedFamily(std::string_view input) {
+  const std::string lower = AsciiLower(input);
+  for (const auto& token : kIntelFamilyTokens) {
+    if (!token.empty() && lower.find(AsciiLower(token)) != std::string::npos)
+      return UxrCloakReferenceFamily::kIntel;
+  }
+  for (const auto& token : kNvidiaFamilyTokens) {
+    if (!token.empty() && lower.find(AsciiLower(token)) != std::string::npos)
+      return UxrCloakReferenceFamily::kDefault;
+  }
+  return std::nullopt;
+}
+bool Flag(int expected, int actual) {
+  return expected == -1 || expected == actual;
+}
+UxrCloakReference Reference(std::string_view id, Variants v,
+                           UxrCloakReferenceFamily family) {
+  const Payload* chosen = v.normal;
+  if (family == UxrCloakReferenceFamily::kIntel)
+    chosen = v.intel;
+  else if (family == UxrCloakReferenceFamily::kApple)
+    chosen = v.apple;
+  const bool fallback = !chosen;
+  if (!chosen)
+    chosen = v.normal;
+  return {id, chosen->bytes, chosen->sha256, fallback};
+}
+constexpr uint64_t k0 = 0xc3a5c85c97cb3127ULL;
+constexpr uint64_t k1 = 0xb492b66fbe98f273ULL;
+constexpr uint64_t k2 = 0x9ae16a3b2f90404fULL;
+constexpr uint64_t k3 = 0xc949d7c7509e6557ULL;
+uint64_t Rotate(uint64_t v, unsigned n) { return (v >> n) | (v << (64 - n)); }
+uint64_t Mix(uint64_t v) { return v ^ (v >> 47); }
+uint64_t Hash16(uint64_t a, uint64_t b) {
+  constexpr uint64_t multiplier = 0x9ddfea08eb382d69ULL;
+  uint64_t x = (a ^ b) * multiplier;
+  x ^= x >> 47;
+  uint64_t y = (b ^ x) * multiplier;
+  y ^= y >> 47;
+  return y * multiplier;
+}
+}  // namespace
+
+UxrCloakReferenceFamily UxrCloakReferenceFamilyFor(
+    bool mac_platform, uint32_t seed_vendor_hash,
+    std::string_view renderer, std::string_view vendor) {
+  if (mac_platform)
+    return UxrCloakReferenceFamily::kApple;
+  if (const auto family = RecognizedFamily(renderer))
+    return *family;
+  if (const auto family = RecognizedFamily(vendor))
+    return *family;
+  return seed_vendor_hash & 1 ? UxrCloakReferenceFamily::kIntel :
+                               UxrCloakReferenceFamily::kDefault;
+}
+
+void UxrCloakHostLog::Append(UxrCloakOpStream stream, UxrCloakRecordedOp op) {
+  auto& entries = stream == UxrCloakOpStream::kMain ? main :
+                  stream == UxrCloakOpStream::kPath ? path : geometry;
+  if (entries.size() >= 256)
+    entries.clear();
+  entries.push_back(std::move(op));
+}
+void UxrCloakHostLog::Forget() { main.clear(); path.clear(); geometry.clear(); }
+bool UxrCloakMatchOperation(const UxrCloakPattern& p,
+                          const UxrCloakRecordedOp& o) {
+  if (p[0] != o[0] || p[2] != o[2] ||
+      (!p[1].empty() && o[1].find(p[1]) == std::string::npos))
+    return false;
+  for (size_t i = 3; i < p.size(); ++i) {
+    if (!p[i].empty() && p[i] != o[i])
+      return false;
+  }
+  return true;
+}
+std::optional<UxrCloakReference> UxrSelectCloakExport(
+    const UxrCloakExportQuery& q, const UxrCloakHostLog& log,
+    UxrCloakReferenceFamily family) {
+  const ExportRow* unique = nullptr;
+  for (const auto& r : kExportRows) {
+    if (r.width != q.width || r.height != q.height ||
+        r.is_webgl != q.is_webgl)
+      continue;
+    if (r.path_table) {
+      if (q.mime_type != "image/png" || !Matches(r.main, log.path))
+        continue;
+    } else if (!Optional(r.kind, q.context_kind) || !Optional(r.mime, q.mime_type) ||
+               !Flag(r.frequent, q.will_read_frequently) ||
+               !Flag(r.desync, q.desynchronized) ||
+               (r.quality >= 0 && r.quality != q.quality) ||
+               !Matches(r.main, log.main) ||
+               !Matches(r.geometry, log.geometry, true)) {
+      continue;
+    }
+    if (unique)
+      return std::nullopt;  // Even two rows sharing the same payload are ambiguous.
+    unique = &r;
+  }
+  return unique ? std::make_optional(Reference(unique->id, unique->variants, family))
+                : std::nullopt;
+}
+std::optional<UxrCloakReference> UxrSelectCloakImageData(
+    const UxrCloakImageDataQuery& q, const UxrCloakHostLog& log,
+    UxrCloakReferenceFamily family) {
+  const ImageDataRow* unique = nullptr;
+  constexpr int wildcard_coordinate = std::numeric_limits<int>::min() + 1;
+  for (const auto& r : kImageDataRows) {
+    if (q.canvas_width < r.min_width || q.canvas_height < r.min_height ||
+        (r.exact_width && q.canvas_width != r.exact_width) ||
+        (r.exact_height && q.canvas_height != r.exact_height) ||
+        (r.x != wildcard_coordinate && q.read_x != r.x) ||
+        (r.y != wildcard_coordinate && q.read_y != r.y) ||
+        q.read_width != r.width || q.read_height != r.height ||
+        !Optional(r.kind, q.context_kind) ||
+        !Optional(r.context_color, q.context_color_space) ||
+        !Optional(r.context_format, q.context_pixel_format) ||
+        !Optional(r.read_color, q.read_color_space) ||
+        !Optional(r.read_format, q.read_pixel_format) ||
+        !Flag(r.frequent, q.will_read_frequently) ||
+        !Flag(r.desync, q.desynchronized) || !Matches(r.main, log.main) ||
+        !Matches(r.geometry, log.geometry, true) ||
+        !Matches(r.path, log.path, true))
+      continue;
+    if (unique)
+      return std::nullopt;
+    unique = &r;
+  }
+  return unique ? std::make_optional(Reference(unique->id, unique->variants, family))
+                : std::nullopt;
+}
+std::optional<UxrCloakReference> UxrSelectCloakReadPixels(
+    const UxrCloakGLReadQuery& q, const UxrCloakHostLog& log,
+    UxrCloakReferenceFamily family) {
+  const GLReadRow* unique = nullptr;
+  for (const auto& r : kGLReadRows) {
+    if (q.drawing_buffer_width != r.buffer_width ||
+        q.drawing_buffer_height != r.buffer_height || q.read_x != r.x ||
+        q.read_y != r.y || q.read_width != r.width || q.read_height != r.height ||
+        q.is_webgl2 != r.is_webgl2 || q.format != r.format || q.type != r.type ||
+        !Matches(r.main, log.main))
+      continue;
+    if (unique)
+      return std::nullopt;
+    unique = &r;
+  }
+  return unique ? std::make_optional(Reference(unique->id, unique->variants, family))
+                : std::nullopt;
+}
+bool UxrCopyCloakReferenceRows(span<const uint8_t> source,
+                              span<uint8_t> destination,
+                              size_t row_bytes, size_t rows,
+                              size_t stride, size_t skip) {
+  if (!row_bytes || !rows || stride < row_bytes ||
+      rows > std::numeric_limits<size_t>::max() / row_bytes ||
+      source.size() != row_bytes * rows || skip > destination.size() ||
+      row_bytes > destination.size() - skip ||
+      (rows - 1) > (destination.size() - skip - row_bytes) / stride)
+    return false;
+  for (size_t y = 0; y < rows; ++y)
+    std::copy_n(source.begin() + y * row_bytes, row_bytes,
+                destination.begin() + skip + y * stride);
+  return true;
+}
+
+uint64_t UxrCloakShaderHash64(span<const uint8_t> bytes) {
+  const size_t n = bytes.size();
+  auto fetch64 = [&](size_t p) {
+    uint64_t r = 0;
+    for (size_t i = 0; i < 8; ++i)
+      r |= uint64_t{bytes[p + i]} << (8 * i);
+    return r;
+  };
+  auto fetch32 = [&](size_t p) {
+    uint64_t r = 0;
+    for (size_t i = 0; i < 4; ++i)
+      r |= uint64_t{bytes[p + i]} << (8 * i);
+    return r;
+  };
+  if (n <= 16) {
+    if (n > 8) {
+      const auto a = fetch64(0), b = fetch64(n - 8);
+      return Hash16(a, Rotate(b + n, static_cast<unsigned>(n))) ^ b;
+    }
+    if (n >= 4)
+      return Hash16(n + (fetch32(0) << 3), fetch32(n - 4));
+    if (n) {
+      const uint64_t y = bytes[0] + (uint64_t{bytes[n >> 1]} << 8);
+      const uint64_t z = n + (uint64_t{bytes[n - 1]} << 2);
+      return Mix((y * k2) ^ (z * k3)) * k2;
+    }
+    return k2;
+  }
+  if (n <= 32) {
+    const auto a = fetch64(0) * k1, b = fetch64(8);
+    const auto c = fetch64(n - 8) * k2, d = fetch64(n - 16) * k0;
+    return Hash16(Rotate(a - b, 43) + Rotate(c, 30) + d,
+                  a + Rotate(b ^ k3, 20) - c + n);
+  }
+  if (n <= 64) {
+    auto z = fetch64(24);
+    auto a = fetch64(0) + (n + fetch64(n - 16)) * k0;
+    auto b = Rotate(a + z, 52), c = Rotate(a, 37);
+    a += fetch64(8); c += Rotate(a, 7); a += fetch64(16);
+    const auto vf = a + z, vs = b + Rotate(a, 31) + c;
+    a = fetch64(16) + fetch64(n - 32); z += fetch64(n - 8);
+    b = Rotate(a + z, 52); c = Rotate(a, 37);
+    a += fetch64(n - 24); c += Rotate(a, 7); a += fetch64(n - 16);
+    const auto wf = a + z, ws = b + Rotate(a, 31) + c;
+    const auto r = Mix((vf + ws) * k2 + (wf + vs) * k0);
+    return Mix(r * k0 + vs) * k2;
+  }
+  auto weak = [&](size_t p, uint64_t a, uint64_t b) {
+    const auto w = fetch64(p), x = fetch64(p + 8),
+               y = fetch64(p + 16), z = fetch64(p + 24);
+    a += w; b = Rotate(b + a + z, 21);
+    const auto c = a;
+    a += x + y; b += Rotate(a, 44);
+    return std::pair<uint64_t, uint64_t>{a + z, b + c};
+  };
+  auto x = fetch64(n - 40);
+  auto y = fetch64(n - 16) + fetch64(n - 56);
+  auto z = Hash16(fetch64(n - 48) + n, fetch64(n - 24));
+  auto v = weak(n - 64, n, z), w = weak(n - 32, y + k1, x);
+  x = x * k1 + fetch64(0);
+  for (size_t p = 0, stop = (n - 1) & ~size_t{63}; p < stop; p += 64) {
+    x = Rotate(x + y + v.first + fetch64(p + 8), 37) * k1;
+    y = Rotate(y + v.second + fetch64(p + 48), 42) * k1;
+    x ^= w.second; y += v.first + fetch64(p + 40);
+    z = Rotate(z + w.first, 33) * k1;
+    v = weak(p, v.second * k1, x + w.first);
+    w = weak(p + 32, z + w.second, y + fetch64(p + 16));
+    std::swap(x, z);
+  }
+  return Hash16(Hash16(v.first, w.first) + Mix(y) * k1 + z,
+                Hash16(v.second, w.second) + x);
+}
+std::string UxrCloakShaderIdentifier(std::string_view bytes) {
+  const uint32_t low = static_cast<uint32_t>(UxrCloakShaderHash64(
+      span<const uint8_t>(reinterpret_cast<const uint8_t*>(bytes.data()), bytes.size())));
+  // Avoid implementation-defined unsigned-to-signed conversion.
+  const int64_t signed_low = low < 0x80000000u ? int64_t{low} :
+                              int64_t{low} - 0x100000000LL;
+  return std::to_string(signed_low);
+}
+std::string UxrCloakFormatNumbers(span<const double> values) {
+  std::string result;
+  for (double value : values) {
+    char buffer[48];
+    const int written = std::snprintf(buffer, sizeof(buffer), "%g", value);
+    if (written < 0 || static_cast<size_t>(written) >= sizeof(buffer))
+      return {};
+    if (!result.empty())
+      result += ',';
+    result.append(buffer, static_cast<size_t>(written));
+  }
+  return result;
+}
+}  // namespace base
