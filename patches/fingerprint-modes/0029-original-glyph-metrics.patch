--- /dev/null
+++ b/base/uxr_original_glyph_metrics.h
@@ -0,0 +1,109 @@
+// Copyright 2026. Original glyph policy/math; Skia requests stay in Blink.
+#ifndef BASE_UXR_ORIGINAL_GLYPH_METRICS_H_
+#define BASE_UXR_ORIGINAL_GLYPH_METRICS_H_
+
+#include <cmath>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace base {
+
+enum class UxrOriginalGlyphPolicyV2 {
+  kNative,
+  kWindows,
+  kMacos,
+};
+
+// Browser-only normalization. The renderer receives the resolved private value;
+// it must not infer a platform from its own UA, hardware profile or host.
+inline std::optional<std::string> UxrNormalizeGlyphPlatformV2(
+    std::string_view public_platform,
+    std::string_view host_platform) {
+  std::string platform(public_platform.empty() ? host_platform : public_platform);
+  for (char& c : platform) {
+    if (c >= 'A' && c <= 'Z')
+      c = static_cast<char>(c + ('a' - 'A'));
+  }
+  if (platform == "win32")
+    platform = "windows";
+  else if (platform == "macintel")
+    platform = "macos";
+  else if (platform == "linux x86_64")
+    platform = "linux";
+  if (platform != "windows" && platform != "macos" && platform != "linux")
+    return std::nullopt;
+  return platform;
+}
+
+inline UxrOriginalGlyphPolicyV2 UxrResolveOriginalGlyphPolicyV2(
+    std::string_view mode,
+    std::string_view version,
+    bool fingerprint_off,
+    std::string_view resolved_platform) {
+  // This policy is not pixel/text-reference noise: raw/false are intentionally
+  // not inputs. The product's existing global off still takes precedence.
+  if (fingerprint_off || mode != "cloak-original" || version != "2")
+    return UxrOriginalGlyphPolicyV2::kNative;
+  if (resolved_platform == "windows")
+    return UxrOriginalGlyphPolicyV2::kWindows;
+  if (resolved_platform == "macos")
+    return UxrOriginalGlyphPolicyV2::kMacos;
+  return UxrOriginalGlyphPolicyV2::kNative;
+}
+
+struct UxrGlyphBoundsV2 {
+  float left;
+  float top;
+  float right;
+  float bottom;
+};
+
+inline bool UxrGlyphHasInkV2(const UxrGlyphBoundsV2& bounds) {
+  // Ordered comparisons match the original empty/unordered early return.
+  return bounds.right > bounds.left && bounds.bottom > bounds.top;
+}
+
+inline bool UxrApplyOriginalGlyphVerticalV2(
+    const UxrGlyphBoundsV2& strike_bounds,
+    UxrGlyphBoundsV2& output) {
+  if (!UxrGlyphHasInkV2(strike_bounds))
+    return false;
+  const float top = strike_bounds.top + 0.25f;
+  const float bottom = strike_bounds.bottom - 0.25f;
+  if (!(bottom > top))
+    return false;
+  output.top = std::floor(top);
+  output.bottom = std::ceil(bottom);
+  return true;
+}
+
+inline float UxrOriginalGlyphIntegerCoordinateV2(float value) {
+  // Actual original float constants, not a rounded float(INT32_MAX).
+  constexpr float kLimit = 2147483520.0f;
+  // Original MINSS then MAXSS also selects the finite limit on NaN. Inputs
+  // from a valid nonempty path are ordered, but keep this conversion defined.
+  value = std::fmax(std::fmin(value, kLimit), -kLimit);
+  return static_cast<float>(static_cast<int32_t>(value));
+}
+
+inline bool UxrApplyOriginalGlyphHorizontalV2(
+    const UxrGlyphBoundsV2& path_bounds,
+    UxrGlyphBoundsV2& output) {
+  if (!UxrGlyphHasInkV2(path_bounds))
+    return false;
+  output.right = UxrOriginalGlyphIntegerCoordinateV2(
+      std::ceil(path_bounds.right + 0.25f));
+  output.left = UxrOriginalGlyphIntegerCoordinateV2(
+      std::floor(path_bounds.left - 0.25f));
+  return true;
+}
+
+inline float UxrOriginalGlyphRoundedSizeV2(float size) {
+  return std::floor(size + 0.5f);
+}
+
+}  // namespace base
+
+#endif  // BASE_UXR_ORIGINAL_GLYPH_METRICS_H_
