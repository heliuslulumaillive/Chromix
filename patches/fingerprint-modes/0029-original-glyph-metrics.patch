+
+base::UxrGlyphBoundsV2 UxrGlyphRectangle(const SkRect& rect) {
+  return {rect.fLeft, rect.fTop, rect.fRight, rect.fBottom};
+}
+
+// The original vertical request uses a mask-style strike with these explicit
+// inputs. Ordinary SkFont::getPath() canonicalizes differently and is not a
+// replacement for this stage.
+bool UxrOriginalWindowsStrikeBounds(const SkFont& font,
+                                   Glyph glyph,
+                                   SkRect* bounds) {
+  SkPaint paint;
+  paint.setStrokeMiter(4.0f);
+  const SkSurfaceProps props(0, kUnknown_SkPixelGeometry, 1.0f, 0.0f);
+  const SkStrikeSpec spec = SkStrikeSpec::MakeMask(
+      font, paint, props, SkScalerContextFlags::kFakeGammaAndBoostContrast,
+      SkMatrix::I());
+  SkBulkGlyphMetricsAndPaths bulk(spec);
+  const SkGlyph* sk_glyph = bulk.glyph(glyph);
+  const SkPath* path = sk_glyph ? sk_glyph->path() : nullptr;
+  if (!path || path->isEmpty())
+    return false;
+  *bounds = path->getBounds();
+  return true;
+}
+
+void UxrOriginalWindowsGlyphBounds(const SkFont& font,
+                                  Glyph glyph,
+                                  SkRect* bounds) {
+  *bounds = font.getBounds(glyph, nullptr);
+  auto output = UxrGlyphRectangle(*bounds);
+  if (!base::UxrGlyphHasInkV2(output))
+    return;
+
+  SkRect strike_bounds = SkRect::MakeEmpty();
+  if (UxrOriginalWindowsStrikeBounds(font, glyph, &strike_bounds))
+    base::UxrApplyOriginalGlyphVerticalV2(UxrGlyphRectangle(strike_bounds),
+                                        output);
+
+  const float rounded_size = base::UxrOriginalGlyphRoundedSizeV2(font.getSize());
+  SkFont rounded_font;
+  const SkFont* path_font = &font;
+  if (rounded_size > 0.0f && rounded_size != font.getSize()) {
+    rounded_font = font;
+    rounded_font.setSize(rounded_size);
+    path_font = &rounded_font;
+  }
+  if (const auto path = path_font->getPath(glyph))
+    base::UxrApplyOriginalGlyphHorizontalV2(
+        UxrGlyphRectangle(path->getBounds()), output);
+  *bounds = SkRect::MakeLTRB(output.left, output.top, output.right, output.bottom);
+}
+
+void UxrOriginalMacGlyphBounds(const SkFont& font,
+                              Glyph glyph,
+                              SkRect* bounds) {
+  if (const auto path = font.getPath(glyph))
+    *bounds = path->getBounds();
+  else
+    *bounds = font.getBounds(glyph, nullptr);
+}
