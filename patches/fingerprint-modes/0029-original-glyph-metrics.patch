+
+namespace {
+constexpr float F(uint32_t bits) { return std::bit_cast<float>(bits); }
+bool Same(float a, float b) {
+  return (std::isnan(a) && std::isnan(b)) ||
+         std::bit_cast<uint32_t>(a) == std::bit_cast<uint32_t>(b);
+}
+bool Same(const base::UxrGlyphBoundsV2& a, const base::UxrGlyphBoundsV2& b) {
+  return Same(a.left,b.left) && Same(a.top,b.top) &&
+         Same(a.right,b.right) && Same(a.bottom,b.bottom);
+}
+}  // namespace
