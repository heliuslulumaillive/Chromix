+  using M = UxrSurfaceMode;
+  return read("canvas", &modes->canvas, 0, 0,
+              {M::kNative, M::kChromix, M::kShardX, M::kCloak}) &&
+         read("webgl", &modes->webgl, 0, 0,
+              {M::kNative, M::kChromix, M::kShardX, M::kCloak}) &&
+         read("audio", &modes->audio, 0, 1,
+              {M::kNative, M::kChromix, M::kShardX, M::kCloak}) &&
+         read("fonts", &modes->fonts, 0, 0,
+              {M::kNative, M::kChromix, M::kShardX, M::kCloak}) &&
+         read("rects", &modes->rects, 1, 16,
+              {M::kNative, M::kChromix, M::kShardX}) &&
+         read("text", &modes->text, 1, 16,
+              {M::kNative, M::kChromix, M::kShardX, M::kCloak}) &&
+         read("offset", &modes->offset, 0, 0,
+              {M::kNative, M::kChromix, M::kCloak}) &&
