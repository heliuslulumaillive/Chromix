+// Copyright 2026. Observed catalog facts; independent selection code.
+#ifndef BASE_UXR_CLOAK_HARDWARE_H_
+#define BASE_UXR_CLOAK_HARDWARE_H_
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+#include "base/base_export.h"
+namespace base {
+struct UxrHardwareChoice {
+  std::string family;
+  unsigned index = 0;
+  std::string model;
+  std::string device_id;
+  unsigned cpu = 0;
+  unsigned memory_gb = 0;
+  std::string webgl_vendor;
+  std::string webgl_renderer;
+};
+// Versioned observed Windows/macOS catalog. Does not create GPU capabilities.
+// A negative index uses the recovered default weights. An explicit index may
+// choose a catalog entry whose default weight is zero.
+BASE_EXPORT std::optional<UxrHardwareChoice> UxrSelectCloakHardwareV1(
+    uint64_t seed, std::string_view platform,
+    std::string_view family = {}, int index = -1);
+}  // namespace base
+#endif
