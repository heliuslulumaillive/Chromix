+std::optional<UxrHardwareChoice> UxrSelectCloakHardwareV1(
+    uint64_t seed, std::string_view platform, std::string_view family,
+    int requested_index) {
+  if (!seed || requested_index < -1)
+    return std::nullopt;
+  const std::string seed_text = std::to_string(seed);
+  const auto hash = [&](const char* label) {
+    return UxrCloakHashV1(seed_text + label);
+  };
+  if (platform == "macos") {
+    if (!family.empty() && family != "apple")
+      return std::nullopt;
+    family = "apple";
+  } else if (platform == "windows") {
+    if (family.empty())
+      family = (hash("gpu_vendor") & 1) ? "intel" : "nvidia";
+    if (family != "intel" && family != "nvidia")
+      return std::nullopt;
+  } else {
+    return std::nullopt;  // No recovered Linux hardware-selection branch.
+  }
+  const std::span<const Row> rows =
+      family == "apple" ? std::span<const Row>(kApple) :
+      family == "intel" ? std::span<const Row>(kIntel) :
+                          std::span<const Row>(kNvidia);
+  unsigned index = 0;
+  if (requested_index >= 0) {
+    index = static_cast<unsigned>(requested_index);
+    if (index >= rows.size())
+      return std::nullopt;
+  } else if (family == "apple") {
+    index = kAppleWeights[hash("gpu_renderer") % std::size(kAppleWeights)];
+  } else {
+    index = hash("gpu_renderer") % rows.size();
+    if (family == "nvidia" && (index == 0 || index == 2))
+      index = kNvidiaRedirect[hash("gpu_renderer_redirect") %
+                             std::size(kNvidiaRedirect)];
+  }
+  const Row& row = rows[index];
+  UxrHardwareChoice choice;
+  choice.family = family;
+  choice.index = index;
+  choice.model = row.model;
+  choice.device_id = row.device;
+  if (family == "apple") {
+    const auto profiles = kAppleProfiles[index];
+    unsigned total = 0;
+    for (const auto& item : profiles)
+      total += item.weight;
+    unsigned pick = hash("apple_hardware_profile") % total;
+    for (const auto& item : profiles) {
+      if (pick < item.weight) {
+        choice.cpu = item.cpu;
+        choice.memory_gb = item.memory;
+        break;
+      }
+      pick -= item.weight;
+    }
+    choice.webgl_vendor = "Google Inc. (Apple)";
+    choice.webgl_renderer = "ANGLE (Apple, ANGLE Metal Renderer: Apple " +
+                            choice.model + ", Unspecified Version)";
+  } else {
+    choice.cpu = row.cpus[hash("hardware_concurrency") % row.cpu_count];
+    choice.memory_gb = row.memory[hash("device_memory") % row.memory_count];
+    const std::string brand = family == "intel" ? "Intel" : "NVIDIA";
+    choice.webgl_vendor = "Google Inc. (" + brand + ")";
+    choice.webgl_renderer = "ANGLE (" + brand + ", " +
+        (family == "nvidia" ? "NVIDIA " : "") + choice.model + " (" +
+        choice.device_id + ") Direct3D11 vs_5_0 ps_5_0, D3D11)";
+  }
+  return choice;
+}
