+template <class Aliases>
+inline bool OriginalFontAliasMatch(const Aliases& aliases,
+                                   std::string_view first,
+                                   std::string_view second) {
+  for (const auto& row : aliases) {
+    if ((first == row.first && second == row.second) ||
+        (first == row.second && second == row.first)) return true;
+  }
+  return false;
+}
+inline bool OriginalFontBaseNameMatch(std::string_view actual,
+                                     std::string_view requested) {
+  const std::string a = OriginalFontLower(actual);
+  const std::string b = OriginalFontLower(requested);
+  if (a.empty() || b.empty()) return false;
+  return a.starts_with(b) || b.starts_with(a) ||
+      OriginalFontAliasMatch(kOriginalLocalizedFontAliases, a, b) ||
+      (a.starts_with("sitka") && b.starts_with("sitka"));
+}
+inline bool OriginalFontWindowsNameMatch(std::string_view actual,
+                                        std::string_view requested) {
+  return OriginalFontBaseNameMatch(actual, requested) ||
+      OriginalFontAliasMatch(kOriginalWindowsFontAliases,
+                            OriginalFontLower(actual), OriginalFontLower(requested));
+}
+inline bool OriginalWindowsFontPoolContains(std::string_view requested,
+                                           uint64_t seed) {
+  if (CloakFontCandidate(requested, "windows", seed)) return true;
+  const auto any_alias = [&](const auto& aliases) {
+    for (const auto& row : aliases) {
+      if (requested == row.first && CloakFontCandidate(row.second, "windows", seed))
+        return true;
+      if (requested == row.second && CloakFontCandidate(row.first, "windows", seed))
+        return true;
+    }
+    return false;
+  };
+  return any_alias(kOriginalLocalizedFontAliases) ||
+         any_alias(kOriginalWindowsFontAliases);
+}
+struct OriginalFontCoverage {
+  bool windows_ready = true;
+  bool macos_ready = false;
+};
+template <class MatchFamily>
+inline OriginalFontCoverage OriginalFontCoverageFor(
+    std::string_view target, std::string_view host, MatchFamily match_family) {
+  OriginalFontCoverage state;
+  if (target == "windows") {
+    unsigned count = 0;
+    for (const auto name : kWindowsBase)
+      count += OriginalFontWindowsNameMatch(match_family(name), name);
+    state.windows_ready = count >= 25;
+  }
+  if (target == "macos" && target != host) {
+    unsigned count = 0;
+    for (const auto name : kOriginalMacCoverageFonts)
+      count += OriginalFontBaseNameMatch(match_family(name), name);
+    state.macos_ready = count >= 17;
+  }
+  return state;
+}
+enum class OriginalFontAction {
+  kNative, kReject, kVerifyBase, kVerifyWindows, kRemapFranklin
+};
+inline OriginalFontAction OriginalFontSelection(
+    std::string_view requested, std::string_view target, std::string_view host,
+    uint64_t seed, OriginalFontCoverage coverage, bool by_family,
+    unsigned alternate_name, bool explicit_mac_platform) {
+  if (!by_family) return OriginalFontAction::kNative;
+  const std::string family = OriginalFontLower(requested);
+  // Shipped private-name rejection precedes the ordinary last-resort bypass.
+  if (explicit_mac_platform && family.starts_with('.'))
+    return OriginalFontAction::kReject;
+  // Chromium 155: 2=local unique face, 3=last resort. Never pool-filter fallback.
+  if (alternate_name == 3) return OriginalFontAction::kNative;
+  const bool strict_windows = target == "windows" && coverage.windows_ready;
+  const bool strict_macos = target == "macos" && coverage.macos_ready;
+  if (strict_windows) {
+    if (alternate_name == 2 && (family == "times" || family == "helvetica" ||
+                                family == "franklin gothic heavy"))
+      return OriginalFontAction::kReject;
+    if (alternate_name != 2 && family == "franklin gothic")
+      return OriginalFontAction::kRemapFranklin;
+  }
+  const bool in_target = CloakFontCandidate(family, target, seed);
+  if (ContainsFont(kOriginalCommonFontFamilies, family) &&
+      (!(strict_windows || strict_macos) || !in_target))
+    return OriginalFontAction::kNative;
+  if (strict_windows) {
+    return OriginalWindowsFontPoolContains(family, seed)
+        ? OriginalFontAction::kVerifyWindows : OriginalFontAction::kReject;
+  }
+  if (target != host) {
+    if (strict_macos)
+      return in_target ? OriginalFontAction::kVerifyBase : OriginalFontAction::kReject;
+    if (CloakFontCandidate(family, host, seed) && !in_target)
+      return OriginalFontAction::kReject;
+  }
+  return OriginalFontAction::kNative;
+}
