+// Original Windows CloakBrowser 155 font-selection policy. Public metric tables
+// are independent. These rules select/reject real installed faces, not assets.
+inline std::string OriginalFontLower(std::string_view value) {
+  std::string result(value);
+  for (char& c : result) {
+    if (c >= 'A' && c <= 'Z') c += 'a' - 'A';
+  }
+  return result;
+}
