+base::uxr_surface_v1::OriginalFontCoverage UxrOriginalFontCoverage(
+    const std::string& target, const std::string& host) {
+  // UxrConfig and the selected platform are immutable after process startup.
+  // Match the original's one-time native inventory sample, not a CSS probe or
+  // another FontCache lookup that could recurse through this policy.
+  static const auto coverage = [&] {
+    const auto manager = skia::DefaultFontMgr();
+    return base::uxr_surface_v1::OriginalFontCoverageFor(
+        target, host, [&](std::string_view name) -> std::string {
+          if (!manager) return {};
+          const std::string family(name);
+          const auto face = manager->matchFamilyStyle(family.c_str(), SkFontStyle());
+          if (!face) return {};
+          SkString actual;
+          face->getFamilyName(&actual);
+          return std::string(actual.c_str(), actual.size());
+        });
+  }();
+  return coverage;
+}
 
