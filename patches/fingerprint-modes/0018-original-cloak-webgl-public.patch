+
+std::optional<bool> UxrOriginalWebGLExtensionDecisionV2(
+    std::string_view platform, bool webgl2, std::string_view name) {
+  if (platform == "windows") {
+    if (webgl2)
+      return std::find(std::begin(kWindowsWebGL2ExtensionsV2),
+                       std::end(kWindowsWebGL2ExtensionsV2), name) !=
+             std::end(kWindowsWebGL2ExtensionsV2);
+    return std::find(std::begin(kWindowsWebGL1ExtensionsV2),
+                     std::end(kWindowsWebGL1ExtensionsV2), name) !=
+           std::end(kWindowsWebGL1ExtensionsV2);
+  }
+  if (platform == "macos") {
+    for (std::string_view added : {"WEBGL_compressed_texture_astc",
+                                  "WEBGL_compressed_texture_etc",
+                                  "WEBGL_compressed_texture_etc1",
+                                  "WEBGL_compressed_texture_pvrtc",
+                                  "WEBGL_render_shared_exponent"})
+      if (name == added) return true;
+    if (name == "OVR_multiview2") return false;
+    return std::nullopt;
+  }
+  for (std::string_view denied : {"WEBGL_compressed_texture_astc",
+                                 "WEBGL_compressed_texture_etc",
+                                 "WEBGL_compressed_texture_etc1"})
+    if (name == denied) return false;
+  return std::nullopt;
+}
+
+std::optional<UxrOriginalWebGLProfileV2> UxrSelectOriginalWebGLProfileV2(
+    uint64_t seed, std::string_view platform, std::string_view family_hint,
+    int requested_index, std::optional<std::string_view> explicit_vendor,
+    std::optional<std::string_view> explicit_renderer) {
+  if (!seed || requested_index < -1 ||
+      (platform != "windows" && platform != "macos" && platform != "linux"))
+    return std::nullopt;
+  // The observed full ANGLE prefix returns the original caller string. The
+  // short-name rewriting parser is deliberately outside this contract.
+  if (explicit_renderer && !explicit_renderer->starts_with("ANGLE ("))
+    return std::nullopt;
+  const std::string seed_text = std::to_string(seed);
+  const uint32_t vendor_hash = UxrCloakHashV1(seed_text + "gpu_vendor");
+  const uint32_t renderer_hash = UxrCloakHashV1(seed_text + "gpu_renderer");
+  const auto family = UxrCloakReferenceFamilyFor(
+      platform == "macos", vendor_hash, explicit_renderer.value_or(""),
+      explicit_vendor.value_or(family_hint));
+  std::string family_name = platform == "macos" ? "apple" :
+      platform == "linux" ? "nvidia" :
+      family == UxrCloakReferenceFamily::kIntel ? "intel" : "nvidia";
+  int index = requested_index;
+  if (index < 0 && family_name != "apple")
+    index = renderer_hash % (family_name == "intel" ? 18u : 41u);
+  // Explicit index avoids the hardware/WebGPU NVIDIA 0/2 redirect. This is a
+  // separate WebGL consumer; the compatible-v1 selector remains untouched.
+  auto choice = UxrSelectCloakHardwareV1(
+      seed, platform == "macos" ? "macos" : "windows", family_name, index);
+  if (!choice)
+    return std::nullopt;
+  UxrOriginalWebGLProfileV2 out;
+  out.platform = platform;
+  out.family = choice->family;
+  out.index = choice->index;
+  out.vendor = explicit_vendor ? std::string(*explicit_vendor) :
+      platform == "linux" ? "Google Inc. (NVIDIA Corporation)" :
+      choice->webgl_vendor;
+  out.renderer = explicit_renderer ? std::string(*explicit_renderer) :
+      platform == "linux" ? "ANGLE (NVIDIA Corporation, NVIDIA " +
+          choice->model + "/PCIe/SSE2, OpenGL ES 3.2)" : choice->webgl_renderer;
+  if (explicit_renderer) {
+    // Only a recognized catalog ANGLE string supplies a profile architecture.
+    // Identity may still pass through another full ANGLE string; admission of
+    // original capabilities separately requires a recognized architecture.
+    out.index = -1;
+    const int count = out.family == "apple" ? 20 :
+                      out.family == "intel" ? 18 : 41;
+    for (int candidate = 0; candidate < count; ++candidate) {
+      const auto known = UxrSelectCloakHardwareV1(
+          seed, platform == "macos" ? "macos" : "windows",
+          out.family, candidate);
+      const std::string name = platform == "linux"
+          ? "ANGLE (NVIDIA Corporation, NVIDIA " + known->model +
+                "/PCIe/SSE2, OpenGL ES 3.2)"
+          : known->webgl_renderer;
+      // Model recognition is ASCII-insensitive, while the presented renderer
+      // is retained exactly. Public M5/NVIDIA substring consumers below are
+      // deliberately case-sensitive and may therefore select different values.
+      const auto ascii_equal = [](unsigned char a, unsigned char b) {
+        const auto lower = [](unsigned char c) {
+          return c >= 'A' && c <= 'Z' ? c + ('a' - 'A') : c;
+        };
+        return lower(a) == lower(b);
+      };
+      if (std::equal(name.begin(), name.end(), explicit_renderer->begin(),
+                     explicit_renderer->end(), ascii_equal)) {
+        out.index = candidate;
+        break;
+      }
+    }
+  }
+  if (const auto profile = UxrFindGpuProfileV1(out.family, out.index))
+    out.architecture = profile->architecture;
+  return out;
+}
+
+std::optional<UxrOriginalWebGLQueryV2> UxrOriginalWebGLScalarQueryV2(
+    uint32_t pname, bool webgl2, const UxrOriginalWebGLProfileV2& profile) {
+  const bool mac = profile.platform == "macos";
+  const bool nvidia = profile.renderer.find("NVIDIA") != std::string::npos;
+  const auto integer = [](int64_t value) {
+    return UxrOriginalWebGLQueryV2{UxrOriginalWebGLQueryTypeV2::kInteger, value};
+  };
+  const auto integer64 = [](int64_t value) {
+    return UxrOriginalWebGLQueryV2{UxrOriginalWebGLQueryTypeV2::kInteger64, value};
+  };
+  switch (pname) {
+    case 0x8dfb: return integer(mac ? 1024 : nvidia ? 4095 : 4096);
+    case 0x8dfc: return integer(30);
+    case 0x8dfd: return integer(1024);
+    case 0x8872:
+    case 0x8b4c: return integer(16);
+    case 0x8b4d: return integer(32);
+    default: break;
+  }
+  if (!webgl2)
+    return std::nullopt;
+  switch (pname) {
+    case 0x8a2b:  // MAX_VERTEX_UNIFORM_BLOCKS
+    case 0x8a2d: return integer(mac ? 16 : 12);
+    case 0x8a2e:  // MAX_COMBINED_UNIFORM_BLOCKS
+    case 0x8a2f: return integer(mac ? 32 : 24);
+    case 0x8a30: return integer64(mac ? 16384 : 65536);
+    case 0x8a31: return integer64(mac ? 69632 : nvidia ? 212988 : 212992);
+    case 0x8a33: return integer64(mac ? 69632 : 200704);
+    case 0x8a34: return integer(mac ? 16 : 256);
+    case 0x8b49: return integer(4096);
+    case 0x8b4a: return integer(mac ? 4096 : nvidia ? 16380 : 16384);
+    case 0x8b4b: return integer(120);
+    case 0x8c8a: return integer(mac ? 128 : 120);
+    case 0x8cdf: return integer(8);
+    case 0x8d57:
+      return integer(mac ? (profile.renderer.find("M5") != std::string::npos ? 8 : 4)
+                         : (profile.platform == "windows" &&
+                                    profile.architecture == "gen-9" ? 16 : 8));
+    case 0x8d6b: return integer64(4294967294LL);
+    case 0x9111: return integer64(0);
+    case 0x9122:
+    case 0x9125: return integer(120);
+    case 0x80e8:
+    case 0x80e9: return integer(2147483647);
+    case 0x8904: return integer(-8);
+    case 0x8905: return integer(7);
+    case 0x84fd:
+      return UxrOriginalWebGLQueryV2{UxrOriginalWebGLQueryTypeV2::kFloat,
+                                    mac ? 15 : 2};
+    case 0x8824: return integer(8);
+    default: return std::nullopt;
+  }
+}
+
+}  // namespace base
