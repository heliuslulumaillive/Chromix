@@ -0,0 +1,117 @@
+// Copyright 2026. Independently reconstructed from bounded original evidence.
+#ifndef BASE_UXR_ORIGINAL_WEBGL_H_
+#define BASE_UXR_ORIGINAL_WEBGL_H_
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/base_export.h"
+
+namespace base {
+
+struct UxrOriginalWebGLProfileV2 {
+  std::string platform;
+  std::string vendor;
+  std::string renderer;
+  std::string family;
+  int index = -1;
+  std::string architecture;
+};
+
+// Seed text is deliberately canonical at admission. These routines do not
+// rewrite existing compatible-v1 hardware, CPU, RAM or WebGPU selections.
+BASE_EXPORT std::optional<UxrOriginalWebGLProfileV2>
+UxrSelectOriginalWebGLProfileV2(
+    uint64_t seed, std::string_view platform, std::string_view family_hint,
+    int requested_index, std::optional<std::string_view> explicit_vendor,
+    std::optional<std::string_view> explicit_renderer);
+
+struct UxrOriginalWebGLContextLimitsV2 {
+  int texture_size;
+  int renderbuffer_size;
+  std::array<int, 2> viewport;
+  int texture_levels;
+};
+
+inline UxrOriginalWebGLContextLimitsV2 UxrOriginalWebGLContextLimitsForV2(
+    std::string_view platform, std::string_view renderer) {
+  if (platform == "windows")
+    return {16384, 16384, {32767, 32767}, 15};
+  if (platform == "macos")
+    return {16384, 16384, {16384, 16384}, 15};
+  const bool large = renderer.find("NVIDIA") != std::string_view::npos ||
+                     renderer.find("AMD") != std::string_view::npos ||
+                     renderer.find("Radeon") != std::string_view::npos;
+  const int size = large ? 32768 : 16384;
+  return {size, size, {32767, 32767}, large ? 16 : 15};
+}
+
+// Both original query branches validate shader/type and lost-context before
+// reaching this selector. HIGH_FLOAT/HIGH_INT stay real ContextGL queries.
+inline std::optional<std::array<int, 3>> UxrOriginalWebGLPrecisionV2(
+    uint32_t precision) {
+  switch (precision) {
+    case 0x8df0:  // LOW_FLOAT
+    case 0x8df1:  // MEDIUM_FLOAT
+      return std::array<int, 3>{127, 127, 23};
+    case 0x8df3:  // LOW_INT
+    case 0x8df4:  // MEDIUM_INT
+      return std::array<int, 3>{31, 30, 0};
+    default:
+      return std::nullopt;
+  }
+}
+
+// Engaged decisions precede native Supported/draft/developer/disabled checks,
+// as in the original shared enumeration/object helper. nullopt keeps those
+// real checks. This never adds ANGLE decoder or shader capabilities.
+BASE_EXPORT std::optional<bool> UxrOriginalWebGLExtensionDecisionV2(
+    std::string_view platform, bool webgl2, std::string_view name);
+
+enum class UxrOriginalWebGLQueryTypeV2 { kInteger, kInteger64, kFloat };
+struct UxrOriginalWebGLQueryV2 {
+  UxrOriginalWebGLQueryTypeV2 type;
+  int64_t value;
+};
+BASE_EXPORT std::optional<UxrOriginalWebGLQueryV2>
+UxrOriginalWebGLScalarQueryV2(uint32_t pname, bool webgl2,
+                            const UxrOriginalWebGLProfileV2& profile);
+
+// Do not reuse one clamp for every API. The recovered compressed upload path
+// has no advertised-upper-bound condition; texture-storage does.
+inline int UxrOriginalWebGLUploadDimensionV2(int requested, int native_size,
+                                            int advertised_size) {
+  return native_size > 0 && native_size < advertised_size &&
+                 requested >= native_size
+             ? native_size
+             : requested;
+}
+inline int UxrOriginalWebGLStorageDimensionV2(int requested, int native_size,
+                                             int advertised_size) {
+  return requested <= advertised_size && requested >= native_size
+             ? native_size
+             : requested;
+}
+inline bool UxrOriginalWebGLReportRequestedDimensionV2(
+    int requested, int native_size, int advertised_renderbuffer_size) {
+  return native_size < requested &&
+         requested <= advertised_renderbuffer_size;
+}
+
+struct UxrOriginalWebGLSamplePlanV2 {
+  int driver_samples;
+  int reported_override;
+};
+inline UxrOriginalWebGLSamplePlanV2 UxrOriginalWebGLSamplePlanForV2(
+    int requested, int advertised, int native_maximum) {
+  if (requested > 0 && requested <= advertised && native_maximum > 0 &&
+      requested > native_maximum)
+    return {native_maximum, requested};
+  return {requested, 0};
+}
