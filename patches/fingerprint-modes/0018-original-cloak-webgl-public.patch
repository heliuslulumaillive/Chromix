+// The production UxrConfig test peer and source-body harness both run these.
+void OriginalWebGLPublicPolicyChecks() {
+  const auto observe = [](const Config& input) {
+    return base::UxrConfigTestPeer::Observe(input);
+  };
+  const auto snapshot = [] {
+    return Input({{"uxr-surface-modes-version", "2"},
+                  {"uxr-original-webgl-platform", "windows"},
+                  {"uxr-original-webgl-seed", "12345"},
+                  {"uxr-original-webgl-vendor", "intel"},
+                  {"uxr-original-webgl-renderer", "ANGLE (Intel, test)"},
+                  {"uxr-original-webgl-family", "intel"},
+                  {"uxr-original-webgl-index", "5"},
+                  {"uxr-original-webgl-architecture", "gen-9"}});
+  };
+  for (const char* key : {"uxr-webgl-identity-mode",
+                          "uxr-webgl-capabilities-mode",
+                          "uxr-webgl-precision-mode",
+                          "uxr-webgl-extensions-mode"}) {
+    auto input = snapshot();
+    input[key] = "cloak-original";
+    Check(observe(input).accepted, "independent original GL public policy");
+    Check(observe(input).snapshot == input, "original GL policy does not mutate snapshot");
+    input["uxr-surface-modes-version"] = "1";
+    Check(!observe(input).accepted, "original GL public policy rejects version1");
+    input.erase("uxr-surface-modes-version");
+    Check(!observe(input).accepted, "original GL public policy requires version2");
+    input["uxr-surface-modes-version"] = "2";
+    input[std::string(key) + "-seed"] = "1";
+    Check(!observe(input).accepted, "original GL public policy rejects per-field seed");
+    input.erase(std::string(key) + "-seed");
+    input[std::string(key).substr(0, std::string(key).size() - 5) + "-amount"] = "0";
+    Check(!observe(input).accepted, "original GL public policy rejects amount");
+    auto off = Input({{"uxr-surface-modes-version", "2"},
+                      {"uxr-fingerprint-off", "true"}});
+    off[key] = "cloak-original";
+    Check(observe(off).accepted, "master off admits inert public policies without profile");
+  }
+  for (const char* key : {"uxr-webgl-identity-mode", "uxr-webgl-capabilities-mode"}) {
+    auto input = snapshot(); input[key] = "cloak-original";
+    for (const char* seed : {"", "0", "01", " 1", "+1", "-1", "1.0",
