+
+// Original Windows 155 TextMetrics reference consumer. noise=false does not
+// disable this table; raw does. Non-macOS personas use the Windows table.
+// Only the public metrics are replaced; this does not install or render fonts.
+inline const TextReferenceRow* FindOriginalCloakTextReference(
+    bool mac, std::string_view font, std::string_view text,
+    double native_width, bool raw) {
+  if (raw || (!text.empty() && !(native_width > 0)))
+    return nullptr;
+  if (mac && font == "13.7px -apple-system, \"system-ui\", \"Segoe UI\", Roboto, sans-serif")
+    font = "13.7px -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif";
+  const auto& rows = mac ? kMacTextReferences : kWindowsTextReferences;
+  for (const auto& row : rows) {
+    if (row.font == font && row.text == text)
+      return &row;
+  }
+  return nullptr;
+}
 }  // namespace base::uxr_surface_v1
 #endif  // BASE_UXR_SURFACE_REFERENCE_DATA_H_
