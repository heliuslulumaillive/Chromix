diff --git a/base/uxr_original_webgl_translated_goldens.cc b/base/uxr_original_webgl_translated_goldens.cc
new file mode 100644
--- /dev/null
+++ b/base/uxr_original_webgl_translated_goldens.cc
@@ -0,0 +1,34 @@
+// Native source checks of original public diagnostic strings only.
+#include <cstdio>
+#include <initializer_list>
+#include <iterator>
+#include "base/uxr_original_webgl_translated.h"
+#include "base/uxr_original_webgl_translated_test_vectors.h"
+
+int RunOriginalWebGLTranslatedGoldenTestsV2() {
+  unsigned checks = 0;
+  unsigned failures = 0;
+  static_assert(std::size(base::kUxrOriginalWebGLTranslatedVectorsV2) == 26);
+  for (const auto& row : base::kUxrOriginalWebGLTranslatedVectorsV2) {
+    ++checks;
+    const auto actual = base::UxrOriginalWebGLTranslatedShaderV2(
+        row.platform, row.vertex, row.source);
+    if (!actual || *actual != row.expected) {
+      ++failures;
+      std::fprintf(stderr, "Original translated diagnostic mismatch: %s\n", row.name);
+    }
+  }
+  for (const char* platform : {"linux", "unknown", ""}) {
+    for (bool vertex : {false, true}) {
+      ++checks;
+      if (base::UxrOriginalWebGLTranslatedShaderV2(
+              platform, vertex, "void main(){}").has_value()) {
+        ++failures;
+        std::fprintf(stderr, "Original translated native fallback mismatch\n");
+      }
+    }
+  }
+  std::printf("{\"original_webgl_translated_checks\":%u,\"failures\":%u}\n",
+              checks, failures);
+  return failures ? 1 : 0;
+}
