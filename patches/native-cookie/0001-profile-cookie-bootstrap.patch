+namespace shardx::cookie_import {
+namespace {
+constexpr char kEnvironment[] = "01234567-89ab-4cde-8123-456789abcdef";
+constexpr char kRequest[] = "fedcba98-7654-4321-8123-abcdef012345";
+
+Binding TestBinding() {
+  Binding binding;
+  binding.environment_id = kEnvironment;
+  binding.request_id = kRequest;
+  binding.token = std::string(64, 'a');
+  binding.user_data_dir = base::FilePath(FILE_PATH_LITERAL("C:\\owned"));
+  binding.envelope_path = binding.user_data_dir.Append(FILE_PATH_LITERAL("ShardX Cookie Imports"))
+      .Append(FILE_PATH_LITERAL("requests")).AppendASCII(binding.token + "." + kRequest + ".json");
+  binding.receipt_path = binding.user_data_dir.Append(FILE_PATH_LITERAL("ShardX Cookie Imports"))
+      .Append(FILE_PATH_LITERAL("receipts")).AppendASCII(binding.token + ".json");
+  return binding;
+}
+
+base::DictValue Cookie(std::string name = "fixture") {
+  base::DictValue cookie;
+  cookie.Set("name", name);
+  cookie.Set("value", "synthetic-cookie-value");
+  cookie.Set("url", "https://example.test:8443/account/page");
+  cookie.Set("sameSite", "Lax");
+  return cookie;
+}
+
+std::string Envelope(Binding* binding, base::ListValue cookies) {
+  base::DictValue value;
+  value.Set("schemaVersion", 1);
+  value.Set("contract", kContract);
+  value.Set("environmentId", binding->environment_id);
+  value.Set("requestId", binding->request_id);
+  value.Set("token", binding->token);
+  value.Set("profileDirectory", "Default");
+  value.Set("sourceSha256", std::string(64, 'b'));
+  value.Set("cookieCount", static_cast<int>(cookies.size()));
+  value.Set("deadlineUnixMs", static_cast<double>((base::Time::Now() + base::Seconds(60)).InMillisecondsSinceUnixEpoch()));
+  value.Set("cookies", std::move(cookies));
+  std::string bytes = base::WriteJson(value).value();
+  binding->envelope_sha256 = base::HexEncodeLower(crypto::hash::Sha256(bytes));
+  return bytes;
+}
+
+std::unique_ptr<Batch> ParseOne(base::DictValue cookie, Binding* binding,
+                                std::string* error) {
+  base::ListValue cookies;
+  cookies.Append(std::move(cookie));
+  const std::string bytes = Envelope(binding, std::move(cookies));
+  return ParseEnvelope(bytes, *binding, base::Time::Now(), error);
+}
+
+TEST(ShardXNativeCookieTest, BindingRequiresOwnedDefaultAndExactAttemptName) {
+  auto binding = TestBinding();
+  base::CommandLine command(base::FilePath(FILE_PATH_LITERAL("chrome.exe")));
+  command.AppendSwitchASCII("shardx-managed-environment", kEnvironment);
+  command.AppendSwitchASCII(kDigestFlag, std::string(64, 'c'));
+  command.AppendSwitchPath(kImportFlag, binding.envelope_path);
+  const auto profile = binding.user_data_dir.Append(FILE_PATH_LITERAL("Default"));
+  ASSERT_TRUE(ParseBinding(profile, command));
+  command.AppendSwitch("incognito");
+  EXPECT_FALSE(ParseBinding(profile, command));
+  command.RemoveSwitch("incognito");
+  EXPECT_FALSE(ParseBinding(binding.user_data_dir.Append(FILE_PATH_LITERAL("Profile 1")), command));
+  command.AppendSwitchPath(kImportFlag, base::FilePath(FILE_PATH_LITERAL("C:\\foreign\\request.json")));
+  EXPECT_FALSE(ParseBinding(profile, command));
+}
+
+TEST(ShardXNativeCookieTest, ExplicitPathSecureFalseAndSourceUrlArePreserved) {
+  auto binding = TestBinding();
+  auto cookie = Cookie();
+  cookie.Set("path", "/account");
+  cookie.Set("secure", false);
+  cookie.Set("priority", "High");
+  std::string error;
+  auto batch = ParseOne(std::move(cookie), &binding, &error);
+  ASSERT_TRUE(batch) << error;
+  ASSERT_EQ(batch->cookies.size(), 1u);
+  EXPECT_EQ(batch->cookies[0]->Path(), "/account");
+  EXPECT_FALSE(batch->cookies[0]->SecureAttribute());
+  EXPECT_EQ(batch->cookies[0]->Priority(), net::CookiePriority::COOKIE_PRIORITY_HIGH);
+  EXPECT_EQ(batch->cookies[0]->SourcePort(), 8443);
+  EXPECT_EQ(batch->source_urls[0], GURL("https://example.test:8443/account/page"));
+  auto defaults = ParseOne(Cookie(), &binding, &error);
+  ASSERT_TRUE(defaults);
+  EXPECT_EQ(defaults->cookies[0]->Path(), "/account");
+  EXPECT_FALSE(defaults->cookies[0]->SecureAttribute());
+}
+
+TEST(ShardXNativeCookieTest, SessionAndPersistentExpiryStayNative) {
+  auto binding = TestBinding();
+  std::string error;
+  auto session = ParseOne(Cookie(), &binding, &error);
+  ASSERT_TRUE(session);
+  EXPECT_FALSE(session->cookies[0]->IsPersistent());
+  auto sentinel = Cookie(); sentinel.Set("expires", -1);
+  auto sentinel_batch = ParseOne(std::move(sentinel), &binding, &error);
+  ASSERT_TRUE(sentinel_batch);
+  EXPECT_FALSE(sentinel_batch->cookies[0]->IsPersistent());
+  auto persistent = Cookie();
+  const double expiry = (base::Time::Now() + base::Hours(1)).InSecondsFSinceUnixEpoch();
+  persistent.Set("expires", expiry);
+  auto saved = ParseOne(std::move(persistent), &binding, &error);
+  ASSERT_TRUE(saved);
+  EXPECT_TRUE(saved->cookies[0]->IsPersistent());
+  EXPECT_EQ(saved->cookies[0]->ExpiryDate(), base::Time::FromSecondsSinceUnixEpoch(expiry));
+  auto invalid = Cookie(); invalid.Set("expires", -2);
+  EXPECT_FALSE(ParseOne(std::move(invalid), &binding, &error));
+}
+
+TEST(ShardXNativeCookieTest, UnspecifiedSameSiteRemainsAnUnspecifiedAttribute) {
+  auto binding = TestBinding(); std::string error;
+  auto omitted = Cookie(); omitted.Remove("sameSite");
+  auto batch = ParseOne(std::move(omitted), &binding, &error); ASSERT_TRUE(batch);
+  EXPECT_EQ(batch->cookies[0]->SameSite(), net::CookieSameSite::UNSPECIFIED);
+  auto explicit_value = Cookie(); explicit_value.Set("sameSite", "Unspecified");
+  batch = ParseOne(std::move(explicit_value), &binding, &error); ASSERT_TRUE(batch);
+  EXPECT_EQ(batch->cookies[0]->SameSite(), net::CookieSameSite::UNSPECIFIED);
+}
+
+TEST(ShardXNativeCookieTest, DomainAndHostOnlyKeysAreNotCollapsed) {
+  auto binding = TestBinding();
+  auto host = Cookie(); host.Set("path", "/");
+  auto domain = Cookie(); domain.Remove("url"); domain.Set("domain", "example.test"); domain.Set("path", "/");
+  base::ListValue cookies; cookies.Append(std::move(host)); cookies.Append(std::move(domain));
+  auto bytes = Envelope(&binding, std::move(cookies));
+  std::string error;
+  auto batch = ParseEnvelope(bytes, binding, base::Time::Now(), &error);
+  ASSERT_TRUE(batch) << error;
+  ASSERT_EQ(batch->cookies.size(), 2u);
+  EXPECT_EQ(batch->cookies[0]->Domain(), "example.test");
+  EXPECT_EQ(batch->cookies[1]->Domain(), ".example.test");
+  EXPECT_NE(batch->cookies[0]->UniqueKey(), batch->cookies[1]->UniqueKey());
+}
+
+TEST(ShardXNativeCookieTest, ConflictingDuplicatesAndUnsupportedSemanticsFailPreflight) {
+  auto binding = TestBinding();
+  base::ListValue identical; identical.Append(Cookie()); identical.Append(Cookie());
+  auto bytes = Envelope(&binding, std::move(identical));
+  std::string error;
+  auto batch = ParseEnvelope(bytes, binding, base::Time::Now(), &error);
+  ASSERT_TRUE(batch); EXPECT_EQ(batch->cookie_count, 2u); EXPECT_EQ(batch->cookies.size(), 1u);
+  EXPECT_EQ(batch->duplicate_count, 1u);
+  auto conflict = Cookie(); conflict.Set("value", "different-synthetic-value");
+  base::ListValue different; different.Append(Cookie()); different.Append(std::move(conflict));
+  bytes = Envelope(&binding, std::move(different));
+  EXPECT_FALSE(ParseEnvelope(bytes, binding, base::Time::Now(), &error));
+  EXPECT_EQ(error, "conflicting_cookie_key");
+  for (const char* key : {"partitionKey", "sameParty", "sourcePort"}) {
+    auto unsupported = Cookie(); unsupported.Set(key, true);
+    EXPECT_FALSE(ParseOne(std::move(unsupported), &binding, &error));
+  }
+}
+
+TEST(ShardXNativeCookieTest, AllInputValidationPrecedesAnyMutation) {
+  auto binding = TestBinding();
+  base::ListValue cookies; cookies.Append(Cookie()); cookies.Append(base::Value(false));
+  auto bytes = Envelope(&binding, std::move(cookies));
+  std::string error;
+  EXPECT_FALSE(ParseEnvelope(bytes, binding, base::Time::Now(), &error));
+  bytes = Envelope(&binding, base::ListValue());
+  bytes.push_back(' ');
+  EXPECT_FALSE(ParseEnvelope(bytes, binding, base::Time::Now(), &error));
+  EXPECT_EQ(error, "envelope_digest_mismatch");
+  std::string oversized(kMaxEnvelopeBytes + 1, ' ');
+  EXPECT_FALSE(ParseEnvelope(oversized, binding, base::Time::Now(), &error));
+}
+
+TEST(ShardXNativeCookieTest, ReadbackChecksValuesAttributesAndEviction) {
+  auto binding = TestBinding(); std::string error;
+  auto batch = ParseOne(Cookie(), &binding, &error); ASSERT_TRUE(batch);
+  Counts counts; counts.accepted = counts.attempted = 1;
+  net::CookieList actual; actual.push_back(*batch->cookies[0]);
+  EXPECT_TRUE(VerifyReadback(*batch, actual, base::Time::Now(), &counts));
+  EXPECT_EQ(counts.verified, 1u);
+  EXPECT_FALSE(VerifyReadback(*batch, {}, base::Time::Now(), &counts));
+  auto changed = Cookie(); changed.Set("httpOnly", true);
+  auto other = ParseOne(std::move(changed), &binding, &error); ASSERT_TRUE(other);
+  actual.clear(); actual.push_back(*other->cookies[0]);
+  EXPECT_FALSE(VerifyReadback(*batch, actual, base::Time::Now(), &counts));
+}
+
+TEST(ShardXNativeCookieTest, ExpiredDeletionMustActuallyBeAbsent) {
+  auto binding = TestBinding(); std::string error;
+  auto expired = Cookie(); expired.Set("expires", 0);
+  auto batch = ParseOne(std::move(expired), &binding, &error); ASSERT_TRUE(batch);
+  EXPECT_EQ(batch->cookies[0]->ExpiryDate(), base::Time::UnixEpoch());
+  Counts counts; counts.accepted = counts.attempted = 1;
+  EXPECT_TRUE(VerifyReadback(*batch, {}, base::Time::Now(), &counts));
+  EXPECT_EQ(counts.expired, 1u);
+  net::CookieList still_present; still_present.push_back(*batch->cookies[0]);
+  EXPECT_FALSE(VerifyReadback(*batch, still_present, base::Time::Now(), &counts));
+}
