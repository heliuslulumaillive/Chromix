+                    base::Time now,
+                    Counts* counts);
+bool IsCompletedReceipt(const base::DictValue& receipt,
+                        const Binding& binding,
+                        const Batch* batch,
+                        bool require_same_request);
+Prepared ReadAndPrepare(const Binding& binding);
+base::DictValue MakeReceipt(const Binding& binding,
