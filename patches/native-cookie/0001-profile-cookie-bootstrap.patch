+TEST(ShardXNativeCookieTest, CompletionLedgerSupportsRecreatedProfileWithoutEnvelope) {
+  base::ScopedTempDir directory; ASSERT_TRUE(directory.CreateUniqueTempDir());
+  auto binding = TestBinding(); binding.user_data_dir = directory.GetPath();
+  const auto imports = directory.GetPath().Append(FILE_PATH_LITERAL("ShardX Cookie Imports"));
+  ASSERT_TRUE(base::CreateDirectory(imports));
+  binding.receipt_path = imports.Append(FILE_PATH_LITERAL("receipts")).AppendASCII(binding.token + ".json");
+  binding.envelope_path = imports.Append(FILE_PATH_LITERAL("requests")).AppendASCII(binding.token + "." + kRequest + ".json");
+  std::string error; auto batch = ParseOne(Cookie(), &binding, &error); ASSERT_TRUE(batch);
+  Counts counts; counts.accepted = counts.attempted = counts.verified = 1;
+  const auto receipt = MakeReceipt(binding, batch.get(), counts, true, "");
+  for (std::string_view flag : {"writeOutcomeUnknown", "rollbackPerformed"}) {
+    auto contradictory = receipt.Clone();
+    contradictory.Set(flag, true);
+    EXPECT_FALSE(IsCompletedReceipt(contradictory, binding, batch.get(), true));
+  }
+  auto incomplete = receipt.Clone();
+  incomplete.Set("attemptedCookieCount", 0);
+  EXPECT_FALSE(IsCompletedReceipt(incomplete, binding, batch.get(), true));
+  ASSERT_TRUE(PublishReceipt(binding, receipt));
+  ASSERT_FALSE(base::PathExists(binding.envelope_path));
+  EXPECT_TRUE(ReadAndPrepare(binding).previous_completion);
+  EXPECT_FALSE(PublishReceipt(binding, MakeReceipt(binding, batch.get(), counts, false, "cancelled")));
+  EXPECT_TRUE(ReadAndPrepare(binding).previous_completion);
+  Counts uncertain; uncertain.attempted = 1; uncertain.in_flight = true;
+  const auto failure = MakeReceipt(binding, batch.get(), uncertain, false, "cookie_manager_disconnected");
+  EXPECT_EQ(failure.FindBool("writeOutcomeUnknown"), true);
+  EXPECT_EQ(failure.FindBool("rollbackPerformed"), false);
+  EXPECT_EQ(failure.FindString("status") ? *failure.FindString("status") : "", "failed");
+}
