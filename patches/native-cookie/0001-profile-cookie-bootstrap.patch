+                            const Counts& counts,
+                            bool completed,
+                            std::string_view error);
+// Runs only on the sequenced file runner. Never replaces a valid completion
+// with failure; returns false if no receipt could be published.
+bool PublishReceipt(const Binding& binding, const base::DictValue& receipt);
