+namespace shardx::cookie_import {
+namespace {
+enum class State { kPending, kApplying, kFlushing, kVerifying, kPublishing,
+                   kCompleted, kFailed };
+
+bool TargetProfile(Profile* profile) {
+  return profile && profile->IsRegularProfile() && !profile->IsOffTheRecord() &&
+      !profile->IsGuestSession() &&
+      profile->GetPath().BaseName() == base::FilePath(FILE_PATH_LITERAL("Default"));
+}
+
+class ImportService final : public KeyedService {
+ public:
+  explicit ImportService(Profile* profile) : profile_(profile) {
+    // Establish process ownership synchronously: --no-startup-window must not
+    // exit between eager service creation and the posted import task.
+    if (!KeepAliveRegistry::GetInstance()->IsShuttingDown()) {
+      browser_keepalive_ = std::make_unique<ScopedKeepAlive>(
+          KeepAliveOrigin::SHARDX_COOKIE_IMPORT, KeepAliveRestartOption::DISABLED);
+    }
+    // Eager factory creation establishes kPending before startup/restore tabs
+    // can navigate. Start is independent of any navigation or DevTools target.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&ImportService::Start, weak_factory_.GetWeakPtr()));
+  }
+  ~ImportService() override = default;
+
+  State state() const { return state_; }
+  base::WeakPtr<ImportService> GetWeakPtr() { return weak_factory_.GetWeakPtr(); }
+  base::CallbackListSubscription Observe(base::RepeatingCallback<void(bool)> callback) {
+    return observers_.Add(std::move(callback));
+  }
+
+  void Shutdown() override {
+    shutting_down_ = true;
+    timer_.Stop();
+    weak_factory_.InvalidateWeakPtrs();
+    manager_.reset();
+    if (state_ != State::kCompleted && state_ != State::kFailed) {
+      state_ = State::kFailed;
+      observers_.Notify(false);
+      // Do not race an already publishing terminal receipt. Otherwise this
+      // is a best-effort cancellation receipt; the launcher also detects exit.
+      if (binding_ && !publishing_) {
+        file_runner_->PostTask(FROM_HERE, base::BindOnce(
+            [](Binding binding, base::DictValue receipt) {
+              PublishReceipt(binding, receipt);
+            }, *binding_, MakeReceipt(*binding_, batch_.get(), counts_, false, "cancelled")));
+      }
+    }
+    ReleaseKeepalives();
+  }
+
+ private:
+  void Start() {
+    if (shutting_down_ || !TargetProfile(profile_))
+      return;
+    if (KeepAliveRegistry::GetInstance()->IsShuttingDown()) {
+      Finish(false);
+      return;
+    }
+    binding_ = ParseBinding(profile_->GetPath(), *base::CommandLine::ForCurrentProcess());
+    if (!binding_) {
+      Finish(false);
+      return;
+    }
+    profile_keepalive_ = ScopedProfileKeepAlive::TryAcquire(
+        profile_, ProfileKeepAliveOrigin::kShardXCookieImport);
+    if (!profile_keepalive_) {
+      Finish(false);
+      return;
+    }
+    if (KeepAliveRegistry::GetInstance()->IsShuttingDown()) {
+      Finish(false);
+      return;
+    }
+    timer_.Start(FROM_HERE, base::Seconds(60),
+                 base::BindOnce(&ImportService::OnTimeout, weak_factory_.GetWeakPtr()));
+    file_runner_->PostTaskAndReplyWithResult(
+        FROM_HERE, base::BindOnce(&ReadAndPrepare, *binding_),
+        base::BindOnce(&ImportService::OnPrepared, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnPrepared(Prepared prepared) {
+    if (state_ != State::kPending)
+      return;
+    if (prepared.previous_completion) {
+      Finish(true);
+      return;
+    }
+    batch_ = std::move(prepared.batch);
+    if (!batch_) {
+      Fail(prepared.error);
+      return;
+    }
+    const base::TimeDelta remaining = batch_->deadline - base::Time::Now();
+    if (remaining <= base::TimeDelta()) {
+      Fail("timeout");
+      return;
+    }
+    timer_.Start(FROM_HERE, std::min(remaining, base::Seconds(60)),
+        base::BindOnce(&ImportService::OnTimeout, weak_factory_.GetWeakPtr()));
+    profile_->GetDefaultStoragePartition()->GetCookieManagerForBrowserProcess()->CloneInterface(
+        manager_.BindNewPipeAndPassReceiver());
+    manager_.set_disconnect_handler(base::BindOnce(
+        &ImportService::Fail, weak_factory_.GetWeakPtr(), "cookie_manager_disconnected"));
+    state_ = State::kApplying;
+    SetNext();
+  }
+
+  void SetNext() {
+    if (state_ != State::kApplying)
+      return;
+    if (base::Time::Now() >= batch_->deadline) {
+      Fail("timeout");
+      return;
+    }
+    if (counts_.accepted == batch_->cookies.size()) {
+      state_ = State::kFlushing;
+      manager_->FlushCookieStore(base::BindOnce(
+          &ImportService::OnFlushed, weak_factory_.GetWeakPtr()));
+      return;
+    }
+    const auto& cookie = *batch_->cookies.at(counts_.accepted);
+    net::CookieOptions options;
+    options.set_include_httponly();
+    options.set_same_site_cookie_context(net::CookieOptions::SameSiteCookieContext::MakeInclusive());
+    ++counts_.attempted;
+    counts_.in_flight = true;
+    manager_->SetCanonicalCookie(cookie,
+        batch_->source_urls.at(counts_.accepted), options,
+        base::BindOnce(&ImportService::OnSet, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnSet(net::CookieAccessResult result) {
+    if (state_ != State::kApplying)
+      return;
+    counts_.in_flight = false;
+    if (!result.status.IsInclude()) {
+      Fail("cookie_set_rejected");
+      return;
+    }
+    ++counts_.accepted;
+    SetNext();
+  }
+
+  void OnFlushed() {
+    if (state_ != State::kFlushing)
+      return;
+    state_ = State::kVerifying;
+    manager_->GetAllCookies(base::BindOnce(
+        &ImportService::OnReadback, weak_factory_.GetWeakPtr()));
+  }
+
+  void OnReadback(const net::CookieList& cookies) {
+    if (state_ != State::kVerifying)
+      return;
+    if (!VerifyReadback(*batch_, cookies, base::Time::Now(), &counts_)) {
+      Fail("readback_mismatch");
+      return;
+    }
+    if (base::Time::Now() >= batch_->deadline) {
+      Fail("timeout");
+      return;
+    }
+    manager_.reset();
+    state_ = State::kPublishing;
+    publishing_ = true;
+    file_runner_->PostTaskAndReplyWithResult(
+        FROM_HERE, base::BindOnce(&PublishReceipt, *binding_,
+            MakeReceipt(*binding_, batch_.get(), counts_, true, "")),
+        base::BindOnce(&ImportService::OnPublished, weak_factory_.GetWeakPtr(), true));
+  }
+
+  void Fail(std::string error) {
+    if (state_ == State::kCompleted || state_ == State::kFailed || publishing_)
+      return;
+    state_ = State::kFailed;
+    manager_.reset();
+    observers_.Notify(false);
+    if (!binding_) {
+      ReleaseKeepalives();
+      return;
+    }
+    publishing_ = true;
+    file_runner_->PostTaskAndReplyWithResult(
+        FROM_HERE, base::BindOnce(&PublishReceipt, *binding_,
+            MakeReceipt(*binding_, batch_.get(), counts_, false, error)),
+        base::BindOnce(&ImportService::OnPublished, weak_factory_.GetWeakPtr(), false));
+    // A timeout itself has exhausted the import deadline; allow only a small
+    // bounded opportunity to publish its failure before dropping keepalives.
+    if (!timer_.IsRunning()) {
+      timer_.Start(FROM_HERE, base::Seconds(2),
+          base::BindOnce(&ImportService::ReleaseKeepalives, weak_factory_.GetWeakPtr()));
+    }
+  }
+
+  void OnPublished(bool success, bool written) {
+    publishing_ = false;
+    if (success && state_ == State::kFailed)
+      return;  // A late receipt cannot revive a timed-out/cancelled launch.
+    if (success && batch_ && base::Time::Now() >= batch_->deadline) {
+      Finish(false);
+      return;
+    }
+    Finish(success && written);
+  }
+
+  void OnTimeout() {
+    if (publishing_) {
+      // Do not race the publication with a contradictory receipt. Its eventual
+      // completed ledger may recover the operation on a later launch, but this
+      // attempt is terminally failed and no waiting navigation may resume.
+      Finish(false);
+      return;
+    }
+    Fail("timeout");
+  }
+
+  void ReleaseKeepalives() {
+    auto profile = std::move(profile_keepalive_);
+    auto browser = std::move(browser_keepalive_);
+  }
+
+  void Finish(bool success) {
+    timer_.Stop();
+    state_ = success ? State::kCompleted : State::kFailed;
+    manager_.reset();
+    batch_.reset();
+    // Keep local ownership across notifications, which can destroy a deferred
+    // navigation/window. No member is accessed after releasing these locals.
+    auto profile = std::move(profile_keepalive_);
+    auto browser = std::move(browser_keepalive_);
+    observers_.Notify(success);
+  }
+
+  raw_ptr<Profile> profile_;
+  State state_ = State::kPending;
+  bool shutting_down_ = false;
+  bool publishing_ = false;
+  std::optional<Binding> binding_;
+  std::unique_ptr<Batch> batch_;
+  Counts counts_;
+  scoped_refptr<base::SequencedTaskRunner> file_runner_ =
+      base::ThreadPool::CreateSequencedTaskRunner({base::MayBlock(),
+          base::TaskPriority::USER_BLOCKING, base::TaskShutdownBehavior::CONTINUE_ON_SHUTDOWN});
+  mojo::Remote<network::mojom::CookieManager> manager_;
+  base::OneShotTimer timer_;
+  std::unique_ptr<ScopedProfileKeepAlive> profile_keepalive_;
+  std::unique_ptr<ScopedKeepAlive> browser_keepalive_;
+  base::RepeatingCallbackList<void(bool)> observers_;
+  base::WeakPtrFactory<ImportService> weak_factory_{this};
+};
+
+class ImportFactory final : public ProfileKeyedServiceFactory {
+ public:
+  static ImportFactory* GetInstance() {
+    static base::NoDestructor<ImportFactory> instance;
+    return instance.get();
+  }
+  static ImportService* Get(Profile* profile) {
+    return static_cast<ImportService*>(GetInstance()->GetServiceForBrowserContext(profile, true));
+  }
+ private:
+  friend class base::NoDestructor<ImportFactory>;
+  ImportFactory() : ProfileKeyedServiceFactory("ShardXCookieBootstrap",
+      ProfileSelections::Builder().WithRegular(ProfileSelection::kOriginalOnly)
+          .WithGuest(ProfileSelection::kNone).WithSystem(ProfileSelection::kNone)
+          .WithAshInternals(ProfileSelection::kNone).Build()) {}
+  std::unique_ptr<KeyedService> BuildServiceInstanceForBrowserContext(
+      content::BrowserContext* context) const override {
+    auto* profile = Profile::FromBrowserContext(context);
+    if (!TargetProfile(profile) || !HasRequest(*base::CommandLine::ForCurrentProcess()))
+      return nullptr;
+    return std::make_unique<ImportService>(profile);
+  }
+  bool ServiceIsCreatedWithBrowserContext() const override { return true; }
+  bool ServiceIsNULLWhileTesting() const override { return true; }
+};
+
+class ImportThrottle final : public content::NavigationThrottle {
+ public:
+  ImportThrottle(content::NavigationThrottleRegistry& registry, ImportService* service)
+      : content::NavigationThrottle(registry), service_(service->GetWeakPtr()) {}
+  ThrottleCheckResult WillStartRequest() override {
+    if (!service_)
+      return {CANCEL, net::ERR_BLOCKED_BY_CLIENT};
+    if (service_->state() == State::kCompleted)
+      return PROCEED;
+    if (service_->state() == State::kFailed)
+      return {CANCEL, net::ERR_BLOCKED_BY_CLIENT};
+    waiting_ = true;
+    // Notifications never synchronously destroy a navigation/profile from
+    // inside the service's CallbackList::Notify() stack.
+    subscription_ = service_->Observe(base::BindPostTask(base::SingleThreadTaskRunner::GetCurrentDefault(),
+        base::BindRepeating(&ImportThrottle::OnComplete, weak_factory_.GetWeakPtr())));
+    return DEFER;
+  }
+  const char* GetNameForLogging() override { return "ShardXCookieBootstrap"; }
+ private:
+  void OnComplete(bool success) {
+    if (!waiting_)
+      return;
+    waiting_ = false;
+    subscription_ = {};
+    if (success) Resume();
+    else CancelDeferredNavigation({CANCEL, net::ERR_BLOCKED_BY_CLIENT});
+  }
+  base::WeakPtr<ImportService> service_;
+  bool waiting_ = false;
+  base::CallbackListSubscription subscription_;
+  base::WeakPtrFactory<ImportThrottle> weak_factory_{this};
+};
+}  // namespace
+
+void EnsureFactoryBuilt() { ImportFactory::GetInstance(); }
+
+void MaybeCreateThrottle(content::NavigationThrottleRegistry& registry) {
+  auto* profile = Profile::FromBrowserContext(
+      registry.GetNavigationHandle().GetWebContents()->GetBrowserContext());
+  if (!TargetProfile(profile) || !HasRequest(*base::CommandLine::ForCurrentProcess()))
+    return;
+  if (auto* service = ImportFactory::Get(profile))
+    registry.AddThrottle(std::make_unique<ImportThrottle>(registry, service));
+}
