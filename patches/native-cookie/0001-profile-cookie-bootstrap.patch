+struct Counts {
+  size_t attempted = 0;
+  size_t accepted = 0;
+  size_t verified = 0;
+  size_t expired = 0;
+  bool in_flight = false;
+};
+
+struct Prepared {
+  std::unique_ptr<Batch> batch;
+  bool previous_completion = false;
+  std::string error;
+};
