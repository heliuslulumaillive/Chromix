+bool UxrRtcFormatAllowed(const webrtc::SdpVideoFormat& format) {
+  const auto profile = WebRTCFormatToCodecProfile(format);
+  return !profile || media::IsUxrVideoCodecAllowed(
+                         media::VideoCodecProfileToVideoCodec(*profile));
+}
+
+std::vector<webrtc::SdpVideoFormat> FilterUxrRtcFormats(
+    std::vector<webrtc::SdpVideoFormat> formats) {
+  std::erase_if(formats, [](const webrtc::SdpVideoFormat& format) {
+    return !UxrRtcFormatAllowed(format);
+  });
+  return formats;
+}
