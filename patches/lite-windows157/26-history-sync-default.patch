+IN_PROC_BROWSER_TEST_P(HistorySyncOptinHelperLaunchContextParamBrowserTest,
+                       ShardXDefaultEnablesHistoryWithoutScreen) {
+  base::test::ScopedCommandLine command_line;
+  command_line.GetProcessCommandLine()->AppendSwitch(
+      "shardx-auto-enable-history-sync");
+  auto* settings = GetTestSyncService()->GetUserSettings();
+  settings->SetSelectedTypes(false, syncer::UserSelectableTypeSet());
+  AccountInfo account = MakeAccountInfoAvailableAndSignIn();
+  UpdateAccountManagementInfo(account, false);
+  testing::StrictMock<MockHistorySyncOptinHelperDelegate> delegate;
+  EXPECT_CALL(delegate, FinishFlowWithoutHistorySyncOptin()).Times(2);
+  base::test::TestFuture<void> finished;
+  HistorySyncOptinHelperTestObserver observer(finished);
+  auto helper = HistorySyncOptinHelper::Create(
+      identity_test_env()->identity_manager(), GetProfile(), account, &delegate,
+      GetParam(), signin_metrics::AccessPoint::kSettings);
+  helper->AddObserver(&observer);
+  helper->StartHistorySyncOptinFlow();
+  ASSERT_TRUE(finished.Wait());
+  helper->RemoveObserver(&observer);
+  EXPECT_TRUE(settings->GetSelectedTypes().HasAll(
+      {syncer::UserSelectableType::kHistory, syncer::UserSelectableType::kTabs,
+       syncer::UserSelectableType::kSavedTabGroups}));
+  EXPECT_EQ(0, user_action_tester_.GetActionCount("Signin_HistorySync_Started"));
+  // A subsequent flow sees real selected types and does not offer the screen.
+  helper = HistorySyncOptinHelper::Create(
+      identity_test_env()->identity_manager(), GetProfile(), account, &delegate,
+      GetParam(), signin_metrics::AccessPoint::kSettings);
+  helper->StartHistorySyncOptinFlow();
+  base::RunLoop().RunUntilIdle();
+}
