+// The launcher supplies its persistent environment UUID, never a display name
+// or an installation path. Keep this separate from GetProfileIdFromPath():
+// taskbar-shortcut migration must still inspect unrelated shortcuts natively.
+std::string GetShardXManagedEnvironmentId() {
+  const auto uuid = base::Uuid::ParseCaseInsensitive(
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "shardx-managed-environment"));
+  return uuid.is_valid() ? uuid.AsLowercaseString() : std::string();
+}
+
+std::optional<std::wstring> GetShardXManagedAppUserModelId(
+    const std::wstring& app_name,
+    const base::FilePath& profile_path) {
+  const std::string environment = GetShardXManagedEnvironmentId();
+  if (environment.empty() || profile_path.empty())
+    return std::nullopt;
+
+  // AppID is a shell grouping identifier, not an integrity/security digest.
+  // Hash the complete tuple rather than strip punctuation from profile names.
+  // Moving the application or data root keeps the same environment identity.
+  const std::string identity = environment + "\n" +
+      base::ToLowerASCII(profile_path.BaseName().AsUTF8Unsafe()) + "\n" +
+      base::WideToUTF8(app_name);
+  return ShellUtil::BuildAppUserModelId(
+      {install_static::GetBaseAppId(), L"ShardX",
+       base::ASCIIToWide(base::HexEncode(base::SHA1HashString(identity)))});
+}
