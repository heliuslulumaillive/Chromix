 void RegisterWidevineCdmComponent(ComponentUpdateService* cus) {
+  // UXR: opt-in local CDM preload (--uxr-widevine-cdm=<dir>). Registers
+  // a pre-fetched Widevine CDM directly from disk — no component-updater
+  // round trip, no Google API keys, works offline. The directory must mirror
+  // the Chrome component layout: manifest.json plus
+  // _platform_specific/<os>_<arch>/<widevinecdm lib>. On Windows/macOS the
+  // CDM joins the registry for this run; on Linux the hint file is updated
+  // (the CDM is loaded before the zygote locks down, so it applies from the
+  // next launch — persistent profiles make that transparent).
+  {
+    const base::CommandLine* ph_cmd = base::CommandLine::ForCurrentProcess();
+    if (ph_cmd->HasSwitch("uxr-widevine-cdm")) {
+      const base::FilePath ph_dir =
+          ph_cmd->GetSwitchValuePath("uxr-widevine-cdm");
+      int ph_error_code = 0;
+      std::string ph_error_message;
+      std::unique_ptr<base::Value> ph_value =
+          JSONFileValueDeserializer(
+              ph_dir.Append(FILE_PATH_LITERAL("manifest.json")))
+              .Deserialize(&ph_error_code, &ph_error_message);
+      const base::DictValue* ph_dict =
+          ph_value ? ph_value->GetIfDict() : nullptr;
+      media::CdmCapability ph_capability;
+      if (ph_dict && ParseCdmManifest(*ph_dict, &ph_capability) &&
+          IsCdmManifestCompatibleWithChrome(*ph_dict) &&
+          base::PathExists(GetCdmPathFromInstallDir(ph_dir))) {
+#if BUILDFLAG(IS_LINUX) || BUILDFLAG(IS_CHROMEOS)
+        UpdateHintFile(ph_dir);
+#else
+        RegisterWidevineCdmWithChrome(
+            ph_capability.version, GetCdmPathFromInstallDir(ph_dir),
+            ph_dict->Clone());
+#endif
+        VLOG(1) << "Registered local Widevine CDM from " << ph_dir.value();
+      } else {
+        VLOG(1) << "uxr-widevine-cdm dir invalid, ignoring: " << ph_dir.value();
+      }
+    }
+  }
   auto installer = base::MakeRefCounted<ComponentInstaller>(
       std::make_unique<WidevineCdmComponentInstallerPolicy>());
   installer->Register(cus, base::OnceClosure());
