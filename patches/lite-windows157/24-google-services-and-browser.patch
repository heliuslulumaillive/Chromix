+  for (auto* profile :
+       g_browser_process->profile_manager()->GetLoadedProfiles()) {
+    auto* client =
+        enterprise_connectors::RealtimeReportingClientFactory::GetForProfile(
+            profile);
+    if (client) {
+      return client;
+    }
+  }
   return nullptr;
 }
 
