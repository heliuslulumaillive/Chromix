diff --git a/base/uxr_shard_webgl_v2_properties.h b/base/uxr_shard_webgl_v2_properties.h
new file mode 100644
--- /dev/null
+++ b/base/uxr_shard_webgl_v2_properties.h
@@ -0,0 +1,204 @@
+// Observable invariants for the production helper, not an algorithm copy.
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <limits>
+#include <utility>
+#include <vector>
+
+inline std::pair<size_t, size_t> RunShardWebGLV2Properties() {
+  size_t checks = 0, failures = 0;
+  auto check = [&](bool condition) { ++checks; failures += !condition; };
+  for (uint32_t seed : {1u, 42u, 314159u, 32452843u, 49979687u, 0xffffffffu}) {
+    base::UxrSurfacePolicy policy;
+    policy.mode = base::UxrSurfaceMode::kShardX;
+    policy.seed = seed;
+    for (const auto [width, height] : {std::pair{128u, 96u}, {257u, 25u}, {64u, 64u}}) {
+      for (bool partial : {false, true}) {
+        std::vector<uint8_t> original(width * height * 4);
+        for (uint32_t y = 0; y < height; ++y) for (uint32_t x = 0; x < width; ++x) {
+          const size_t at = (y * width + x) * 4;
+          original[at] = (x * 7 + y * 13) % 256;
+          original[at + 1] = (x * 3 + y * 5) % 256;
+          original[at + 2] = (x * 11 + y * 17) % 256;
+          original[at + 3] = partial ? uint8_t((x + y) % 5 * 63) : 255;
+        }
+        auto apply = [&](std::vector<uint8_t>& pixels, uint32_t w, uint32_t h,
+                         int32_t x, int32_t y, size_t stride,
+                         base::UxrPixelSurface surface = base::UxrPixelSurface::kWebGLReadback,
+                         bool bgra = false) {
+          base::UxrPixelRegion region{pixels, stride, w, h, width, height, x, y, bgra};
+          return base::UxrApplyGraphicsNoiseV1(policy, surface, region);
+        };
+        auto full = original;
+        apply(full, width, height, 0, 0, width * 4);
+        check(full != original);
+        auto twice = full;
+        apply(twice, width, height, 0, 0, width * 4);
+        check(twice == full);
+        auto repeat = original;
+        apply(repeat, width, height, 0, 0, width * 4);
+        check(repeat == full);
+        for (size_t i = 0; i < full.size(); ++i) {
+          check(i % 4 == 3 ? full[i] == original[i] :
+                std::abs(int(full[i]) - int(original[i])) <= 1);
+          if (original[(i / 4) * 4 + 3] == 0) check(full[i] == original[i]);
+          if (i % 4 != 3 && (original[i] == 0 || original[i] == 255))
+            check(full[i] == original[i]);
+        }
+        // Arbitrary tiles with sentinel stride padding must compose exactly.
+        auto tiles = original;
+        for (uint32_t y = 0; y < height; y += 19) for (uint32_t x = 0; x < width; x += 23) {
+          const uint32_t w = std::min(23u, width - x), h = std::min(19u, height - y);
+          const size_t stride = w * 4 + 13;
+          std::vector<uint8_t> tile(stride * h, 173);
+          for (uint32_t yy = 0; yy < h; ++yy)
+            std::copy_n(original.begin() + ((y + yy) * width + x) * 4, w * 4,
+                        tile.begin() + yy * stride);
+          apply(tile, w, h, x, y, stride);
+          for (uint32_t yy = 0; yy < h; ++yy) {
+            std::copy_n(tile.begin() + yy * stride, w * 4,
+                        tiles.begin() + ((y + yy) * width + x) * 4);
+            check(std::all_of(tile.begin() + yy * stride + w * 4,
+                              tile.begin() + (yy + 1) * stride,
+                              [](uint8_t v) { return v == 173; }));
+          }
+        }
+        check(tiles == full);
+        // Exports use top-left order, optionally BGRA storage.
+        for (bool bgra : {false, true}) {
+          std::vector<uint8_t> exported(original.size());
+          for (uint32_t y = 0; y < height; ++y) for (uint32_t x = 0; x < width; ++x)
+            for (uint32_t c = 0; c < 4; ++c)
+              exported[(y * width + x) * 4 + (bgra && c < 3 ? 2 - c : c)] =
+                  original[((height - 1 - y) * width + x) * 4 + c];
+          apply(exported, width, height, 0, 0, width * 4,
+                base::UxrPixelSurface::kWebGLExport, bgra);
+          bool same = true;
+          for (uint32_t y = 0; y < height; ++y) for (uint32_t x = 0; x < width; ++x)
+            for (uint32_t c = 0; c < 4; ++c)
+              same &= exported[(y * width + x) * 4 + (bgra && c < 3 ? 2 - c : c)] ==
+                  full[((height - 1 - y) * width + x) * 4 + c];
+          check(same);
+        }
+        auto other = original;
+        policy.seed = seed == 0xffffffffu ? 2u : seed + 1;
+        apply(other, width, height, 0, 0, width * 4);
+        check(other != full);
+        policy.seed = seed;
+      }
+    }
+  }
+  base::UxrSurfacePolicy policy;
+  policy.mode = base::UxrSurfaceMode::kShardX;
+  policy.seed = 32452843;
+  // Boundary-only colors must remain exact across sizes, alpha conventions
+  // and read/export orientation. This is a color invariant, not a canvas-size
+  // exemption; the preceding interior-valued scenes still require changes.
+  for (const auto [w, h] : {std::pair{17u, 19u}, {128u, 96u}, {301u, 151u}}) {
+    for (bool premultiplied : {false, true}) {
+      for (uint32_t alpha : {0u, 1u, 2u, 64u, 128u, 255u}) {
+        std::vector<uint8_t> raw(w * h * 4), exported(raw.size());
+        const uint32_t maximum = premultiplied ? alpha : 255;
+        for (uint32_t y = 0; y < h; ++y) for (uint32_t x = 0; x < w; ++x) {
+          for (uint32_t channel = 0; channel < 3; ++channel) {
+            const bool high = ((x + y + channel) & 1u) != 0;
+            raw[(y * w + x) * 4 + channel] = high ? maximum : 0;
+            exported[((h - 1 - y) * w + x) * 4 + channel] =
+                high && (!premultiplied || alpha) ? 255 : 0;
+          }
+          raw[(y * w + x) * 4 + 3] = alpha;
+          exported[((h - 1 - y) * w + x) * 4 + 3] = alpha;
+        }
+        const auto original_raw = raw, original_export = exported;
+        base::UxrPixelRegion raw_region{raw, w * 4, w, h, w, h,
+                                         0, 0, false, premultiplied};
+        base::UxrPixelRegion export_region{exported, w * 4, w, h, w, h,
+                                            0, 0, false, premultiplied};
+        check(base::UxrApplyGraphicsNoiseV1(policy,
+            base::UxrPixelSurface::kWebGLReadback, raw_region) ==
+            base::UxrPixelResult::kUnchanged);
+        check(base::UxrApplyGraphicsNoiseV1(policy,
+            base::UxrPixelSurface::kWebGLExport, export_region) ==
+            base::UxrPixelResult::kUnchanged);
+        check(raw == original_raw && exported == original_export);
+      }
+    }
+  }
+  const uint32_t width = 128, height = 96;
+  // Valid premultiplied storage and its straight-alpha export must round trip
+  // to the same changed raw bytes, including low-alpha quantization boundaries.
+  auto premultiply = [](uint32_t c, uint32_t a) {
+    const uint32_t product = c * a;
+    return (product + ((product + 128u) >> 8) + 128u) >> 8;
+  };
+  auto unpremultiply = [](uint32_t c, uint32_t a) {
+    return a ? (c * (0xff000000u / a) + 0x800000u) >> 24 : 0u;
+  };
+  for (uint32_t alpha : {1u, 2u, 7u, 63u, 127u, 128u, 192u, 254u, 255u}) {
+    std::vector<uint8_t> raw(width * height * 4), exported(raw.size());
+    for (uint32_t y = 0; y < height; ++y) for (uint32_t x = 0; x < width; ++x) {
+      for (uint32_t c = 0; c < 3; ++c) {
+        const uint8_t value = (x * 7 + y * 11 + c * 17) % (alpha + 1);
+        raw[(y * width + x) * 4 + c] = value;
+        exported[((height - 1 - y) * width + x) * 4 + c] =
+            static_cast<uint8_t>(unpremultiply(value, alpha));
+      }
+      raw[(y * width + x) * 4 + 3] = alpha;
+      exported[((height - 1 - y) * width + x) * 4 + 3] = alpha;
+    }
+    base::UxrPixelRegion raw_region{raw, width * 4, width, height, width, height,
+                                     0, 0, false, true};
+    base::UxrPixelRegion export_region{exported, width * 4, width, height,
+                                        width, height, 0, 0, false, true};
+    const auto native_raw = raw;
+    base::UxrApplyGraphicsNoiseV1(policy, base::UxrPixelSurface::kWebGLReadback,
+                                   raw_region);
+    base::UxrApplyGraphicsNoiseV1(policy, base::UxrPixelSurface::kWebGLExport,
+                                   export_region);
+    // Alpha 1 has only the two representable endpoints, with no interior
+    // color on which a positive perturbation can be validly demonstrated.
+    check(alpha == 1 ? raw == native_raw : raw != native_raw);
+    for (size_t i = 0; i < raw.size(); ++i)
+      if (i % 4 != 3 && (native_raw[i] == 0 || native_raw[i] == alpha))
+        check(raw[i] == native_raw[i]);
+    bool match = true;
+    for (uint32_t y = 0; y < height; ++y) for (uint32_t x = 0; x < width; ++x)
+      for (uint32_t c = 0; c < 3; ++c)
+        match &= premultiply(exported[((height - 1 - y) * width + x) * 4 + c], alpha) ==
+                     raw[(y * width + x) * 4 + c];
+    check(match);
+    const auto once = raw;
+    base::UxrApplyGraphicsNoiseV1(policy, base::UxrPixelSurface::kWebGLReadback,
+                                   raw_region);
+    check(raw == once);
+  }
+  std::vector<uint8_t> floating(width * height * 16);
+  for (size_t i = 0; i < floating.size(); i += 4) {
+    const float v = std::array<float, 4>{.25f, .5f, .75f, 1.f}[(i / 4) % 4];
+    std::memcpy(floating.data() + i, &v, 4);
+  }
+  auto changed = floating;
+  base::UxrPixelRegion region{changed, width * 16, width, height, width, height};
+  check(base::UxrApplyShardWebGLFloatV2(policy, region) == base::UxrPixelResult::kApplied);
+  const auto once = changed;
+  base::UxrApplyShardWebGLFloatV2(policy, region);
+  check(changed == once);
+  for (size_t i = 0; i < changed.size(); i += 4) {
+    uint32_t a, b;
+    std::memcpy(&a, changed.data() + i, 4);
+    std::memcpy(&b, floating.data() + i, 4);
+    check((i / 4) % 4 == 3 ? a == b : (a & ~1u) == (b & ~1u));
+  }
+  std::vector<uint8_t> crop(71 * 53 * 16);
+  for (uint32_t y = 0; y < 53; ++y)
+    std::copy_n(floating.begin() + ((11 + y) * width + 13) * 16, 71 * 16,
+                crop.begin() + y * 71 * 16);
+  base::UxrPixelRegion cropped{crop, 71 * 16, 71, 53, width, height, 13, 11};
+  base::UxrApplyShardWebGLFloatV2(policy, cropped);
+  for (uint32_t y = 0; y < 53; ++y)
+    check(std::equal(crop.begin() + y * 71 * 16, crop.begin() + (y + 1) * 71 * 16,
+                      changed.begin() + ((11 + y) * width + 13) * 16));
+  return {checks, failures};
+}
diff --git a/third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc b/third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc
new file mode 100644
--- /dev/null
+++ b/third_party/blink/renderer/modules/webgl/gpu_fingerprint.cc
@@ -0,0 +1,125 @@
+#include "third_party/blink/renderer/modules/webgl/gpu_fingerprint.h"
+
+#include <initializer_list>
+
+#include "base/strings/string_split.h"
+#include "base/strings/string_util.h"
+#include "base/uxr_config.h"
+#include "components/ungoogled/persona_profile.h"
+
+namespace blink {
+namespace {
+
+bool IsHardwareWebGLContext(const Platform::WebGLContextInfo& info,
+                            std::string_view native_renderer) {
+  if (native_renderer.empty())
+    return false;
+  switch (info.angle_implementation) {
+    case gl::ANGLEImplementation::kSwiftShader:
+    case gl::ANGLEImplementation::kD3D11Warp:
+    case gl::ANGLEImplementation::kNull:
+      return false;
+    default:
+      break;
+  }
+  // The provider's GPU-process metadata precedes any JS identity override.
+  // GPU compositing is NOT evidence that this WebGL context is hardware.
+  if (info.vendor_id == 0x1414 && info.device_id == 0x008c)
+    return false;  // Microsoft Basic Render Driver.
+  // Native GL/Mesa software paths do not always carry an ANGLE CPU enum.
+  // Only query the actual context string, never an already presented identity.
+  const std::string renderer = base::ToLowerASCII(native_renderer);
+  for (std::string_view software : {"swiftshader", "llvmpipe", "softpipe",
+                                    "lavapipe", "software rasterizer",
+                                    "software renderer", "basic render driver"}) {
+    if (renderer.find(software) != std::string::npos)
+      return false;
+  }
+  return true;
+}
+
+bool CanPresentWebGLIdentity(const Platform::WebGLContextInfo& info,
+                            std::string_view native_renderer) {
+  const auto& persona = ungoogled::CurrentPersona();
+  if (persona.webgl_real || native_renderer.empty())
+    return false;
+  // Preserve the pre-mode public/synthetic gates for every legacy launch.
+  if (persona.webgl_native_capabilities && !persona.webgl_identity_explicit)
+    return false;
+  return IsHardwareWebGLContext(info, native_renderer);
+}
+
+base::UxrGpuMode IdentityMode() {
+  const auto& config = base::UxrConfig::GetInstance();
+  return base::UxrResolveGpuModeV1(
+      config.Get("uxr-webgl-identity-mode"), config.Get("uxr-gpu-mode"),
+      config.Get("uxr-fingerprint-off") == "true");
+}
+
+std::optional<std::string> ConfiguredIdentity(
+    const Platform::WebGLContextInfo& info, std::string_view native_renderer,
+    bool vendor) {
+  const auto& config = base::UxrConfig::GetInstance();
+  if (IdentityMode() == base::UxrGpuMode::kNative ||
+      !IsHardwareWebGLContext(info, native_renderer))
+    return std::nullopt;
+  // Cloak catalog selection happens once in browser configuration. Explicit
+  // overrides retain precedence; no per-getter re-selection or capability flag.
+  const std::string v = config.Get("uxr-webgl-vendor");
+  const std::string r = config.Get("uxr-webgl-renderer");
+  if (v.empty() || r.empty())
+    return std::nullopt;
+  return vendor ? v : r;
+}
+
+}  // namespace
+
+std::optional<std::string> GetGLVendorStringForFingerprint(
+    const Platform::WebGLContextInfo& info, std::string_view native_renderer) {
+  if (IdentityMode() != base::UxrGpuMode::kLegacy)
+    return ConfiguredIdentity(info, native_renderer, true);
+  if (!CanPresentWebGLIdentity(info, native_renderer))
+    return std::nullopt;
+  return ungoogled::CurrentPersona().webgl_vendor;
+}
+
+std::optional<std::string> GetGLRendererStringForFingerprint(
+    const Platform::WebGLContextInfo& info, std::string_view native_renderer) {
+  if (IdentityMode() != base::UxrGpuMode::kLegacy)
+    return ConfiguredIdentity(info, native_renderer, false);
+  if (!CanPresentWebGLIdentity(info, native_renderer))
+    return std::nullopt;
+  return ungoogled::CurrentPersona().webgl_renderer;
+}
+
+base::UxrGpuMode GetWebGLCapabilitiesMode() {
+  const auto& config = base::UxrConfig::GetInstance();
+  return base::UxrResolveGpuModeV1(
+      config.Get("uxr-webgl-capabilities-mode"), {},
+      config.Get("uxr-fingerprint-off") == "true");
+}
+
+int GetWebGLContextLimitV1(const char* key, int native_value) {
+  if (GetWebGLCapabilitiesMode() != base::UxrGpuMode::kCustom)
+    return native_value;
+  int requested = 0;
+  if (!base::UxrConfig::GetInstance().GetInt(key, &requested))
+    return native_value;
+  return base::UxrClampContextCapabilityV1(native_value, requested);
+}
+
+bool IsWebGLModeExtensionAllowedV1(std::string_view name) {
+  const auto& config = base::UxrConfig::GetInstance();
+  if (GetWebGLCapabilitiesMode() != base::UxrGpuMode::kCustom ||
+      !config.Has("uxr-webgl-extensions"))
+    return true;
+  for (const auto& token : base::SplitString(
+           config.Get("uxr-webgl-extensions"), ",", base::TRIM_WHITESPACE,
+           base::SPLIT_WANT_NONEMPTY)) {
+    if (base::EqualsCaseInsensitiveASCII(token, name))
+      return true;
+  }
+  return false;  // Explicit empty custom allowlist permits no extensions.
+}
+
+}  // namespace blink
diff --git a/third_party/blink/renderer/modules/webgl/gpu_fingerprint.h b/third_party/blink/renderer/modules/webgl/gpu_fingerprint.h
new file mode 100644
--- /dev/null
+++ b/third_party/blink/renderer/modules/webgl/gpu_fingerprint.h
@@ -0,0 +1,30 @@
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_GPU_FINGERPRINT_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_GPU_FINGERPRINT_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include "base/uxr_gpu_modes.h"
+#include "third_party/blink/public/platform/platform.h"
+
+namespace blink {
+
+// nullopt means use the native query; an engaged empty value stays empty.
+// Never fill an unknown one-sided identity with an unrelated native field.
+// The caller must pass this context's
+// provider metadata and unmodified GL_RENDERER, including after restoration.
+// No launch-global mutation or assumption about a WebGPU/other-context adapter.
+std::optional<std::string> GetGLVendorStringForFingerprint(
+    const Platform::WebGLContextInfo&, std::string_view native_renderer);
+std::optional<std::string> GetGLRendererStringForFingerprint(
+    const Platform::WebGLContextInfo&, std::string_view native_renderer);
+
+// These independent modes never enable the legacy synthetic/Canvas policies.
+base::UxrGpuMode GetWebGLCapabilitiesMode();
+int GetWebGLContextLimitV1(const char* key, int native_value);
+bool IsWebGLModeExtensionAllowedV1(std::string_view name);
+
+}  // namespace blink
+
+#endif  // THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_GPU_FINGERPRINT_H_
diff --git a/third_party/blink/renderer/modules/webgl/gpu_info.cc b/third_party/blink/renderer/modules/webgl/gpu_info.cc
new file mode 100644
--- /dev/null
+++ b/third_party/blink/renderer/modules/webgl/gpu_info.cc
@@ -0,0 +1,100 @@
+#include "third_party/blink/renderer/modules/webgl/gpu_info.h"
+
+#include "base/strings/stringprintf.h"
+#include "components/ungoogled/fingerprint_data.h"
+
+namespace blink {
+
+using ungoogled::fingerprint::GpuModelInfo;
+using ungoogled::fingerprint::kGpuModelCount;
+using ungoogled::fingerprint::kGpuModels;
+using ungoogled::fingerprint::kLinuxGpuSuffix;
+using ungoogled::fingerprint::kLinuxVendorString;
+using ungoogled::fingerprint::kMacosGpuModelCount;
+using ungoogled::fingerprint::kMacosGpuModels;
+using ungoogled::fingerprint::kWindowsGpuSuffix;
+using ungoogled::fingerprint::kWindowsVendorString;
+
+// Generate full Windows GPU info on demand
+GpuInfo GetWindowsGpuInfo(size_t index) {
+  if (index >= kGpuModelCount) {
+    // Default to last one (RTX 4090) if out of bounds
+    index = kGpuModelCount - 1;
+  }
+
+  const GpuModelInfo& model = kGpuModels[index];
+  GpuInfo info;
+  info.model_name = model.model_name;
+  info.device_id = model.device_id;
+
+  // Build the Windows renderer string
+  std::string device_id_part = (model.device_id && model.device_id[0]) ?
+    " (" + std::string(model.device_id) + ")" : "";
+
+  info.renderer_string = "ANGLE (" + std::string(kWindowsVendorString) +
+                         ", NVIDIA " + info.model_name +
+                         device_id_part + " " + kWindowsGpuSuffix + ")";
+
+  return info;
+}
+
+// All Windows GPU info list - generated from kGpuModels
+std::vector<GpuInfo> GetAllWindowsGpuInfo() {
+  std::vector<GpuInfo> result;
+  result.reserve(kGpuModelCount);
+
+  for (size_t i = 0; i < kGpuModelCount; ++i) {
+    result.push_back(GetWindowsGpuInfo(i));
+  }
+
+  return result;
+}
+
+// Lazy-initialized list of Windows GPU info
+const std::vector<GpuInfo>& GetWindowsGpuInfoList() {
+  static const std::vector<GpuInfo>* windows_gpu_info = nullptr;
+  if (!windows_gpu_info) {
+    windows_gpu_info = new std::vector<GpuInfo>(GetAllWindowsGpuInfo());
+  }
+  return *windows_gpu_info;
+}
+
+// Implementation of the functions declared in the header
+size_t GetGpuCount() {
+  return kGpuModelCount;
+}
+
+const GpuInfo& GetGpuInfo(size_t index) {
+  // Use the Windows GPU info list
+  const std::vector<GpuInfo>& windows_list = GetWindowsGpuInfoList();
+
+  // Ensure index is in bounds
+  if (index >= windows_list.size()) {
+    return windows_list.back();
+  }
+
+  return windows_list[index];
+}
+
+// Helper function to get a macOS GPU model string
+std::string GetMacosGpuString(size_t index) {
+  if (index >= kMacosGpuModelCount) {
+    // Default to M3 if out of bounds
+    index = kMacosGpuModelCount - 1;  // Index of M3 in the array
+  }
+
+  return base::StringPrintf("ANGLE (Apple, ANGLE Metal Renderer: Apple %s, Unspecified Version)",
+                         kMacosGpuModels[index]);
+}
+
+// Helper function to get a Linux GPU renderer string
+std::string GetLinuxGpuString(const std::string& model_name) {
+  // Note the difference: no device ID and no space before /PCIe
+  // Also using the Linux-specific vendor string
+  return base::StringPrintf("ANGLE (%s, NVIDIA %s%s)",
+                         kLinuxVendorString,
+                         model_name.c_str(),
+                         kLinuxGpuSuffix);
+}
+
+}  // namespace blink
diff --git a/third_party/blink/renderer/modules/webgl/gpu_info.h b/third_party/blink/renderer/modules/webgl/gpu_info.h
new file mode 100644
--- /dev/null
+++ b/third_party/blink/renderer/modules/webgl/gpu_info.h
@@ -0,0 +1,36 @@
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_GPU_INFO_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_GPU_INFO_H_
+
+#include <string>
+#include <vector>
+
+namespace blink {
+
+// Structure to hold GPU information
+struct GpuInfo {
+  std::string model_name;
+  std::string device_id;
+  std::string renderer_string;
+};
+
+// Returns the number of available GPUs in our database
+size_t GetGpuCount();
+
+// Returns GPU info for a given index
+const GpuInfo& GetGpuInfo(size_t index);
+
+// Helper function to get a macOS GPU model string
+std::string GetMacosGpuString(size_t index);
+
+// Helper function to get a Linux GPU renderer string
