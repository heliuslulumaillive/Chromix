+// Copyright 2026. ShardX-derived WebGL readback integration.
+#ifndef THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_UXR_SHARD_READBACK_H_
+#define THIRD_PARTY_BLINK_RENDERER_MODULES_WEBGL_UXR_SHARD_READBACK_H_
+
+#include <algorithm>
+#include <limits>
+#include <memory>
+#include <optional>
+#include "base/compiler_specific.h"
+#include "base/containers/span.h"
+#include "base/process/memory.h"
+#include "base/uxr_graphics_noise.h"
+#include "gpu/command_buffer/client/gles2_interface.h"
+
+namespace blink {
+struct UxrShardPackLayout {
+  size_t stride;
+  size_t skip;
+  size_t row_bytes;
+  size_t total;
+  size_t pixel_bytes;
+};
+
+inline std::optional<UxrShardPackLayout> UxrShardLayout(
+    int width, int height, int alignment, int row_length, int skip_pixels,
+    int skip_rows, GLenum format, GLenum type, size_t available) {
+  if (width <= 0 || height <= 0 || row_length < 0 || skip_pixels < 0 ||
+      skip_rows < 0 || format != GL_RGBA ||
+      (type != GL_UNSIGNED_BYTE && type != GL_FLOAT) ||
+      (alignment != 1 && alignment != 2 && alignment != 4 && alignment != 8))
+    return std::nullopt;
+  const uint64_t pixel = type == GL_FLOAT ? 16 : 4;
+  const uint64_t columns = row_length ? row_length : width;
+  if (uint64_t{static_cast<uint32_t>(skip_pixels)} + width > columns)
+    return std::nullopt;
+  const uint64_t stride = (columns * pixel + alignment - 1) / alignment * alignment;
+  // Division checks precede products, even for hostile INT_MAX PACK values.
+  if (!stride || static_cast<uint64_t>(skip_rows) > available / stride ||
+      static_cast<uint64_t>(height - 1) > available / stride)
+    return std::nullopt;
+  const uint64_t skip = stride * skip_rows + pixel * skip_pixels;
+  const uint64_t row_bytes = pixel * width;
+  const uint64_t rows = stride * (height - 1);
+  if (skip > available || rows > available - skip ||
+      row_bytes > available - skip - rows)
+    return std::nullopt;
+  return UxrShardPackLayout{static_cast<size_t>(stride), static_cast<size_t>(skip),
+      static_cast<size_t>(row_bytes), static_cast<size_t>(skip + rows + row_bytes),
+      static_cast<size_t>(pixel)};
+}
+
+inline std::optional<base::UxrPixelRegion> UxrShardCompletedRegion(
+    base::span<uint8_t> bytes, const UxrShardPackLayout& layout,
+    const gpu::gles2::GLES2Interface::ReadPixelsCompletion& done,
+    int x, int y, int width, int height, bool premultiplied) {
+  if (!done.success || done.columns <= 0 || done.rows <= 0)
+    return std::nullopt;
+  const int64_t left = std::max<int64_t>(0, -int64_t{x});
+  const int64_t bottom = std::max<int64_t>(0, -int64_t{y});
+  if (left >= width || bottom >= height || done.columns > width - left ||
+      done.rows > height - bottom)
+    return std::nullopt;
+  const size_t begin = layout.skip + bottom * layout.stride + left * layout.pixel_bytes;
+  const size_t length = (done.rows - 1) * layout.stride + done.columns * layout.pixel_bytes;
+  if (begin > bytes.size() || length > bytes.size() - begin)
+    return std::nullopt;
+  return base::UxrPixelRegion{bytes.subspan(begin, length), layout.stride,
+      static_cast<uint32_t>(done.columns), static_cast<uint32_t>(done.rows),
+      static_cast<uint32_t>(width), static_cast<uint32_t>(height),
+      std::max(x, 0), std::max(y, 0), false, premultiplied};
+}
+
+struct UxrShardNeighborhood {
+  std::unique_ptr<uint8_t, base::UncheckedFreeDeleter> storage;
+  base::UxrPixelNeighborhood view;
+};
+
+// A completed second read from the same still-bound framebuffer provides the
+// halo. It never consumes getError(), and restores every PACK/PBO state it
+// temporarily changes. It is called only after the user's original read
+// succeeded. On allocation/read failure the original native pixels are kept.
+inline UxrShardNeighborhood UxrShardReadNeighborhood(
+    gpu::gles2::GLES2Interface* gl, GLenum type,
+    const base::UxrPixelRegion& region, int alignment, int row_length,
+    int skip_pixels, int skip_rows, bool extended_pack, GLuint pack_buffer) {
+  UxrShardNeighborhood result;
+  if (!gl || !gl->SupportsReadPixelsCompletion() || !region.width ||
+      !region.height || region.origin_x < 0 || region.origin_y < 0)
+    return result;
+  const int x = std::max(region.origin_x - 1, 0);
+  const int y = std::max(region.origin_y - 1, 0);
+  const int64_t width = int64_t{region.width} + (region.origin_x != 0) + 1;
+  const int64_t height = int64_t{region.height} + (region.origin_y != 0) + 1;
+  if (width > std::numeric_limits<int>::max() - int64_t{x} ||
+      height > std::numeric_limits<int>::max() - int64_t{y})
+    return result;
+  const auto layout = UxrShardLayout(static_cast<int>(width),
+      static_cast<int>(height), 1, 0, 0, 0, GL_RGBA, type,
+      std::numeric_limits<size_t>::max());
+  if (!layout)
+    return result;
+  void* allocation = nullptr;
+  if (!base::UncheckedMalloc(layout->total, &allocation))
+    return result;
+  result.storage.reset(static_cast<uint8_t*>(allocation));
+  // SAFETY: storage owns exactly layout->total bytes through completion.
+  auto bytes = UNSAFE_BUFFERS(base::span<uint8_t>(result.storage.get(), layout->total));
+  if (extended_pack) {
+    gl->BindBuffer(GL_PIXEL_PACK_BUFFER, 0);
+    gl->PixelStorei(GL_PACK_ROW_LENGTH, 0);
+    gl->PixelStorei(GL_PACK_SKIP_PIXELS, 0);
+    gl->PixelStorei(GL_PACK_SKIP_ROWS, 0);
+  }
+  gl->PixelStorei(GL_PACK_ALIGNMENT, 1);
+  const auto done = gl->ReadPixelsWithCompletion(x, y, static_cast<int>(width),
+      static_cast<int>(height), GL_RGBA, type, bytes.data());
+  gl->PixelStorei(GL_PACK_ALIGNMENT, alignment);
+  if (extended_pack) {
+    gl->PixelStorei(GL_PACK_ROW_LENGTH, row_length);
+    gl->PixelStorei(GL_PACK_SKIP_PIXELS, skip_pixels);
+    gl->PixelStorei(GL_PACK_SKIP_ROWS, skip_rows);
+    gl->BindBuffer(GL_PIXEL_PACK_BUFFER, pack_buffer);
+  }
+  const auto completed = UxrShardCompletedRegion(bytes, *layout, done, x, y,
+      static_cast<int>(width), static_cast<int>(height), region.premultiplied);
+  if (completed) {
+    result.view = {completed->bytes, completed->row_stride, completed->width,
+                   completed->height, completed->origin_x, completed->origin_y};
+  }
+  return result;
+}
+
+inline void UxrShardApplyCompleted(const base::UxrSurfacePolicy& policy,
+                                  GLenum type, const base::UxrPixelRegion& region) {
+  if (type == GL_FLOAT)
+    base::UxrApplyShardWebGLFloatV2(policy, region);
+  else
+    base::UxrApplyGraphicsNoiseV1(policy, base::UxrPixelSurface::kWebGLReadback, region);
+}
+}  // namespace blink
+#endif
