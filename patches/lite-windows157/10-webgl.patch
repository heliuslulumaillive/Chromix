+// A bounded staging read can prove completion only for an opaque, in-bounds
+// default buffer: every alpha byte must change from zero to 255. Transparent
+// buffers need an explicit command-buffer success result instead.
+constexpr size_t kUxrWebGLReadbackLimit = 16 * 1024 * 1024;
+
+struct UxrWebGLReadbackLayout {
+  size_t stride;
+  size_t skip;
+  size_t row_bytes;
+  size_t total;
+};
+
+std::optional<UxrWebGLReadbackLayout> UxrWebGLReadbackLayoutFor(
+    int width,
+    int height,
+    int alignment,
+    int row_length,
+    int skip_pixels,
+    int skip_rows,
+    size_t available) {
+  if (width <= 0 || height <= 0 || row_length < 0 || skip_pixels < 0 ||
+      skip_rows < 0 ||
+      (alignment != 1 && alignment != 2 && alignment != 4 && alignment != 8)) {
+    return std::nullopt;
+  }
+  const uint64_t row_pixels = row_length ? row_length : width;
+  if (static_cast<uint64_t>(skip_pixels) + width > row_pixels ||
+      row_pixels > kUxrWebGLReadbackLimit / 4) {
+    return std::nullopt;
+  }
+  const uint64_t stride =
+      (row_pixels * 4 + alignment - 1) / alignment * alignment;
+  // Bound both products before multiplication, including on 32-bit targets.
+  if (static_cast<uint64_t>(height) > kUxrWebGLReadbackLimit / stride ||
+      static_cast<uint64_t>(skip_rows) > kUxrWebGLReadbackLimit / stride) {
+    return std::nullopt;
+  }
+  const uint64_t skip = stride * skip_rows + uint64_t{4} * skip_pixels;
+  const uint64_t row_bytes = uint64_t{4} * width;
+  const uint64_t total = skip + stride * (height - 1) + row_bytes;
+  if (total > kUxrWebGLReadbackLimit || total > available) {
+    return std::nullopt;
+  }
+  return UxrWebGLReadbackLayout{static_cast<size_t>(stride),
+                               static_cast<size_t>(skip),
+                               static_cast<size_t>(row_bytes),
+                               static_cast<size_t>(total)};
+}
+
+bool UxrWebGLReadbackComplete(base::span<const uint8_t> staging,
+                             const UxrWebGLReadbackLayout& layout,
+                             int height) {
+  for (int row = 0; row < height; ++row) {
+    const auto bytes = staging.subspan(layout.skip + row * layout.stride,
+                                      layout.row_bytes);
+    for (size_t alpha = 3; alpha < bytes.size(); alpha += 4) {
+      if (bytes[alpha] != 255) {
+        return false;
+      }
+    }
+  }
+  return true;
+}
+
+void UxrCommitWebGLReadback(base::span<const uint8_t> staging,
+                          base::span<uint8_t> destination,
+                          const UxrWebGLReadbackLayout& layout,
+                          int x,
+                          int y,
+                          int width,
+                          int height,
+                          int drawing_height,
+                          uint64_t seed) {
+  const uint32_t folded_seed = base::UxrPixelNoiseSeed(seed);
+  for (int row = 0; row < height; ++row) {
+    const size_t start = layout.skip + row * layout.stride;
+    const auto source = staging.subspan(start, layout.row_bytes);
+    auto target = destination.subspan(start, layout.row_bytes);
+    // Match top-left export coordinates, independent of crop and PACK state.
+    const uint32_t top_y = drawing_height - 1 - (y + row);
+    for (int column = 0; column < width; ++column) {
+      const size_t pixel = static_cast<size_t>(column) * 4;
+      for (uint32_t channel = 0; channel < 3; ++channel) {
+        target[pixel + channel] = base::UxrNoiseChannel(
+            folded_seed, x + column, top_y, channel, source[pixel + channel]);
+      }
+      target[pixel + 3] = source[pixel + 3];
+    }
+  }
+}
