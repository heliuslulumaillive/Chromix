diff --git a/base/uxr_font_allowlist.h b/base/uxr_font_allowlist.h
new file mode 100644
--- /dev/null
+++ b/base/uxr_font_allowlist.h
@@ -0,0 +1,53 @@
+// Copyright 2026. Explicit installed-font filtering for compatible-v1.
+#ifndef BASE_UXR_FONT_ALLOWLIST_H_
+#define BASE_UXR_FONT_ALLOWLIST_H_
+
+#include <string_view>
+
+namespace base {
+
+// This predicate compares a resolved native family with the validated CSV
+// configuration. It does not make a font available or resolve a declared alias.
+// An absent list is handled by the caller; an explicitly empty list matches no
+// family. Case folding is ASCII-only and non-ASCII UTF-8 bytes compare exactly.
+inline bool UxrFontFamilyInAllowlistV1(std::string_view csv,
+                                     std::string_view family) {
+  if (family.empty())
+    return false;
+  const auto space = [](char c) {
+    return c == ' ' || c == '\t' || c == '\n' || c == '\r' || c == '\f' ||
+           c == '\v';
+  };
+  const auto lower = [](unsigned char c) {
+    return c >= 'A' && c <= 'Z' ? static_cast<unsigned char>(c + ('a' - 'A'))
+                              : c;
+  };
+  while (!csv.empty()) {
+    const auto separator = csv.find(',');
+    auto entry = csv.substr(0, separator);
+    while (!entry.empty() && space(entry.front()))
+      entry.remove_prefix(1);
+    while (!entry.empty() && space(entry.back()))
+      entry.remove_suffix(1);
+    if (entry.size() == family.size()) {
+      bool equal = true;
+      for (std::string_view::size_type i = 0; i < entry.size(); ++i) {
+        if (lower(static_cast<unsigned char>(entry[i])) !=
+            lower(static_cast<unsigned char>(family[i]))) {
+          equal = false;
+          break;
+        }
+      }
+      if (equal)
+        return true;
+    }
+    if (separator == std::string_view::npos)
+      break;
+    csv.remove_prefix(separator + 1);
+  }
+  return false;
+}
+
+}  // namespace base
+
+#endif  // BASE_UXR_FONT_ALLOWLIST_H_
diff --git a/base/uxr_font_allowlist_tests.cc b/base/uxr_font_allowlist_tests.cc
new file mode 100644
--- /dev/null
+++ b/base/uxr_font_allowlist_tests.cc
@@ -0,0 +1,84 @@
+// Copyright 2026. Contract tests for explicit installed-font filtering.
+#include "base/uxr_font_allowlist.h"
+
+#include <cstdio>
+#include <string_view>
+
+int RunFontAllowlistTests() {
+  // Expectations are fixed examples of the public CSV contract. They are not
+  // generated by the production predicate and do not assert font installation.
+  struct Case {
+    std::string_view list;
+    std::string_view family;
+    bool allowed;
+  };
+  constexpr Case cases[] = {
+      {"", "Arial", false},
+      {"", "", false},
+      {"Arial", "", false},
+      {"Arial", "Arial", true},
+      {"Arial", "arial", true},
+      {"arial", "ARIAL", true},
+      {"Arial", "ArialMT", false},
+      {"Arial", "Arial Black", false},
+      {"Arial Black", "Arial", false},
+      {"Arial,Consolas", "Consolas", true},
+      {"Arial,Consolas", "Times New Roman", false},
+      {"Times New Roman,Arial,Consolas", "times new roman", true},
+      {" \tArial\r\n, Consolas \v\f", "CONSOLAS", true},
+      {" \tArial\r\n, Consolas \v\f", "Arial", true},
+      {"Times  New Roman", "Times New Roman", false},
+      {"Arial", " Arial", false},
+      {"Arial", "Arial ", false},
+      {"arial,Arial,ARIAL", "Arial", true},
+      {"Arial,Consolas", "Consol", false},
+      {"Arial,Consolas", "Arial,Consolas", false},
+      {"DefinitelyAbsentFontXYZ", "DefinitelyAbsentFontXYZ", true},
+      {"Arial,Consolas", "DefinitelyAbsentFontXYZ", false},
+      {"ＭＳ ゴシック,Arial", "ＭＳ ゴシック", true},
+      {"ＭＳ ゴシック,Arial", "MS Gothic", false},
+      {"École", "école", false},
+      {"ÉCOLE", "École", true},
+      {"\xC2\xA0" "Arial", "Arial", false},
+      {"Arial;", "Arial", false},
+      {"\"Arial\"", "Arial", false},
+      // Invalid CSV is rejected by config validation; these defensive cases
+      // confirm that an accidental empty token cannot admit a family.
+      {",,", "Arial", false},
+      {",", "", false},
+      {"Arial,,Consolas", "Helvetica", false},
+  };
+  unsigned checks = 0;
+  unsigned failures = 0;
+  for (const auto& item : cases) {
+    ++checks;
+    if (base::UxrFontFamilyInAllowlistV1(item.list, item.family) != item.allowed) {
+      ++failures;
+      std::fprintf(stderr, "Font allowlist contract case %u failed\n", checks);
+    }
+  }
+  // A local-only restriction intersects the general list. It must not grant a
+  // family excluded by the general list; the CSS path uses only the first list.
+  constexpr std::string_view families[] = {"Arial", "Consolas",
+                                            "Times New Roman"};
+  constexpr bool general_expected[] = {true, true, false};
+  constexpr bool local_expected[] = {true, false, false};
+  for (unsigned i = 0; i < 3; ++i) {
+    const bool general = base::UxrFontFamilyInAllowlistV1(
+        "Arial,Consolas", families[i]);
+    const bool local = general && base::UxrFontFamilyInAllowlistV1(
+                                     "Arial,Times New Roman", families[i]);
+    checks += 2;
+    failures += general != general_expected[i];
+    failures += local != local_expected[i];
+  }
+  std::printf("{\"font_allowlist_checks\":%u,\"failures\":%u}\n", checks,
+              failures);
+  return failures == 0 ? 0 : 1;
+}
+
+#if defined(UXR_FONT_ALLOWLIST_STANDALONE)
+int main() {
+  return RunFontAllowlistTests();
+}
+#endif
