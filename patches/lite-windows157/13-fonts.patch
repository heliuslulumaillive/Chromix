+
+bool FontCache::IsUxrFontFamilyAllowed(const String& family) {
+  if (!UxrExplicitFontFamilyAllowed(family, "uxr-fonts-allowlist"))
+    return false;
+  const auto& config = base::UxrConfig::GetInstance();
+  const auto modes = config.SurfaceModes();
+  const auto surface = modes.fonts;
+  if (surface.mode == base::UxrSurfaceMode::kShardX &&
+      !modes.noise_disabled && !modes.raw) {
+#if BUILDFLAG(IS_WIN)
+    // Seeded package combinations are legacy experiments, not country defaults.
+    // Complete verified installation selection belongs to the launcher.
+    if (config.Get("uxr-fonts-experimental-packages") != "1")
+      return true;
+    return !base::uxr_surface_v1::ShardWindowsFontHiddenV2(
+        family.Utf8(), static_cast<uint32_t>(surface.seed));
+#else
+    return !base::uxr_surface_v1::ShardFontHidden(
+        family.Utf8(), static_cast<uint32_t>(surface.seed));
+#endif
+  }
+  return true;
+}
+
+bool FontCache::IsUxrLocalFontFamilyAllowed(const String& family) {
+  return IsUxrFontFamilyAllowed(family) &&
+         UxrExplicitFontFamilyAllowed(family, "uxr-fonts-local-allowlist");
+}
+
+const SimpleFontData* FontCache::UxrRestrictedLastResortFont(
+    const FontDescription& description) {
+  const auto& config = base::UxrConfig::GetInstance();
+  if (!config.Has("uxr-fonts-allowlist"))
+    return nullptr;
+  const auto pool = config.Get("uxr-fonts-allowlist");
+  for (const auto& entry : base::SplitString(pool, ",", base::TRIM_WHITESPACE,
+                                            base::SPLIT_WANT_NONEMPTY)) {
+    if (const auto* data = GetFontData(description, AtomicString(String::FromUtf8(entry)),
+                                       AlternateFontName::kNoAlternate))
+      return data;
+  }
+  // A missing installed pool must not fall back to an excluded host font, or
+  // leave Blink's mandatory last-resort font null. Skia's empty face has no
+  // host glyphs and keeps this failure bounded; no real font is fabricated.
+  const auto* empty = MakeGarbageCollected<FontPlatformData>(
+      SkTypeface::MakeEmpty(), std::string(), description.EffectiveFontSize(),
+      false, false, description.TextRendering(), ResolvedFontFeatures(),
+      description.Orientation());
+  return FontDataFromFontPlatformData(empty, description.SubpixelAscentDescent());
 }
 
