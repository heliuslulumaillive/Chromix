+      if (!r.Read(&tag) || !r.Read(&axis.value) || !std::isfinite(axis.value)) return false;
+      axis.axisTag=static_cast<DWRITE_FONT_AXIS_TAG>(tag);
+    }
+    result.faces.push_back(std::move(f));
+  }
+  if (!r.Done()) return false;
+  *output=std::move(result);
+  return true;
+}
