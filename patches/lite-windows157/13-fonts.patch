+HRESULT GetPrivateFontCollection(IDWriteFactory* factory,
+                                  IDWriteFontCollection** collection) {
+  if (!collection) return E_POINTER;
+  *collection = nullptr;
+  if (!base::CommandLine::InitializedForCurrentProcess()) return S_FALSE;
+  const auto* command = base::CommandLine::ForCurrentProcess();
+  if (!command->HasSwitch("uxr-fonts-resources-dir") &&
+      !command->HasSwitch("uxr-fonts-resource-group") &&
+      !command->HasSwitch("uxr-fonts-catalog-dir")) return S_FALSE;
+  const auto root = base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+      "uxr-fonts-resources-dir");
+  const auto group = base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+      "uxr-fonts-resource-group");
+  const bool country_resources = command->HasSwitch("uxr-fonts-resource-group") ||
+      command->HasSwitch("uxr-fonts-catalog-dir");
+  const auto catalog = base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+      "uxr-fonts-catalog-dir");
+  struct CachedPrivateCollection {
+    HRESULT result = E_FAIL;
+    std::shared_ptr<base::uxr_private_fonts_v1::Resources> resources;
+    std::shared_ptr<base::uxr_private_fonts_v1::CatalogSelection> selection;
+    std::shared_ptr<base::uxr_private_fonts_v1::NativeViewSnapshot> native_snapshot;
+    Microsoft::WRL::ComPtr<IDWriteFontCollection> fonts;
+    CachedPrivateCollection(IDWriteFactory* factory, const std::wstring& root,
+                            const std::string& group, bool country_resources,
+                            const std::wstring& catalog) {
+      if (country_resources) {
+        result = base::uxr_private_fonts_v1::LoadCountryCatalog(catalog, group, &selection);
+        CHECK(SUCCEEDED(result)) << "Signed controlled font policy rejected: " << result;
+        const HRESULT additions = base::uxr_private_fonts_v1::VerifyCatalogAssets(
+            root, *selection, &resources);
+        if (FAILED(additions)) {
+          LOG(ERROR) << "Regional font additions unavailable: " << additions;
+          resources.reset();
+        }
+        result = base::uxr_private_fonts_v1::CreateControlledCollection(
+            factory, selection->native_sources, resources, &native_snapshot, &fonts,
+            selection->face_index.get());
+        if (SUCCEEDED(result) && native_snapshot->additions_rejected)
+          LOG(ERROR) << "Regional font loading failed; verified controlled base retained";
+        // A missing required source or invalid policy must never expose the
+        // complete host collection. The launcher reports compatibility errors.
+        CHECK(SUCCEEDED(result)) << "Controlled native font view rejected: " << result;
+      } else {
+        result = base::uxr_private_fonts_v1::Verify(root, &resources);
+        if (SUCCEEDED(result)) result = base::uxr_private_fonts_v1::CreateCollection(
+            factory, resources, &fonts);
+        if (FAILED(result)) LOG(ERROR) << "Private font resources rejected: " << result;
+      }
+    }
+  };
+  static const base::NoDestructor<CachedPrivateCollection> cache(
+      factory, root.value(), group, country_resources, catalog.value());
+  if (cache->result != S_OK) return cache->result;
+  return cache->fonts.CopyTo(collection);
+}
 
