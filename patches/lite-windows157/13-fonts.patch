+    if (!r.Read(&f.file) || f.file>=files || result.sources[f.file].kind==3 ||
+        !r.Read(&f.index) || f.index>65535 || !r.Read(&f.simulations) ||
+        (f.simulations & ~3u) || !r.Read(&n) || n>64) return false;
