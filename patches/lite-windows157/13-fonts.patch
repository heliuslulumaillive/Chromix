+      !r.Read(&version) || version!=1 || !r.Text(64,&result.catalog) ||
+      result.catalog!=catalog || !HexDigest(result.catalog) || !r.Read(&files) ||
+      !files || files>4096 || !r.Read(&faces) || !faces || faces>32768) return false;
