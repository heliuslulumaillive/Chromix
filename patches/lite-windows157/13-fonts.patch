+HRESULT GetPrivateFontCollection(IDWriteFactory* factory,
+                                  IDWriteFontCollection** collection) {
+  if (!collection) return E_POINTER;
+  *collection = nullptr;
+  if (!base::CommandLine::InitializedForCurrentProcess() ||
+      !base::CommandLine::ForCurrentProcess()->HasSwitch("uxr-fonts-resources-dir"))
+    return S_FALSE;
+  const auto root = base::CommandLine::ForCurrentProcess()->GetSwitchValuePath(
+      "uxr-fonts-resources-dir");
+  struct CachedPrivateCollection {
+    HRESULT result = E_FAIL;
+    std::shared_ptr<base::uxr_private_fonts_v1::Resources> resources;
+    Microsoft::WRL::ComPtr<IDWriteFontCollection> fonts;
+    CachedPrivateCollection(IDWriteFactory* factory, const std::wstring& root) {
+      result = base::uxr_private_fonts_v1::Verify(root, &resources);
+      if (SUCCEEDED(result)) result = base::uxr_private_fonts_v1::CreateCollection(
+          factory, resources, &fonts);
+      if (FAILED(result)) LOG(ERROR) << "Private font resources rejected: " << result;
+    }
+  };
+  static const base::NoDestructor<CachedPrivateCollection> cache(factory, root.value());
+  if (FAILED(cache->result)) return cache->result;
+  return cache->fonts.CopyTo(collection);
+}
 
