+    for(char c:text)if(!((c>='a'&&c<='z')||(c>='A'&&c<='Z')||(c>='0'&&c<='9')||c=='_'||c=='.'||c=='-'))return false;
+    return text[0]!='.'&&text[0]!='-'&&text[0]!='_';
+  };
+  for(size_t i=0;i<source_count;++i) {
