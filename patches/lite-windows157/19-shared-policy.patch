+        const auto& e=expected[index++];
+        equal &= name==e.name && lang==e.lang && local==e.local && first==e.first;
+      });
+    check(equal && index==std::size(expected),"cloak-reference-voices");
+  }
+
+
+
+
+
+
+
+
+
+
+
+
+
+
+  {
+    struct NativeVoiceFixture {
+      std::string name, lang, uri;
+      bool local, is_default;
+      bool operator==(const NativeVoiceFixture&) const = default;
+    };
+    const std::vector<NativeVoiceFixture> native{
+        {"Google US English", "en-us", "native:offline-us", true, false},
+        {"Not In Reference Inventory", "en-US", "native:unknown", false, false},
+        {"Google Deutsch", "de-DE", "native:de", false, true},
+        {"Google US English", "en-US", "native:remote-us", false, false},
+        {"Microsoft David - English (United States)", "en-US", "native:david", true, false}};
+    const auto before = native;
+    const auto select = [](bool windows, bool mac, std::string_view locale,
+                           bool local, const auto& voices) {
+      std::vector<size_t> indices;
+      ForEachNativeVoiceIntersection(windows, mac, locale, local, voices,
+          [&](size_t index) { indices.push_back(index); });
+      return indices;
+    };
+    const auto ordered = select(true, false, "en-US", true, native);
+    check(ordered == std::vector<size_t>({4, 2, 0, 3}), "voice-intersection-order");
+    check(native == before, "voice-intersection-preserves-input-fields");
+    check(select(true, false, "en-US", false, native) ==
+          std::vector<size_t>({2, 3}), "voice-intersection-real-local-flag");
+    check(ordered.size() == 4 &&
+          !native[ordered[0]].is_default && native[ordered[1]].is_default &&
+          native[ordered[2]].uri != native[ordered[3]].uri,
+          "voice-intersection-preserves-default-uri");
+    const std::vector<NativeVoiceFixture> unknown{
+        {"Uninstalled Reference Substitute", "en-US", "native:only", true, true}};
+    check(select(true, false, "en-US", true, unknown).empty(),
+          "voice-intersection-no-fabrication");
+    const std::vector<NativeVoiceFixture> empty;
+    check(select(true, false, "en-US", true, empty).empty(),
+          "voice-intersection-native-empty");
+    const std::vector<NativeVoiceFixture> remote_mac{
+        {"Samantha", "en-US", "native:remote-samantha", false, true}};
+    check(select(false, true, "en-US", false, remote_mac) ==
+          std::vector<size_t>({0}), "voice-intersection-native-remote-not-table-local");
+    check(select(false, false, "en-US", true, native) ==
+          std::vector<size_t>({0, 3}), "voice-intersection-linux-candidates");
+    check(select(true, false, "unknown-locale", true, native) == ordered,
+          "voice-intersection-locale-fallback");
+  }
+  std::printf("{\"checks\":%u,\"failures\":%u}\n",checks,failures);
+  return failures ? 1 : 0;
+}
+#if defined(UXR_SURFACE_GOLDEN_STANDALONE)
+int main() { return RunSurfaceGoldenTests(); }
+#endif
