+    {"apple", 18u, "metal-3"},
+    {"apple", 19u, "metal-3"},
+  };
+  if (index < 0) return std::nullopt;
+  for (const auto& profile : profiles)
+    if (profile.family == family && profile.index == static_cast<unsigned>(index))
+      return profile;
+  return std::nullopt;
+}
+inline bool UxrCloakGpuFeatureAllowedV1(
+    const UxrGpuProfileV1& profile, std::string_view name,
+    bool windows_modern = true) {
+  // Caller must intersect this policy with adapter.GetFeatures(). Unlike the
+  // observed closed-source path, no unsupported feature is ever manufactured.
+  struct Feature { std::string_view name; uint32_t native; };
+  static constexpr Feature features[] = {
+    {"core-features-and-limits", 1u},
+    {"depth-clip-control", 2u},
+    {"depth32float-stencil8", 3u},
+    {"texture-compression-bc", 4u},
+    {"texture-compression-bc-sliced-3d", 5u},
+    {"texture-compression-etc2", 6u},
+    {"texture-compression-astc", 7u},
+    {"texture-compression-astc-sliced-3d", 8u},
+    {"timestamp-query", 9u},
+    {"indirect-first-instance", 10u},
+    {"shader-f16", 11u},
+    {"rg11b10ufloat-renderable", 12u},
+    {"bgra8unorm-storage", 13u},
+    {"float32-filterable", 14u},
+    {"float32-blendable", 15u},
+    {"clip-distances", 16u},
+    {"dual-source-blending", 17u},
+    {"subgroups", 18u},
+    {"texture-formats-tier1", 19u},
+    {"texture-formats-tier2", 20u},
+    {"primitive-index", 21u},
+    {"texture-component-swizzle", 22u},
+    {"subgroup-size-control", 23u},
+    {"chromium-experimental-multi-draw-indirect", 327729u},
+    {"chromium-experimental-subgroup-matrix", 327732u},
+    {"chromium-experimental-sampling-resource-table", 327738u},
+    {"atomic-vec2u-min-max", 327739u},
+    {"texture-compression-unaligned", 327745u},
+    {"chromium-experimental-timestamp-query-inside-passes", 327683u},
+  };
+  uint32_t feature = 0;
+  for (const auto& item : features)
+    if (item.name == name) { feature = item.native; break; }
+  if (!feature) return false;
+  // The source constructor unconditionally added these names. The compatible
+  // variant only allows them if the real native set already contains them.
+  if (feature == 11 || feature == 17 || feature == 21 ||
+      feature == 19 || feature == 20) return true;
+  if (!profile.macos()) {
+    if ((feature == 18 || feature == 23) && profile.family == "intel" &&
+        profile.index < 18 && ((0x10e60u >> profile.index) & 1u)) return false;
+    if (feature == 23) {
+      const auto a = profile.architecture;
+      return !windows_modern || a == "gen-12lp" || a == "xe-lpg" ||
+          a == "pascal" || a == "turing" || a == "ampere" ||
+          a == "lovelace" || a == "blackwell";
+    }
+  }
+  if (feature >= 1 && feature < 16 && ((0x7b0fu >> (feature - 1)) & 1u))
+    return true;
+  if (profile.macos())
+    return feature >= 5 && feature < 24 && ((0x7f84fu >> (feature - 5)) & 1u);
+  return feature < 23 && ((0x7f0820u >> feature) & 1u);
+}
+struct UxrGpuLimitRuleV1 {
+  std::string_view name;
+  uint64_t windows_value;
+  uint64_t macos_value;
+  bool minimum;
+};
+inline std::optional<UxrGpuLimitRuleV1> UxrCloakGpuLimitRuleV1(
+    std::string_view name) {
+  static constexpr UxrGpuLimitRuleV1 limits[] = {
+    {"maxTextureDimension1D", 16384u, 16384u, false},
+    {"maxTextureDimension2D", 16384u, 16384u, false},
+    {"maxTextureDimension3D", 2048u, 2048u, false},
+    {"maxTextureArrayLayers", 2048u, 2048u, false},
+    {"maxBindGroups", 4u, 4u, false},
+    {"maxBindGroupsPlusVertexBuffers", 24u, 24u, false},
+    {"maxBindingsPerBindGroup", 1000u, 1000u, false},
+    {"maxDynamicUniformBuffersPerPipelineLayout", 10u, 10u, false},
+    {"maxDynamicStorageBuffersPerPipelineLayout", 8u, 8u, false},
+    {"maxSampledTexturesPerShaderStage", 48u, 48u, false},
+    {"maxSamplersPerShaderStage", 16u, 16u, false},
+    {"maxStorageBuffersPerShaderStage", 16u, 10u, false},
+    {"maxStorageTexturesPerShaderStage", 8u, 8u, false},
+    {"maxUniformBuffersPerShaderStage", 12u, 12u, false},
+    {"maxUniformBufferBindingSize", 65536u, 65536u, false},
+    {"maxStorageBufferBindingSize", 2147483644u, 4294967292u, false},
+    {"minUniformBufferOffsetAlignment", 256u, 256u, true},
+    {"minStorageBufferOffsetAlignment", 256u, 256u, true},
+    {"maxVertexBuffers", 8u, 8u, false},
+    {"maxBufferSize", 2147483648u, 4294967292u, false},
+    {"maxVertexAttributes", 30u, 30u, false},
+    {"maxVertexBufferArrayStride", 2048u, 2048u, false},
+    {"maxInterStageShaderVariables", 28u, 28u, false},
+    {"maxColorAttachments", 8u, 8u, false},
+    {"maxColorAttachmentBytesPerSample", 128u, 128u, false},
+    {"maxComputeWorkgroupStorageSize", 32768u, 32768u, false},
+    {"maxComputeInvocationsPerWorkgroup", 1024u, 1024u, false},
+    {"maxComputeWorkgroupSizeX", 1024u, 1024u, false},
+    {"maxComputeWorkgroupSizeY", 1024u, 1024u, false},
+    {"maxComputeWorkgroupSizeZ", 64u, 64u, false},
+    {"maxComputeWorkgroupsPerDimension", 65535u, 65535u, false},
+    {"maxImmediateSize", 64u, 64u, false},
+    {"maxStorageBuffersInVertexStage", 16u, 10u, false},
+    {"maxStorageTexturesInVertexStage", 8u, 8u, false},
+    {"maxStorageBuffersInFragmentStage", 16u, 10u, false},
+    {"maxStorageTexturesInFragmentStage", 8u, 8u, false},
+  };
+  for (const auto& limit : limits)
+    if (limit.name == name) return limit;
+  return std::nullopt;
+}
+inline uint64_t UxrRestrictGpuLimitV1(uint64_t actual, uint64_t target,
+                                    bool minimum) {
+  return minimum ? std::max(actual, target) : std::min(actual, target);
+}
+inline bool UxrGpuLimitRequestAllowedV1(uint64_t requested, uint64_t exposed,
+                                      bool minimum) {
+  return minimum ? requested >= exposed : requested <= exposed;
+}
+inline int UxrClampContextCapabilityV1(int actual, int requested) {
+  return requested > 0 ? std::min(actual, requested) : actual;
+}
