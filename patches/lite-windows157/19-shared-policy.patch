diff --git a/components/ungoogled/farble_seed.cc b/components/ungoogled/farble_seed.cc
new file mode 100644
--- /dev/null
+++ b/components/ungoogled/farble_seed.cc
@@ -0,0 +1,52 @@
+#include "components/ungoogled/farble_seed.h"
+
+#include <array>
+
+#include "base/containers/span.h"
+#include "base/hash/hash.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/uxr_config.h"
+
+namespace ungoogled {
+
+namespace {
+
+uint64_t GlobalSeed() {
+  const base::UxrConfig& config = base::UxrConfig::GetInstance();
+  const char* key = config.Get("uxr-fingerprint-seed").empty()
+                        ? "uxr-canvas-seed"
+                        : "uxr-fingerprint-seed";
+  uint64_t seed = 0;
+  if (!config.GetUint64(key, &seed))
+    return 0;
+  return seed;
+}
+
+}  // namespace
+
+uint64_t GetFarbleSeed64(std::string_view registrable_domain) {
+  const uint64_t global_seed = GlobalSeed();
+  const uint32_t dhash = base::PersistentHash(registrable_domain);
+  const uint32_t high = dhash + static_cast<uint32_t>(global_seed) - 1u;
+  // Preserve legacy 32-bit seeds without depending on host byte order.
+  const std::array<uint8_t, 4> bytes = {
+      static_cast<uint8_t>(high), static_cast<uint8_t>(high >> 8),
+      static_cast<uint8_t>(high >> 16), static_cast<uint8_t>(high >> 24)};
+  const uint32_t low = base::PersistentHash(base::span(bytes));
+  const uint64_t legacy = (static_cast<uint64_t>(high) << 32) ^ low ^
+                         (static_cast<uint64_t>(
+                              static_cast<uint32_t>(global_seed)) << 16);
+  // The odd multiplier retains every upper seed bit, including bit 63.
+  return legacy ^ ((global_seed >> 32) * 0x9e3779b97f4a7c15ULL);
+}
+
+std::string GetFarbleSeedString(std::string_view registrable_domain) {
+  return base::NumberToString(GetFarbleSeed64(registrable_domain));
+}
+
+bool FingerprintNoiseEnabled() {
+  // Configuration can be installed after the renderer starts.
+  return !base::UxrConfig::GetInstance().Has("uxr-disable-fingerprint-noise");
+}
+
+}  // namespace ungoogled
diff --git a/components/ungoogled/farble_seed.h b/components/ungoogled/farble_seed.h
new file mode 100644
--- /dev/null
+++ b/components/ungoogled/farble_seed.h
@@ -0,0 +1,34 @@
+#ifndef COMPONENTS_UNGOOGLED_FARBLE_SEED_H_
+#define COMPONENTS_UNGOOGLED_FARBLE_SEED_H_
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+
+#include "base/component_export.h"
+
+namespace ungoogled {
+
+// Returns a deterministic per-site seed using the full unsigned 64-bit
+// uxr-fingerprint-seed, with an empty/missing key falling back to uxr-canvas-seed.
+// Invalid decimal values map to zero, as in persona selection. Legacy uint32
+// seeds retain their little-endian mapping; upper seed bits are also mixed.
+// Configuration is read per call so renderer initialization cannot cache a
+// pre-configuration seed. Registrable domains use stable base::PersistentHash.
+COMPONENT_EXPORT(UNGOOGLED)
+uint64_t GetFarbleSeed64(std::string_view registrable_domain);
+
+// Decimal-ASCII rendering of GetFarbleSeed64, for surfaces that concatenate the
+// seed into std::hash<std::string> per-pixel keys.
+COMPONENT_EXPORT(UNGOOGLED)
+std::string GetFarbleSeedString(std::string_view registrable_domain);
+
+// Noise policy for consumers; it does not implement a rendering mechanism.
+// Presence of uxr-disable-fingerprint-noise disables noise, independent of
+// identity selection. Read per call to honor renderer configuration delivery.
+COMPONENT_EXPORT(UNGOOGLED)
+bool FingerprintNoiseEnabled();
+
+}  // namespace ungoogled
+
+#endif  // COMPONENTS_UNGOOGLED_FARBLE_SEED_H_
