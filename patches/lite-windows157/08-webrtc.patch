+  void Start(const webrtc::SocketAddress& address,
+             int family,
+             absl::AnyInvocable<void()> callback) override {
+    CHECK(!started_);
+    started_ = true;
+    if (native_ && !IsMdnsName(address)) {
+      native_started_ = true;
+      if (family == AF_UNSPEC)
+        native_->Start(address, std::move(callback));
+      else
+        native_->Start(address, family, std::move(callback));
+      return;
+    }
+    // Preserve asynchronous resolver semantics, including cancellation on
+    // delete.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(
+                       [](base::WeakPtr<DocumentDnsResolver> self,
+                          absl::AnyInvocable<void()> callback) {
+                         if (self)
+                           callback();
+                       },
+                       weak_factory_.GetWeakPtr(), std::move(callback)));
+  }
+
+  const webrtc::AsyncDnsResolverResult& result() const override {
+    return native_started_ ? native_->result() : *this;
+  }
+  bool GetResolvedAddress(int, webrtc::SocketAddress*) const override {
+    return false;
+  }
+  int GetError() const override { return EHOSTUNREACH; }
+
+ private:
+  std::unique_ptr<webrtc::AsyncDnsResolverInterface> native_;
+  bool started_ = false;
+  bool native_started_ = false;
+  base::WeakPtrFactory<DocumentDnsResolver> weak_factory_{this};
+};
