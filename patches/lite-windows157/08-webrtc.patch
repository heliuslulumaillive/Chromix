+String RTCPeerConnection::RestoreFingerprintLocalSdp(const String& sdp) const {
+  const std::string ip = FingerprintWebRtcIp();
+  if (ip.empty() || sdp.empty())
+    return sdp;
+  const std::string shown = sdp.Utf8();
+  for (const String* native : {&last_offer_, &last_answer_,
+                               &fingerprint_pending_local_sdp_,
+                               &fingerprint_current_local_sdp_}) {
+    if (!native->empty() && RewriteFingerprintSdp(native->Utf8(), ip) == shown)
+      return *native;
+  }
+  // Caller-edited SDP keeps native validation; never guess which real address
+  // an arbitrary replacement should map to.
+  return sdp;
+}
