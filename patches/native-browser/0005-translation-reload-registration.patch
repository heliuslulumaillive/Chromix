 void ContentTranslateDriver::InitiateTranslation(const std::string& page_lang,
                                                  int attempt) {
+  // A cached script can be ready before this document's agent is registered.
+  // Sending it to the previous page leaves translation_pending stuck. The
+  // current page's RegisterPage() binds its agent and initiates translation.
+  if (web_contents()->GetPrimaryMainFrame()->GetPageUkmSourceId() !=
+      last_registered_page_id_) {
+    return;
+  }
+
   if (translate_manager_->GetLanguageState()->translation_pending())
     return;
 
