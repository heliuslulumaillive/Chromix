+  parent.rect = gfx::Rect(1920, 1080);
+  parent.device_scale_factor = 1.25f;
+  VisualProperties properties;
+  properties.screen_infos = display::ScreenInfos(native);
+  properties.emulated_screen_infos = display::ScreenInfos(parent);
