+      params, mojom::blink::DeviceEmulationCacheBehavior::kClearCache);
+  check(true);
+  widget->DisableDeviceEmulation();
+  check(false);
+  widget->EnableDeviceEmulation(
+      params, mojom::blink::DeviceEmulationCacheBehavior::kClearCache);
+  check(true);
