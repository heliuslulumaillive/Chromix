+  properties.css_zoom_factor = 2.f;
+  properties.new_size_device_px = gfx::Size(840, 420);
+  properties.compositor_viewport_pixel_rect = gfx::Rect(840, 420);
+  check(420, 210, 4.f, 1.f);
+
+  properties.css_zoom_factor = 1.f;
+  properties.screen_infos.mutable_current().device_scale_factor = 2.f;
