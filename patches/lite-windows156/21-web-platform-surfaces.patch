+TEST_F(WebFrameWidgetImplRemoteFrameSimTest,
+       EmulatedScreenPreservesNativeLayoutAndInputScale) {
+  auto* widget = LocalFrameRootWidget();
+  display::ScreenInfo native_screen;
+  native_screen.rect = gfx::Rect(800, 600);
+  native_screen.available_rect = native_screen.rect;
+  VisualProperties properties;
+  properties.screen_infos = display::ScreenInfos(native_screen);
+  display::ScreenInfo emulated_screen = native_screen;
+  emulated_screen.rect = gfx::Rect(1920, 1080);
+  emulated_screen.available_rect = gfx::Rect(1920, 1040);
+  emulated_screen.device_scale_factor = 1.25f;
+  emulated_screen.orientation_type =
+      display::mojom::ScreenOrientation::kPortraitPrimary;
+  emulated_screen.orientation_angle = 90;
+  properties.emulated_screen_infos = display::ScreenInfos(emulated_screen);
+  properties.new_size_device_px = gfx::Size(300, 150);
+  properties.visible_viewport_size_device_px = gfx::Size(800, 600);
+  properties.compositor_viewport_pixel_rect = gfx::Rect(300, 150);
+  auto check = [&](int width, int height, float dpr, float native_dsf) {
+    widget->ApplyVisualProperties(properties);
+    widget->UpdateAllLifecyclePhases(DocumentUpdateReason::kTest);
+    auto* window = LocalFrameRoot().GetFrame()->DomWindow();
+    EXPECT_EQ(width, window->innerWidth());
+    EXPECT_EQ(height, window->innerHeight());
+    EXPECT_FLOAT_EQ(dpr, window->devicePixelRatio());
+    EXPECT_FLOAT_EQ(native_dsf,
+                    widget->LayerTreeHostForTesting()->device_scale_factor());
