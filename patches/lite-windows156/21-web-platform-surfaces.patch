+// Canonical SFNT table content, independent of file/TTC directory offsets.
+// Exclude DSIG (container signature) and zero head.checkSumAdjustment, which
+// changes when a collection face is repacked. All rendering tables are retained.
+String ComputePlatformFontTableHash(const SkTypeface& typeface) {
+  const int count = typeface.countTables();
+  if (count <= 0 || count > 512) {
+    return String();
+  }
+  std::vector<SkFontTableTag> tags(count);
+  if (typeface.readTableTags(SkSpan<SkFontTableTag>(tags.data(), tags.size())) !=
+      count) {
+    return String();
+  }
+  std::sort(tags.begin(), tags.end());
+  if (std::adjacent_find(tags.begin(), tags.end()) != tags.end()) {
+    return String();
+  }
+  Digestor digest(kHashAlgorithmSha256);
+  constexpr char kPrefix[] = "chromix-font-tables-v1";
+  if (!digest.Update(base::as_byte_span(kPrefix))) {
+    return String();
+  }
+  size_t total = 0;
+  for (SkFontTableTag tag : tags) {
+    if (tag == SkSetFourByteTag('D', 'S', 'I', 'G')) {
+      continue;
+    }
+    const size_t size = typeface.getTableSize(tag);
+    if (!size || size > 64 * 1024 * 1024 ||
+        total > 128 * 1024 * 1024 - size) {
+      return String();
+    }
+    total += size;
+    std::vector<uint8_t> bytes(size);
+    if (typeface.getTableData(tag, 0, size, bytes.data()) != size) {
+      return String();
+    }
+    if (tag == SkSetFourByteTag('h', 'e', 'a', 'd')) {
+      if (size < 12) {
+        return String();
+      }
+      std::fill(bytes.begin() + 8, bytes.begin() + 12, 0);
+    }
+    const auto encoded_tag = base::U32ToBigEndian(tag);
+    const auto encoded_size = base::U64ToBigEndian(size);
+    if (!digest.Update(encoded_tag) || !digest.Update(encoded_size) ||
+        !digest.Update(bytes)) {
+      return String();
+    }
+  }
+  DigestValue result;
+  return digest.Finish(result)
+             ? String::FromUtf8(base::HexEncodeLower(result))
+             : String();
+}
