+        widget->BlinkSpaceToDIPs(gfx::RectF(37 * native_dsf, 19 * native_dsf,
+                                            50 * native_dsf, 20 * native_dsf)));
+  };
+  check(300, 150, 1.25f, 1.f);
+  EXPECT_EQ(emulated_screen.rect, widget->GetScreenInfo().rect);
+  EXPECT_EQ(emulated_screen.available_rect,
+            widget->GetScreenInfo().available_rect);
+  EXPECT_EQ(emulated_screen.orientation_type,
+            widget->GetScreenInfo().orientation_type);
+  EXPECT_EQ(emulated_screen.orientation_angle,
+            widget->GetScreenInfo().orientation_angle);
+
+  properties.emulated_screen_infos->mutable_current().device_scale_factor = 2.f;
+  check(300, 150, 2.f, 1.f);
