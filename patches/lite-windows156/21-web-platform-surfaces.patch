+  // Opt-in v1 shares the same presentation bucket with navigation/subresource
+  // Client Hints and every navigator mixin. Legacy flags retain legacy behavior.
+  const auto& snapshot = base::UxrConfig::GetInstance();
+  std::string mode = snapshot.Get("uxr-memory-mode");
+  std::string text = snapshot.Get("uxr-device-memory");
+  if (mode.empty() && base::CommandLine::InitializedForCurrentProcess()) {
+    const auto* command = base::CommandLine::ForCurrentProcess();
+    mode = command->GetSwitchValueASCII("uxr-memory-mode");
+    text = command->GetSwitchValueASCII("uxr-device-memory");
+  }
+  if (mode == "custom") {
+    double value = 0;
+    if (base::StringToDouble(text, &value) && std::isfinite(value) &&
+        value >= 0.25 && value <= 32) {
+      constexpr double buckets[] = {0.25, 0.5, 1, 2, 4, 8, 16, 32};
+      double best = buckets[0];
+      for (const double bucket : buckets)
+        if (std::abs(bucket - value) < std::abs(best - value))
+          best = bucket;
+      return static_cast<float>(best);
+    }
+  }
