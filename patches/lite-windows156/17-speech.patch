+inline size_t VoiceGroup(std::span<const VoiceLocale> locales, std::string_view locale) {
+  for (const auto& row : locales)
+    if (AsciiEqual(row.locale, locale)) return row.group;
+  for (const auto& row : locales)
+    if (AsciiEqual(row.locale, "en-US")) return row.group;
+  return 0;
+}
+template <class Callback>
+inline void ForEachCloakVoice(bool windows, bool mac, std::string_view locale,
+                             bool sapi, Callback callback) {
+  bool first = true;
+  const auto emit = [&](const VoiceReference& row, bool local) {
+    callback(row.name, row.lang, local, first);
+    first = false;
+  };
+  if (!windows && !mac) {
+    for (size_t index : {size_t{1}, size_t{2}, size_t{3}})
+      emit(kGoogleVoices[index], false);
+    return;
+  }
+  if (mac) {
+    const auto group = VoiceGroup(kMacVoiceLocales, locale);
+    for (const auto index : kMacVoiceGroups[group]) {
+      const auto& row = kMacVoices[index];
+      emit(row, row.local);
+    }
+  } else {
+    if (sapi) {
+      const auto group = VoiceGroup(kWindowsVoiceLocales, locale);
+      for (const auto index : kWindowsVoiceGroups[group])
+        emit(kWindowsVoices[index], true);
+    }
+    for (const auto& row : kGoogleVoices)
+      emit(row, false);
+  }
+}
+// compatible-v1: reference metadata supplies preference order, never an engine.
+// Native entries own their names/languages for the duration of this synchronous
+// selection. Callback receives only original native indices, each at most once.
+template <class NativeVoices, class Callback>
+inline void ForEachNativeVoiceIntersection(
+    bool windows, bool mac, std::string_view locale, bool include_local,
+    const NativeVoices& native, Callback callback) {
+  std::vector<uint8_t> selected(native.size(), 0);
+  ForEachCloakVoice(windows, mac, locale, true,
+      [&](std::string_view name, std::string_view lang, bool, bool) {
+        for (size_t i = 0; i < native.size(); ++i) {
+          const auto& voice = native[i];
+          if (selected[i] || (!include_local && voice.local) ||
+              voice.name != name || !AsciiEqual(voice.lang, lang))
+            continue;
+          selected[i] = 1;
+          callback(i);
+        }
+      });
+}
+}  // namespace base::uxr_surface_v1
