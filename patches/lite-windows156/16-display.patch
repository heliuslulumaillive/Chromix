new file mode 100644
--- /dev/null
+++ b/base/uxr_headless_screen.h
@@ -0,0 +1,44 @@
+// Copyright 2026. Use of this source is governed by a BSD-style license.
+#ifndef BASE_UXR_HEADLESS_SCREEN_H_
+#define BASE_UXR_HEADLESS_SCREEN_H_
+
+#include <cmath>
+#include <optional>
+
+namespace base {
+
+// Headless --screen-info consumes physical pixels; the public fingerprint
+// display dimensions are CSS pixels. This describes one primary display.
+struct UxrHeadlessScreenInfo {
+  int pixel_width;
+  int pixel_height;
+  int work_area_right;
+  int work_area_bottom;
+  double device_pixel_ratio;
+};
+
+inline std::optional<UxrHeadlessScreenInfo> MakeUxrHeadlessScreenInfo(
+    int width, int height, int available_width, int available_height,
+    double scale) {
+  // Preserve the existing display bounds. Chromium 155's native screen-info
+  // parser supports DPR >= 0.5; the older virtual-only 0.25 range is unchanged.
+  if (width < 1 || height < 1 || width > 32768 || height > 32768 ||
+      available_width < 0 || available_height < 0 ||
+      available_width > width || available_height > height ||
+      !std::isfinite(scale) || scale < 0.5 || scale > 8.0) {
+    return std::nullopt;
+  }
+  const int pixel_width = static_cast<int>(std::ceil(width * scale));
+  const int pixel_height = static_cast<int>(std::ceil(height * scale));
+  const int available_pixel_width =
+      static_cast<int>(std::ceil(available_width * scale));
+  const int available_pixel_height =
+      static_cast<int>(std::ceil(available_height * scale));
+  return UxrHeadlessScreenInfo{pixel_width, pixel_height,
+                               pixel_width - available_pixel_width,
+                               pixel_height - available_pixel_height, scale};
+}
+
+}  // namespace base
+
+#endif  // BASE_UXR_HEADLESS_SCREEN_H_
