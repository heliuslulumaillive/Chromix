diff --git a/base/uxr_audio_defaults.h b/base/uxr_audio_defaults.h
new file mode 100644
--- /dev/null
+++ b/base/uxr_audio_defaults.h
@@ -0,0 +1,45 @@
+// Copyright 2026. Explicit environment defaults for the native audio pipeline.
+#ifndef BASE_UXR_AUDIO_DEFAULTS_H_
+#define BASE_UXR_AUDIO_DEFAULTS_H_
+
+#include <algorithm>
+#include <cstdint>
+#include <optional>
+
+namespace base::uxr_audio_defaults_v1 {
+
+// Leave validation to the native AudioContext path. In particular, an invalid
+// explicit script value must not be replaced by a valid environment default.
+inline std::optional<float> ResolveSampleRate(
+    std::optional<float> explicit_rate,
+    std::optional<float> environment_rate) {
+  return explicit_rate.has_value() ? explicit_rate : environment_rate;
+}
+
+// A limit can only reduce the capability reported by the selected backend.
+inline uint32_t ChannelCapacity(
+    uint32_t native_capacity,
+    std::optional<uint32_t> environment_limit) {
+  return environment_limit.has_value()
+      ? std::min(native_capacity, environment_limit.value())
+      : native_capacity;
+}
+
+// Call only when a channel limit/default was explicitly configured.
+// An explicit default is an exact request; unsupported values never clamp.
+// With a limit alone, the native initial count is reduced to the allowed cap.
+inline std::optional<uint32_t> InitialChannelCount(
+    uint32_t native_initial_count,
+    uint32_t actual_capacity,
+    std::optional<uint32_t> environment_default) {
+  const uint32_t desired = environment_default.value_or(
+      std::min(native_initial_count, actual_capacity));
+  if (desired == 0 || desired > actual_capacity) {
+    return std::nullopt;
+  }
+  return desired;
+}
+
+}  // namespace base::uxr_audio_defaults_v1
+
+#endif  // BASE_UXR_AUDIO_DEFAULTS_H_
diff --git a/base/uxr_audio_defaults_tests.cc b/base/uxr_audio_defaults_tests.cc
new file mode 100644
--- /dev/null
+++ b/base/uxr_audio_defaults_tests.cc
@@ -0,0 +1,71 @@
+// Copyright 2026. Native pipeline policy tests; not a hardware/DSP simulation.
+#include "base/uxr_audio_defaults.h"
+
+#include <cmath>
+#include <cstdio>
+#include <limits>
+#include <optional>
+
+int RunAudioDefaultsTests() {
+  using namespace base::uxr_audio_defaults_v1;
+  unsigned checks = 0;
+  unsigned failures = 0;
+  const auto check = [&](bool actual, const char* label) {
+    ++checks;
+    if (!actual) {
+      ++failures;
+      std::printf("FAIL audio-defaults: %s\n", label);
+    }
+  };
+
+  // Historical Shard native/donor/custom probes observed 48000/44100/32000.
+  // Unset stays nullopt, so the real backend, not this helper, supplies 48000.
+  check(!ResolveSampleRate({}, {}).has_value(), "unset keeps native backend");
+  check(ResolveSampleRate({}, 44100) == 44100, "donor default 44100");
+  check(ResolveSampleRate({}, 32000) == 32000, "custom default 32000");
+  check(ResolveSampleRate(48000, 32000) == 48000, "explicit 48000 wins");
+  check(ResolveSampleRate(22050, 44100) == 22050, "explicit 22050 wins");
+  check(ResolveSampleRate(0, 44100) == 0, "invalid explicit zero not hidden");
+  check(ResolveSampleRate(2999, 44100) == 2999, "invalid explicit low not hidden");
+  check(ResolveSampleRate(768001, 44100) == 768001, "invalid explicit high not hidden");
+  check(std::isnan(ResolveSampleRate(
+            std::numeric_limits<float>::quiet_NaN(), 44100).value()),
+        "explicit NaN not replaced");
+  check(ResolveSampleRate({}, 3000) == 3000, "native lower bound forwarded");
+  check(ResolveSampleRate({}, 768000) == 768000, "native upper bound forwarded");
+
+  // Unlike the original Shard getter, a requested six-channel cap on a
+  // two-channel backend must not advertise six hardware channels.
+  check(ChannelCapacity(2, {}) == 2, "native stereo capacity");
+  check(ChannelCapacity(2, 6) == 2, "cap cannot invent six channels");
+  check(ChannelCapacity(8, 6) == 6, "six-channel cap on capable backend");
+  check(ChannelCapacity(2, 1) == 1, "mono cap");
+  check(ChannelCapacity(0, 6) == 0, "unavailable backend stays unavailable");
+  check(ChannelCapacity(32, 32) == 32, "maximum supported policy bound");
+  check(ChannelCapacity(8, {}) == 8, "unset cap preserves backend capacity");
+
+  check(InitialChannelCount(2, 2, {}) == 2, "native default stereo");
+  check(InitialChannelCount(2, 1, {}) == 1, "cap alone selects actual mono");
+  check(InitialChannelCount(2, 6, {}) == 2, "cap alone does not expand default");
+  check(InitialChannelCount(2, 2, 1) == 1, "exact mono default");
+  check(InitialChannelCount(2, 8, 6) == 6, "exact six on capable backend");
+  check(!InitialChannelCount(2, 2, 6).has_value(),
+        "exact six rejected on stereo backend");
+  check(!InitialChannelCount(2, 1, 2).has_value(),
+        "exact two rejected by mono cap");
+  check(!InitialChannelCount(2, 0, {}).has_value(),
+        "zero-capacity configured context rejected");
+  check(!InitialChannelCount(2, 2, 0).has_value(),
+        "invalid zero default rejected defensively");
+  check(InitialChannelCount(2, 32, 32) == 32, "exact maximum default");
+
+  std::printf("{\"audio_default_checks\":%u,\"failures\":%u}\n",
+              checks, failures);
+  return failures ? 1 : 0;
+}
+
+#ifdef UXR_AUDIO_DEFAULTS_STANDALONE
+int main() {
+  return RunAudioDefaultsTests();
+}
+#endif
