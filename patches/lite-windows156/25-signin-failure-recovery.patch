+void ProcessDiceHeaderDelegateImpl::HandleNoAuthorizationCode(
+    const std::string& email) {
+  DiceTabHelper* helper = GetDiceTabHelperFromWebContents(web_contents_.get());
+  if (!is_chrome_signin_tab_ || !helper ||
+      !helper->IsChromeSigninInProgress()) {
+    return;
+  }
+
+  // Profile-picker error recovery can destroy the profile and its DICE
+  // handler. Defer UI work until the response/session stack has unwound.
+  // Do not retain this delegate or a raw Profile across that task.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](base::WeakPtr<content::WebContents> contents, uint64_t generation,
+             const std::string& email) {
+            DiceTabHelper* helper =
+                GetDiceTabHelperFromWebContents(contents.get());
+            if (!helper || !helper->IsChromeSigninInProgress() ||
+                helper->signin_flow_generation() != generation) {
+              return;
+            }
+            // Rebind to the live flow. Completion resets its generation, so
+            // duplicate errors, cancellation and a newer retry are safe.
+            auto delegate = ProcessDiceHeaderDelegateImpl::Create(contents.get());
+            delegate->HandleTokenExchangeFailure(
+                email, GoogleServiceAuthError::FromServiceError(
+                           "Google did not provide the authorization required "
+                           "for browser sign-in."));
+          },
+          web_contents_, helper->signin_flow_generation(), email));
+}
+
 signin_metrics::AccessPoint ProcessDiceHeaderDelegateImpl::GetAccessPoint() {
   return access_point_;
 }
