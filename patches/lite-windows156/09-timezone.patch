+bool TimeZoneController::SetDefaultTimeZone(const String& timezone_id) {
+  DCHECK(IsMainThread());
+  if (timezone_id.empty())
+    return false;
+
+  base::AutoLock locker(instance().lock_);
+  if (HasTimeZoneOverride()) {
+    // Validate the restore target without disturbing the active override.
+    std::unique_ptr<icu::TimeZone> timezone(icu::TimeZone::createTimeZone(
+        icu::UnicodeString(timezone_id.Ascii().data(), -1, US_INV)));
+    CHECK(timezone);
+    if (*timezone == icu::TimeZone::getUnknown())
+      return false;
+  } else if (!SetIcuTimeZoneAndNotifyV8(timezone_id)) {
+    return false;
+  }
+  instance().host_timezone_id_ = timezone_id;
