+void RenderThreadImpl::SetUxrConfig(
+    const base::flat_map<std::string, std::string>& config,
+    uint32_t schema_version) {
+  // Persona config arrives here over IPC (not the command line), so it never
+  // appears in /proc/<renderer>/cmdline. Stored once in the process-global.
+  auto& snapshot = base::UxrConfig::GetInstance();
+  CHECK(snapshot.SetAll(config, schema_version)) << snapshot.ValidationError();
+  const std::string timezone = snapshot.Get("uxr-timezone");
+  if (!timezone.empty()) {
+    CHECK(blink::SetRendererDefaultTimeZone(blink::WebString::FromUtf8(timezone)))
+        << "Invalid launch timezone: " << timezone;
+  }
+}
