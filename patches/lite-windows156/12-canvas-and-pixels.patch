+uint32_t RotateLeft(uint32_t value, unsigned count) {
+  return (value << count) | (value >> (32 - count));
+}
+
+uint32_t Fmix32(uint32_t value) {
+  value ^= value >> 16;
+  value *= 0x85ebca6bu;
+  value ^= value >> 13;
+  value *= 0xc2b2ae35u;
+  return value ^ (value >> 16);
+}
