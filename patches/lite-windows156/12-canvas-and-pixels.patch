+// Properties of the production implementation; no duplicate noise algorithm.
+#ifndef BASE_UXR_PIXEL_SEMANTIC_PROPERTIES_H_
+#define BASE_UXR_PIXEL_SEMANTIC_PROPERTIES_H_
+#include <algorithm>
+#include <array>
