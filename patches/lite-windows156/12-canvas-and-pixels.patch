+// Copyright 2026.
+#ifndef BASE_UXR_PIXEL_NOISE_H_
+#define BASE_UXR_PIXEL_NOISE_H_
+
+#include <cstdint>
+
+namespace base {
+
+inline uint32_t UxrPixelNoiseSeed(uint64_t seed) {
+  // SplitMix64's finalizer folds high bits without changing legacy 32-bit seeds.
+  uint64_t high = seed >> 32;
+  high = (high ^ (high >> 30)) * 0xbf58476d1ce4e5b9ULL;
+  high = (high ^ (high >> 27)) * 0x94d049bb133111ebULL;
+  high ^= high >> 31;
+  return static_cast<uint32_t>(seed) ^ static_cast<uint32_t>(high) ^
+         static_cast<uint32_t>(high >> 32);
+}
+
+// Coordinates are absolute; channel is logical RGB, independent of byte order.
+// Callers skip transparent pixels and preserve alpha.
+inline uint8_t UxrNoiseChannel(uint32_t seed,
+                               uint32_t x,
+                               uint32_t y,
+                               uint32_t channel,
+                               uint8_t value) {
+  uint32_t z = seed ^ (x * 374761393u) ^ (y * 668265263u) ^
+               (channel * 0x9e3779b9u) ^ (uint32_t{value} * 2654435761u);
+  z ^= z >> 16;
+  z *= 0x85ebca6bu;
+  z ^= z >> 13;
+  z *= 0xc2b2ae35u;
+  z ^= z >> 16;
+  const int result = static_cast<int>(value) + ((z & 1u) ? 1 : -1);
+  return static_cast<uint8_t>(result < 0 ? 0 : (result > 255 ? 255 : result));
+}
+
+}  // namespace base
+
+#endif  // BASE_UXR_PIXEL_NOISE_H_
