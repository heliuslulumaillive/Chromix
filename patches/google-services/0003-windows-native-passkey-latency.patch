+// Capture the native boundary, without signing or choosing an authenticator.
+class NativePickerRecordingApi : public FakeWinWebAuthnApi {
+ public:
+  HRESULT AuthenticatorGetAssertion(
+      HWND,
+      LPCWSTR,
+      PCWEBAUTHN_CLIENT_DATA,
+      PCWEBAUTHN_AUTHENTICATOR_GET_ASSERTION_OPTIONS options,
+      PWEBAUTHN_ASSERTION*) override {
+    legacy_count = options->CredentialList.cCredentials;
+    for (DWORD i = 0; i < options->pAllowCredentialList->cCredentials; ++i) {
+      const auto* credential =
+          UNSAFE_TODO(options->pAllowCredentialList->ppCredentials[i]);
+      const auto id = ToIdSpan(*credential);
+      ids.emplace_back(id.begin(), id.end());
+      transports.push_back(credential->dwTransports);
+    }
+    for (DWORD i = 0; i < options->cCredentialHints; ++i) {
+      hints.emplace_back(UNSAFE_TODO(options->ppwszCredentialHints[i]));
+    }
+    attachment = options->dwAuthenticatorAttachment;
+    verification = options->dwUserVerificationRequirement;
+    private_mode = options->bBrowserInPrivateMode;
+    autofill = options->bAutoFill;
+    flags = options->dwFlags;
+    timeout = options->dwTimeoutMilliseconds;
+    return NTE_NOT_FOUND;
+  }
+
+  DWORD legacy_count = 0;
+  std::vector<std::vector<uint8_t>> ids;
+  std::vector<DWORD> transports;
+  std::vector<std::wstring> hints;
+  DWORD attachment = 0;
+  DWORD verification = 0;
+  BOOL private_mode = TRUE;
+  BOOL autofill = TRUE;
+  DWORD flags = 0;
+  DWORD timeout = 0;
+};
+
+TEST_F(WinAuthenticatorTest, NativePickerSkipPreservesAssertionOptions) {
+  base::test::ScopedFeatureList feature;
+  feature.InitAndEnableFeature(
+      kWebAuthnWinNativeModalSkipCredentialEnumeration);
+  auto api = std::make_unique<NativePickerRecordingApi>();
+  api->set_version(WEBAUTHN_API_VERSION_9);
+  api->set_supports_silent_discovery(true);
+  std::unique_ptr<FidoAuthenticator> authenticator =
+      std::make_unique<WinWebAuthnApiAuthenticator>(nullptr, api.get());
+  CtapGetAssertionRequest request(kRpId, "{}");
+  request.allow_list.emplace_back(
+      CredentialType::kPublicKey, kCredentialId,
+      base::flat_set<FidoTransportProtocol>{FidoTransportProtocol::kInternal});
+  request.allow_list.emplace_back(
+      CredentialType::kPublicKey, kCredentialId2,
+      base::flat_set<FidoTransportProtocol>{
+          FidoTransportProtocol::kUsbHumanInterfaceDevice,
+          FidoTransportProtocol::kHybrid});
+  request.user_verification = UserVerificationRequirement::kRequired;
+  CtapGetAssertionOptions options;
+  options.skip_windows_credential_enumeration = true;
+  options.hints = {blink::mojom::Hint::HYBRID,
+                   blink::mojom::Hint::SECURITY_KEY};
+  GetCredentialFuture metadata;
+  authenticator->GetPlatformCredentialInfoForRequest(request, options,
+                                                     metadata.GetCallback());
+  ASSERT_TRUE(metadata.Wait());
+  ASSERT_EQ(api->last_get_credentials_options(), nullptr);
+  GetAssertionFuture assertion;
+  authenticator->GetAssertion(request, options, assertion.GetCallback());
+  ASSERT_TRUE(assertion.Wait());
+  EXPECT_EQ(api->legacy_count, 2u);
+  EXPECT_THAT(api->ids, testing::ElementsAre(kCredentialId, kCredentialId2));
+  EXPECT_THAT(api->transports,
+              testing::ElementsAre(WEBAUTHN_CTAP_TRANSPORT_INTERNAL,
+                                   WEBAUTHN_CTAP_TRANSPORT_USB |
+                                       WEBAUTHN_CTAP_TRANSPORT_HYBRID));
+  EXPECT_THAT(api->hints, testing::ElementsAre(L"hybrid", L"security-key"));
+  EXPECT_EQ(api->attachment, WEBAUTHN_AUTHENTICATOR_ATTACHMENT_ANY);
+  EXPECT_EQ(api->verification, WEBAUTHN_USER_VERIFICATION_REQUIREMENT_REQUIRED);
+  EXPECT_FALSE(api->private_mode);
+  EXPECT_FALSE(api->autofill);
+  EXPECT_EQ(api->flags, 0u);
+  EXPECT_EQ(api->timeout, 300000u);
 }
 
