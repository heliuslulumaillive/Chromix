+  content::AuthenticatorCommonImpl::ConfigureWindowsNativeCredentialEnumeration(
+      RequestSource::kWebAuthentication, Mediation::MODAL, factory,
+      /*additional_platform_discoveries=*/{}, request, options);
+  EXPECT_FALSE(options.skip_windows_credential_enumeration);
