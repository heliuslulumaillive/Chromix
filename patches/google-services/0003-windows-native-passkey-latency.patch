+TEST(WinNativeCredentialEnumerationCommonTest, RejectsOtherRequestModes) {
+  auto request = MakeAllowedRequest();
+  device::CtapGetAssertionOptions options;
+  device::FidoDiscoveryFactory factory;
+  factory.set_allow_win_native_credential_enumeration_skip(true);
+  for (const auto mediation :
+       {Mediation::CONDITIONAL, Mediation::AMBIENT, Mediation::IMMEDIATE}) {
+    options.skip_windows_credential_enumeration = true;
+    content::AuthenticatorCommonImpl::
+        ConfigureWindowsNativeCredentialEnumeration(
+            RequestSource::kWebAuthentication, mediation, factory,
+            /*additional_platform_discoveries=*/{}, request, options);
+    EXPECT_FALSE(options.skip_windows_credential_enumeration);
+  }
+  for (const auto source :
+       {RequestSource::kSecurePaymentConfirmation, RequestSource::kInternal}) {
+    options.skip_windows_credential_enumeration = true;
+    content::AuthenticatorCommonImpl::
+        ConfigureWindowsNativeCredentialEnumeration(
+            source, Mediation::MODAL, factory,
+            /*additional_platform_discoveries=*/{}, request, options);
+    EXPECT_FALSE(options.skip_windows_credential_enumeration);
+  }
+}
