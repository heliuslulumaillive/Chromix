+TEST(WinNativeCredentialEnumerationCommonTest, PreservesRequestAndOptions) {
+  auto request = MakeAllowedRequest();
+  const auto original_list = request.allow_list;
+  device::CtapGetAssertionOptions options;
+  device::FidoDiscoveryFactory factory;
+  factory.set_allow_win_native_credential_enumeration_skip(true);
+  options.is_off_the_record_context = false;
+  options.hints = {blink::mojom::Hint::HYBRID};
+  content::AuthenticatorCommonImpl::ConfigureWindowsNativeCredentialEnumeration(
+      RequestSource::kWebAuthentication, Mediation::MODAL, factory,
+      /*additional_platform_discoveries=*/{}, request, options);
+  EXPECT_TRUE(options.skip_windows_credential_enumeration);
+  EXPECT_EQ(request.allow_list, original_list);
+  EXPECT_FALSE(options.is_off_the_record_context);
+  EXPECT_EQ(options.hints, std::vector{blink::mojom::Hint::HYBRID});
+
+  for (int rejected_case = 0; rejected_case < 4; ++rejected_case) {
+    SCOPED_TRACE(rejected_case);
+    auto current_request = request;
+    if (rejected_case == 3) {
+      current_request.allow_list.clear();
+    }
+    TestOverrideDiscoveryFactory overridden_factory;
+    device::FidoDiscoveryFactory& current_factory =
+        rejected_case == 1 ? overridden_factory : factory;
+    current_factory.set_allow_win_native_credential_enumeration_skip(
+        rejected_case != 0);
+    std::vector<std::unique_ptr<device::FidoDiscoveryBase>> additional;
+    if (rejected_case == 2) {
+      // Its presence is enough to deny the optimization. Never start it.
+      additional.push_back(nullptr);
+    }
+    options.skip_windows_credential_enumeration = true;
+    content::AuthenticatorCommonImpl::
+        ConfigureWindowsNativeCredentialEnumeration(
+            RequestSource::kWebAuthentication, Mediation::MODAL,
+            current_factory, additional, current_request, options);
+    EXPECT_FALSE(options.skip_windows_credential_enumeration);
+  }
+}
