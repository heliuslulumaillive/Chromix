+      font_->GetFontDescription().Family().FamilyName().GetString().Utf8();
+  const std::string actual =
+      font_->PrimaryFont()->PlatformData().FontFamilyName().Utf8();
+  // compatible-v1: no reference correction for generic/aliased/substituted faces.
+  if (!base::uxr_surface_v1::AsciiEqual(requested, actual))
+    return;
+  if (mac && font == "13.7px -apple-system, \"system-ui\", \"Segoe UI\", Roboto, sans-serif")
+    font = "13.7px -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif";
+  const auto& rows = mac ? base::uxr_surface_v1::kMacTextReferences
+                         : base::uxr_surface_v1::kWindowsTextReferences;
+  for (const auto& row : rows) {
+    if (row.font != font || row.text != text)
+      continue;
+    if (width_ != row.values[0] ||
+        actual_bounding_box_right_ != row.values[1] ||
+        actual_bounding_box_ascent_ != row.values[2] ||
+        actual_bounding_box_descent_ != row.values[3] ||
+        actual_bounding_box_left_ != row.values[4])
+      return;
+    struct GlyphSource { const std::string& family; bool matches = true; };
+    GlyphSource source{actual};
+    for (const auto& run : runs_with_offset_) {
