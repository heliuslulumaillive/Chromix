-void CloseSocketHandle(uintptr_t socket) {
-  if (socket == kInvalidSocket)
-    return;
-#if BUILDFLAG(IS_WIN)
-  ::closesocket(static_cast<SOCKET>(socket));
-#else
-  ::close(static_cast<int>(socket));
