-void CanvasBridgeClient::EnsurePolicyParsed() {
-  if (policy_parsed_)
-    return;
-  policy_parsed_ = true;
-  const base::UxrConfig& config = base::UxrConfig::GetInstance();
-  const std::string mode = config.Get("uxr-canvas-bridge-mode");
-  std::string list_switch;
-  if (mode == "off") {
-    policy_mode_ = PolicyMode::kOff;
-  } else if (mode == "allow") {
-    policy_mode_ = PolicyMode::kAllow;
-    list_switch = "uxr-canvas-bridge-allow";
-  } else if (mode == "deny") {
-    policy_mode_ = PolicyMode::kDeny;
-    list_switch = "uxr-canvas-bridge-deny";
-  } else {
-    policy_mode_ = PolicyMode::kAll;
-  }
-  if (!list_switch.empty()) {
-    for (const std::string& origin : base::SplitString(
-             config.Get(list_switch), ",",
-             base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
-      policy_origins_.insert(origin);
-    }
-  }
-  fallback_local_ = config.Get("uxr-canvas-bridge-fallback") == "local";
-}
-
-bool CanvasBridgeClient::BridgeEnabledForOrigin(const std::string& etld1) {
-  EnsurePolicyParsed();
-  switch (policy_mode_) {
-    case PolicyMode::kOff:
-      return false;
-    case PolicyMode::kAll:
-      return true;
-    case PolicyMode::kAllow:
-      return policy_origins_.count(etld1) != 0;
-    case PolicyMode::kDeny:
-      return policy_origins_.count(etld1) == 0;
-  }
-  return false;
-}
-
-bool CanvasBridgeClient::FallbackToLocal() {
-  EnsurePolicyParsed();
-  return fallback_local_;
