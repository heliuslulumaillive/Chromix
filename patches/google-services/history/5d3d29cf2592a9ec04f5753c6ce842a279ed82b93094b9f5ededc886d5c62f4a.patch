+#elif BUILDFLAG(IS_WIN)
+  const bool host_matches = modes.platform.empty() ||
+      base::uxr_surface_v1::AsciiEqual(modes.platform, "windows") ||
+      base::uxr_surface_v1::AsciiEqual(modes.platform, "Win32");
+#else
+  const bool host_matches = base::uxr_surface_v1::AsciiEqual(modes.platform, "linux") ||
+      base::uxr_surface_v1::AsciiEqual(modes.platform, "Linux x86_64");
+#endif
+  if (!host_matches || !font_ || !font_->PrimaryFont())
+    return;
