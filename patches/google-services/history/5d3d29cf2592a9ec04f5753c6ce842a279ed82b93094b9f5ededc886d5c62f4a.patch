+    accepted_ = UxrRequiredGpuMatches(info);
+    done_ = true;
+    loop_.Quit();
+  }
+  void OnGpuProcessCrashed() override {
+    accepted_ = false;
+    done_ = true;
+    loop_.Quit();
+  }
+ private:
+  base::RunLoop loop_;
+  bool done_ = false;
+  bool accepted_ = false;
