+        const uint8_t value =
+            UxrNoiseChannel(seed, static_cast<uint32_t>(region.origin_x) + x,
+                            absolute_y, channel, pixel[index]);
+        changed |= value != pixel[index];
+        pixel[index] = value;
+      }
+    }
+  }
+  return changed ? UxrPixelResult::kApplied : UxrPixelResult::kUnchanged;
