+template <class Range>
+inline void AudioFloats(Range samples, uint32_t seed, uint32_t salt, double intensity) {
+  const unsigned n = AudioBits(intensity);
+  for (float& value : samples)
+    value = AudioSample(value, seed, salt, n);
