+template <class Samples>
+inline bool TryCloakAudioReference(Samples samples, bool mac, unsigned channels,
+                                   float sample_rate) {
+  if (!mac || channels != 1 || sample_rate != 44100.0f)
+    return false;
+  for (const auto& row : kAudioReferencePairs) {
+    if (samples.size() != row.native.size())
+      continue;
+    bool matches = true;
+    for (size_t i = 0; i < samples.size(); ++i) {
+      if (std::bit_cast<uint32_t>(samples[i]) !=
+          std::bit_cast<uint32_t>(row.native[i])) {
+        matches = false;
+        break;
+      }
+    }
+    if (!matches)
+      continue;
+    for (size_t i = 0; i < samples.size(); ++i)
+      samples[i] = row.reference[i];
+    return true;
+  }
+  return false;
+}
