+std::vector<std::string> SplitTabs(const std::string& line) {
+  std::vector<std::string> fields;
+  std::istringstream input(line);
+  for (std::string value; std::getline(input, value, '\t');)
+    fields.push_back(value);
+  return fields;
+}
