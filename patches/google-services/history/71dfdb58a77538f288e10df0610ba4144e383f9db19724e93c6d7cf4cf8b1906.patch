+        (static_cast<uint32_t>(static_cast<unsigned char>(s[n / 2])) << 8);
+    const uint32_t z = static_cast<uint32_t>(n) |
+        (static_cast<uint32_t>(static_cast<unsigned char>(s[n - 1])) << 2);
+    return ShiftMix(y * k2 ^ z * k3) * k2;
