+template <class Names>
+inline bool ContainsFont(const Names& names, std::string_view actual) {
+  for (const auto name : names)
+    if (AsciiEqual(name, actual)) return true;
+  return false;
+}
+inline bool CloakFontCandidate(std::string_view family, std::string_view platform,
+                               uint64_t seed) {
+  if (AsciiEqual(platform, "macos") || AsciiEqual(platform, "MacIntel"))
+    return ContainsFont(kMacFonts, family);
+  if (AsciiEqual(platform, "linux") || AsciiEqual(platform, "Linux x86_64"))
+    return ContainsFont(kLinuxFonts, family);
+  if (ContainsFont(kWindowsBase, family)) return true;
+  const uint32_t score = PopulationHash(std::to_string(seed) + "font_population") % 100u;
+  if (!score) return false;
+  if (ContainsFont(kWindowsA, family) || ContainsFont(kWindowsB, family) ||
+      ContainsFont(kWindowsExtra, family)) return true;
+  if (score >= 54 && ContainsFont(kWindowsOffice, family)) return true;
+  if (score >= 67 && ContainsFont(kWindowsHigh, family)) return true;
+  return score >= 72 && AsciiEqual(family, "Roboto");
+}
