+uint64_t Number(const std::string& text) {
+  uint64_t value = 0;
+  const auto parsed =
+      std::from_chars(text.data(), text.data() + text.size(), value);
+  if (parsed.ec != std::errc() || parsed.ptr != text.data() + text.size())
+    BadFixture("Invalid fixture number");
+  return value;
+}
