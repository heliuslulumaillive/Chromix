+    b = std::rotr(a + z, 52);
+    c = std::rotr(a, 37);
+    a += LoadLE(s, n - 24);
+    c += std::rotr(a, 7);
+    a += LoadLE(s, n - 16);
+    const uint64_t wf = a + z, ws = b + std::rotr(a, 31) + c;
+    const uint64_t r = ShiftMix((vf + ws) * k2 + (wf + vs) * k0);
+    return ShiftMix(r * k0 + vs) * k2;
